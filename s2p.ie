# s2p — strict Python 3 subset to Shakti.

python_reserved : ["def", "return", "if", "elif", "else", "while", "for", "in",
                   "break", "continue", "and", "or", "not", "import", "try", "except",
                   "finally", "as", "lambda", "pass", "class", "global", "del", "raise",
                   "with", "yield", "True", "False", "None"]
shakti_reserved : ["select", "update", "delete", "by", "from", "where",
                   "create", "insert", "into", "values", "join", "on"]

def tok(kind, text, val, line, col):
    return {"kind":kind, "text":text, "val":val, "line":line, "col":col}

def node(t, x):
    return {"t":t, "line":x["line"], "col":x["col"]}

def starts(s, p):
    if len(s) < len(p):
        return False
    return s[0:len(p)] = p

def is_alpha(c):
    return ("a" <= c and c <= "z") or ("A" <= c and c <= "Z") or c = "_"

def is_digit(c):
    return "0" <= c and c <= "9"

def is_alnum(c):
    return is_alpha(c) or is_digit(c)

def trim_left(s):
    i : 0
    while i < len(s) and (s[i] = " " or s[i] = "\t"):
        i += 1
    return s[i:]

def quote_string(s):
    out : ""
    i : 0
    while i < len(s):
        c : s[i]
        if c = "\\":
            out += "\\\\"
        elif c = "\"":
            out += "\\\""
        elif c = "\n":
            out += "\\n"
        elif c = "\t":
            out += "\\t"
        else:
            out += c
        i += 1
    return "\"" + out + "\""

def lex_string(line, i, ln):
    start : i
    prefix : ""
    if (line[i] = "f" or line[i] = "F") and i + 1 < len(line) and (line[i + 1] = "\"" or line[i + 1] = "'"):
        prefix : line[i]
        i += 1
    q : line[i]
    triple : False
    if i + 2 < len(line) and line[i:i + 3] = q + q + q:
        triple : True
        i += 3
    else:
        i += 1
    val : ""
    while i < len(line):
        if triple and i + 2 < len(line) and line[i:i + 3] = q + q + q:
            i += 3
            return [tok("STRING", line[start:i], {"s":val, "f":prefix != "", "triple":True}, ln, start + 1), i]
        if not triple and line[i] = q:
            i += 1
            return [tok("STRING", line[start:i], {"s":val, "f":prefix != "", "triple":False}, ln, start + 1), i]
        if line[i] = "\\":
            if i + 1 >= len(line):
                raise str(ln) + ":" + str(i + 1) + ": unterminated string"
            e : line[i + 1]
            if e = "n":
                val += "\n"
            elif e = "t":
                val += "\t"
            elif e = "r":
                val += "\r"
            else:
                val += e
            i += 2
        else:
            val += line[i]
            i += 1
    raise str(ln) + ":" + str(start + 1) + ": unterminated string"

def lex(source):
    lines : re_split("\n", source)
    ts : []
    comments : {"0":""}
    inline : {"0":""}
    # Keep this heterogeneous: native integer vectors are immutable.
    indents : [None, 0]
    ln : 1
    for line in lines:
        nsp : 0
        while nsp < len(line) and line[nsp] = " ":
            nsp += 1
        if nsp < len(line) and line[nsp] = "\t":
            raise str(ln) + ":" + str(nsp + 1) + ": tabs are unsupported"
        rest : line[nsp:]
        if len(rest) = 0:
            ln += 1
            continue
        if rest[0] = "#":
            comments[str(ln)] : rest
            ln += 1
            continue
        if nsp > indents[len(indents) + -1]:
            indents.append(nsp)
            ts.append(tok("INDENT", "", None, ln, 1))
        elif nsp < indents[len(indents) + -1]:
            while nsp < indents[len(indents) + -1]:
                indents.pop()
                ts.append(tok("DEDENT", "", None, ln, 1))
            if nsp != indents[len(indents) + -1]:
                raise str(ln) + ":1: inconsistent indentation"
        i : nsp
        while i < len(line):
            c : line[i]
            if c = " " or c = "\t":
                i += 1
                continue
            if c = "#":
                inline[str(ln)] : line[i:]
                break
            if is_alpha(c):
                if (c = "f" or c = "F") and i + 1 < len(line) and (line[i + 1] = "\"" or line[i + 1] = "'"):
                    z : lex_string(line, i, ln)
                    ts.append(z[0])
                    i : z[1]
                    continue
                j : i + 1
                while j < len(line) and is_alnum(line[j]):
                    j += 1
                text : line[i:j]
                ts.append(tok("NAME", text, text, ln, i + 1))
                i : j
                continue
            if is_digit(c) or (c = "." and i + 1 < len(line) and is_digit(line[i + 1])):
                j : i + 1
                while j < len(line) and (is_alnum(line[j]) or line[j] = "." or line[j] = "_"):
                    j += 1
                text : line[i:j]
                ts.append(tok("NUMBER", text, text, ln, i + 1))
                i : j
                continue
            if c = "\"" or c = "'":
                z : lex_string(line, i, ln)
                ts.append(z[0])
                i : z[1]
                continue
            op : c
            if i + 2 < len(line) and (line[i:i + 3] = "**=" or line[i:i + 3] = "//=" or line[i:i + 3] = "<<=" or line[i:i + 3] = ">>=" or line[i:i + 3] = "..."):
                op : line[i:i + 3]
            elif i + 1 < len(line) and line[i:i + 2] in ["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "//", "**", "<<", ">>", ":=", "->", "@=", "&=", "|=", "^="]:
                op : line[i:i + 2]
            ts.append(tok("OP", op, op, ln, i + 1))
            i += len(op)
        ts.append(tok("NEWLINE", "", None, ln, len(line) + 1))
        ln += 1
    while len(indents) > 2:
        indents.pop()
        ts.append(tok("DEDENT", "", None, ln, 1))
    ts.append(tok("ENDMARKER", "", None, ln, 1))
    return {"tokens":ts, "comments":comments, "inline":inline}

def peek(p):
    return p["tokens"][p["pos"]]

def peekn(p, n):
    j : p["pos"] + n
    if j >= len(p["tokens"]):
        j : len(p["tokens"]) + -1
    return p["tokens"][j]

def take(p):
    x : peek(p)
    p["pos"] += 1
    return x

def at(p, text):
    return peek(p)["text"] = text

def kind(p, k):
    return peek(p)["kind"] = k

def fail(p, msg, x):
    raise p["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": " + msg

def need(p, text):
    x : peek(p)
    if x["text"] != text:
        fail(p, "expected '" + text + "'", x)
    return take(p)

def need_kind(p, k):
    x : peek(p)
    if x["kind"] != k:
        fail(p, "expected " + k, x)
    return take(p)

def ident(p, x):
    if x["text"] in python_reserved:
        fail(p, "identifier '" + x["text"] + "' is reserved in Shakti", x)
    # Mangle Shakti keywords. Also mangle any name that already starts with
    # the mangling prefix so user identifiers like __s2p_values cannot collide
    # with a mangled reserved word (values -> __s2p_values).
    name : x["text"]
    if name in shakti_reserved or starts(name, "__s2p_"):
        name : "__s2p_" + name
    x["text"] : name
    return name

def parse(source, filename):
    lx : lex(source)
    p : {"tokens":lx["tokens"], "pos":0, "filename":filename, "aliases":{"":""}, "comments":lx["comments"], "inline":lx["inline"]}
    body : []
    while not kind(p, "ENDMARKER"):
        if kind(p, "NEWLINE"):
            take(p)
        else:
            body.append(parse_stmt(p))
    return {"t":"Module", "body":body, "comments":p["comments"], "inline":p["inline"], "aliases":p["aliases"], "filename":filename}

def parse_stmt(p):
    decorators : []
    while at(p, "@"):
        take(p)
        decorators.append(parse_expr(p))
        need_kind(p, "NEWLINE")
    if len(decorators) > 0:
        if not at(p, "def"):
            fail(p, "decorators require a function", peek(p))
        x : parse_compound(p)
        x["decorators"] : decorators
        return x
    if at(p, "if") or at(p, "while") or at(p, "for") or at(p, "def") or at(p, "class") or at(p, "async") or at(p, "with") or at(p, "try"):
        return parse_compound(p)
    return parse_simple(p)

def parse_suite(p):
    need(p, ":")
    need_kind(p, "NEWLINE")
    need_kind(p, "INDENT")
    xs : []
    while not kind(p, "DEDENT") and not kind(p, "ENDMARKER"):
        if kind(p, "NEWLINE"):
            take(p)
        else:
            xs.append(parse_stmt(p))
    need_kind(p, "DEDENT")
    if len(xs) = 0:
        fail(p, "empty block", peek(p))
    return xs

def parse_compound(p):
    x : peek(p)
    if at(p, "class"):
        fail(p, "classes are unsupported", x)
    if at(p, "async"):
        fail(p, "async functions are unsupported", x)
    if at(p, "with"):
        fail(p, "With is unsupported", x)
    if at(p, "try"):
        fail(p, "Try is unsupported", x)
    if at(p, "def"):
        take(p)
        name : need_kind(p, "NAME")
        ident(p, name)
        need(p, "(")
        args : []
        defaults : []
        if not at(p, ")"):
            while True:
                if at(p, "*"):
                    fail(p, "variadic or keyword-only parameters are unsupported", peek(p))
                a : need_kind(p, "NAME")
                ident(p, a)
                if at(p, ":"):
                    fail(p, "parameter annotations are unsupported", a)
                args.append(a["text"])
                if at(p, "="):
                    take(p)
                    defaults.append(parse_expr(p))
                else:
                    defaults.append(None)
                if not at(p, ","):
                    break
                take(p)
                if at(p, ")"):
                    break
        need(p, ")")
        if at(p, "->"):
            fail(p, "return annotations are unsupported", take(p))
        z : node("FunctionDef", x)
        z["name"] : name["text"]
        z["args"] : args
        z["defaults"] : defaults
        z["decorators"] : []
        z["body"] : parse_suite(p)
        return z
    if at(p, "if"):
        take(p)
        z : node("If", x)
        z["test"] : parse_expr(p)
        z["body"] : parse_suite(p)
        z["elifs"] : []
        z["orelse"] : []
        while at(p, "elif"):
            e : take(p)
            q : {"test":parse_expr(p), "body":parse_suite(p), "line":e["line"], "col":e["col"]}
            z["elifs"].append(q)
        if at(p, "else"):
            take(p)
            z["orelse"] : parse_suite(p)
        return z
    if at(p, "while"):
        take(p)
        z : node("While", x)
        z["test"] : parse_expr(p)
        z["body"] : parse_suite(p)
        if at(p, "else"):
            fail(p, "while-else is unsupported", peek(p))
        return z
    if at(p, "for"):
        take(p)
        z : node("For", x)
        target : parse_target(p)
        if target["t"] = "Tuple" or target["t"] = "List":
            fail(p, "tuple unpacking in for-loops is unsupported", target)
        need(p, "in")
        z["target"] : target
        z["iter"] : parse_expr(p)
        z["body"] : parse_suite(p)
        if at(p, "else"):
            fail(p, "for-else is unsupported", peek(p))
        return z
    fail(p, "unsupported compound statement", x)

def end_simple(p):
    need_kind(p, "NEWLINE")

def parse_simple(p):
    x : peek(p)
    if at(p, "return"):
        take(p)
        z : node("Return", x)
        z["value"] : None
        if not kind(p, "NEWLINE"):
            z["value"] : parse_expr(p)
        end_simple(p)
        return z
    if at(p, "break") or at(p, "continue") or at(p, "pass"):
        take(p)
        z : node(x["text"], x)
        end_simple(p)
        return z
    if at(p, "from"):
        fail(p, "from-import is unsupported", x)
    if at(p, "raise"):
        fail(p, "Raise is unsupported", x)
    if at(p, "yield"):
        fail(p, "Yield is unsupported", x)
    if at(p, "global") or at(p, "nonlocal") or at(p, "del"):
        fail(p, x["text"] + " is unsupported", x)
    if at(p, "import"):
        take(p)
        name : need_kind(p, "NAME")
        alias : None
        if at(p, "as"):
            take(p)
            alias : need_kind(p, "NAME")["text"]
        if at(p, ","):
            fail(p, "multiple imports in one statement are unsupported", x)
        end_simple(p)
        z : node("Import", x)
        z["name"] : name["text"]
        z["alias"] : alias
        if name["text"] = "numpy" or name["text"] = "pandas":
            bound : name["text"]
            if alias != None:
                bound : alias
            p["aliases"][bound] : name["text"]
            z["erase"] : True
        else:
            if alias != None:
                fail(p, "import aliases are unsupported", x)
            z["erase"] : False
        return z
    if at(p, "assert"):
        take(p)
        z : node("Assert", x)
        z["test"] : parse_expr(p)
        if at(p, ","):
            fail(p, "assert message is unsupported", x)
        end_simple(p)
        return z
    left : parse_expr_list(p)
    if at(p, "="):
        take(p)
        if at(p, "="):
            fail(p, "chained assignment is unsupported", x)
        value : parse_expr_list(p)
        if at(p, "="):
            fail(p, "chained assignment is unsupported", x)
        z : node("Assign", x)
        z["target"] : left
        z["value"] : value
        validate_target(p, left)
        end_simple(p)
        return z
    if at(p, ":"):
        fail(p, "annotated assignment is unsupported", x)
    if peek(p)["text"] in ["+=", "-=", "*=", "/="]:
        op : take(p)
        z : node("AugAssign", x)
        z["target"] : left
        validate_target(p, left)
        z["op"] : op["text"]
        z["value"] : parse_expr(p)
        end_simple(p)
        return z
    if peek(p)["text"] in ["//=", "**=", "@=", "&=", "|=", "^=", "<<=", ">>="]:
        fail(p, "augmented operator is unsupported", peek(p))
    z : node("Expr", x)
    z["value"] : left
    end_simple(p)
    return z

def validate_target(p, x):
    if x["t"] = "Name" or x["t"] = "Attr" or x["t"] = "Subscript":
        return
    if x["t"] = "Tuple" or x["t"] = "List":
        if len(x["elts"]) = 0:
            fail(p, "empty unpacking is unsupported", x)
        for e in x["elts"]:
            if e["t"] != "Name":
                fail(p, "nested unpacking is unsupported", e)
        return
    fail(p, "unsupported assignment target", x)

def parse_target(p):
    first : parse_postfix(p)
    if not at(p, ","):
        return first
    z : node("Tuple", first)
    z["elts"] : [first]
    while at(p, ","):
        take(p)
        z["elts"].append(parse_postfix(p))
    return z

def parse_expr_list(p):
    first : parse_expr(p)
    if not at(p, ","):
        return first
    z : node("Tuple", first)
    z["elts"] : [first]
    while at(p, ","):
        take(p)
        if at(p, ")") or at(p, "]") or kind(p, "NEWLINE"):
            break
        z["elts"].append(parse_expr(p))
    return z

def parse_expr(p):
    if at(p, "lambda"):
        return parse_lambda(p)
    return parse_ifexp(p)

def parse_lambda(p):
    x : take(p)
    args : []
    if not at(p, ":"):
        while True:
            if at(p, "*"):
                fail(p, "variadic or keyword-only lambda parameters are unsupported", peek(p))
            a : need_kind(p, "NAME")
            args.append(ident(p, a))
            if not at(p, ","):
                break
            take(p)
    if len(args) > 1:
        fail(p, "multi-argument lambdas are unsupported", x)
    need(p, ":")
    z : node("Lambda", x)
    z["args"] : args
    z["body"] : parse_expr(p)
    return z

def parse_ifexp(p):
    z : parse_or(p)
    if at(p, "if"):
        x : take(p)
        q : node("IfExp", x)
        q["body"] : z
        q["test"] : parse_or(p)
        need(p, "else")
        q["orelse"] : parse_expr(p)
        return q
    if at(p, ":="):
        fail(p, "walrus operator is unsupported", peek(p))
    return z

def parse_or(p):
    xs : [parse_and(p)]
    x : xs[0]
    while at(p, "or"):
        take(p)
        xs.append(parse_and(p))
    if len(xs) = 1:
        return x
    z : node("BoolOp", x)
    z["op"] : "or"
    z["values"] : xs
    return z

def parse_and(p):
    xs : [parse_not(p)]
    x : xs[0]
    while at(p, "and"):
        take(p)
        xs.append(parse_not(p))
    if len(xs) = 1:
        return x
    z : node("BoolOp", x)
    z["op"] : "and"
    z["values"] : xs
    return z

def parse_not(p):
    if at(p, "not") and peekn(p, 1)["text"] != "in":
        x : take(p)
        z : node("Unary", x)
        z["op"] : "not"
        z["value"] : parse_not(p)
        return z
    return parse_compare(p)

def parse_compare(p):
    left : parse_bitor(p)
    ops : []
    vals : []
    while peek(p)["text"] in ["==", "!=", "<", "<=", ">", ">=", "in", "is"] or (at(p, "not") and peekn(p, 1)["text"] = "in"):
        x : take(p)
        op : x["text"]
        if op = "not":
            take(p)
            op : "not in"
        elif op = "is":
            if at(p, "not"):
                take(p)
            fail(p, "comparison Is is unsupported", x)
        ops.append(op)
        vals.append(parse_bitor(p))
    if len(ops) = 0:
        return left
    if len(ops) > 1:
        fail(p, "chained comparisons are unsupported", left)
    z : node("Compare", left)
    z["left"] : left
    z["op"] : ops[0]
    z["right"] : vals[0]
    return z

def reject_bit(p, z, ops):
    while peek(p)["text"] in ops:
        fail(p, "bitwise operators are unsupported", peek(p))
    return z

def parse_bitor(p):
    return reject_bit(p, parse_shift(p), ["|", "^", "&"])

def parse_shift(p):
    return reject_bit(p, parse_arith(p), ["<<", ">>"])

def binary(p, sub, ops):
    z : sub(p)
    while peek(p)["text"] in ops:
        x : take(p)
        q : node("BinOp", x)
        q["left"] : z
        q["op"] : x["text"]
        q["right"] : sub(p)
        z : q
    return z

def parse_arith(p):
    return binary(p, parse_term, ["+", "-"])

def parse_term(p):
    return binary(p, parse_factor, ["*", "/", "//", "%", "@"])

def parse_factor(p):
    if peek(p)["text"] in ["+", "-", "~"]:
        x : take(p)
        if x["text"] = "+":
            fail(p, "unary plus is unsupported", x)
        if x["text"] = "~":
            fail(p, "bitwise invert is unsupported", x)
        z : node("Unary", x)
        z["op"] : "-"
        z["value"] : parse_factor(p)
        return z
    return parse_power(p)

def parse_power(p):
    z : parse_postfix(p)
    if at(p, "**"):
        x : take(p)
        q : node("BinOp", x)
        q["left"] : z
        q["op"] : "**"
        q["right"] : parse_factor(p)
        return q
    return z

def parse_postfix(p):
    z : parse_atom(p)
    while True:
        if at(p, "."):
            x : take(p)
            a : need_kind(p, "NAME")
            q : node("Attr", x)
            q["value"] : z
            q["attr"] : a["text"]
            z : q
        elif at(p, "("):
            x : take(p)
            q : node("Call", x)
            q["func"] : z
            q["args"] : []
            q["kwargs"] : []
            if not at(p, ")"):
                while True:
                    if at(p, "**"):
                        fail(p, "**kwargs is unsupported", peek(p))
                    if at(p, "*"):
                        fail(p, "*args is unsupported", peek(p))
                    if kind(p, "NAME") and peekn(p, 1)["text"] = "=":
                        k : take(p)
                        ident(p, k)
                        take(p)
                        q["kwargs"].append([k, parse_expr(p)])
                    else:
                        q["args"].append(parse_expr(p))
                    if not at(p, ","):
                        break
                    take(p)
                    if at(p, ")"):
                        break
            need(p, ")")
            z : q
        elif at(p, "["):
            x : take(p)
            q : node("Subscript", x)
            q["value"] : z
            q["slice"] : parse_slice_list(p)
            need(p, "]")
            z : q
        else:
            break
    return z

def parse_slice_list(p):
    xs : [parse_slice(p)]
    while at(p, ","):
        take(p)
        xs.append(parse_slice(p))
    if len(xs) = 1:
        return xs[0]
    z : node("SliceTuple", xs[0])
    z["elts"] : xs
    return z

def parse_slice(p):
    x : peek(p)
    lower : None
    if not at(p, ":"):
        lower : parse_expr(p)
    if not at(p, ":"):
        return lower
    take(p)
    upper : None
    step : None
    if not at(p, ":") and not at(p, "]") and not at(p, ","):
        upper : parse_expr(p)
    if at(p, ":"):
        take(p)
        if not at(p, "]") and not at(p, ","):
            step : parse_expr(p)
    z : node("Slice", x)
    z["lower"] : lower
    z["upper"] : upper
    z["step"] : step
    return z

def parse_atom(p):
    x : peek(p)
    if kind(p, "NUMBER"):
        take(p)
        if "j" in x["text"] or "J" in x["text"]:
            fail(p, "complex literals are unsupported", x)
        z : node("Const", x)
        z["value"] : x["text"]
        z["kind"] : "number"
        return z
    if kind(p, "STRING"):
        take(p)
        if x["val"]["f"]:
            depth : 0
            j : 0
            while j < len(x["val"]["s"]):
                c : x["val"]["s"][j]
                if c = "{":
                    if j + 1 < len(x["val"]["s"]) and x["val"]["s"][j + 1] = "{":
                        j += 2
                        continue
                    depth += 1
                elif c = "}":
                    depth += -1
                elif depth > 0 and (c = "!" or c = ":"):
                    fail(p, "f-string conversions/format specs are unsupported", x)
                j += 1
        z : node("FString" if x["val"]["f"] else "Const", x)
        z["value"] : x["val"]["s"]
        z["kind"] : "string"
        return z
    if kind(p, "NAME"):
        take(p)
        if (x["text"] = "b" or x["text"] = "B") and kind(p, "STRING"):
            fail(p, "bytes literals are unsupported", x)
        if x["text"] = "await":
            fail(p, "Await is unsupported", x)
        if x["text"] = "yield":
            fail(p, "Yield is unsupported", x)
        z : node("Const" if x["text"] in ["True", "False", "None"] else "Name", x)
        z["value"] : x["text"] if z["t"] = "Const" else ident(p, x)
        if z["t"] = "Name":
            x["text"] : z["value"]
        return z
    if at(p, "("):
        take(p)
        if at(p, ")"):
            take(p)
            z : node("Tuple", x)
            z["elts"] : []
            return z
        z : parse_expr_list(p)
        need(p, ")")
        return z
    if at(p, "["):
        take(p)
        z : node("List", x)
        z["elts"] : []
        if not at(p, "]"):
            while True:
                e : parse_expr(p)
                if at(p, "for"):
                    fail(p, "comprehensions are unsupported", x)
                z["elts"].append(e)
                if not at(p, ","):
                    break
                take(p)
                if at(p, "]"):
                    break
        need(p, "]")
        return z
    if at(p, "{"):
        take(p)
        z : node("Dict", x)
        z["keys"] : []
        z["values"] : []
        if not at(p, "}"):
            while True:
                if at(p, "**"):
                    fail(p, "dict unpacking is unsupported", peek(p))
                k : parse_expr(p)
                if at(p, "for"):
                    fail(p, "comprehensions are unsupported", x)
                if not at(p, ":"):
                    fail(p, "set literals are unsupported", x)
                need(p, ":")
                z["keys"].append(k)
                z["values"].append(parse_expr(p))
                if not at(p, ","):
                    break
                take(p)
                if at(p, "}"):
                    break
        need(p, "}")
        return z
    fail(p, "unsupported expression", x)

def pad(n):
    return "    " * n

def render(ast, state):
    state["comments"] : ast["comments"]
    state["inline"] : ast["inline"]
    state["last_comment"] : 0
    state["filename"] : ast["filename"]
    lines : render_body(ast["body"], state, 0, True)
    for k in state["comments"].keys():
        kn : int(k)
        if kn > state["last_comment"]:
            lines.append(state["comments"][k])
    text : ""
    for line in lines:
        if line != "":
            text += line + "\n"
    return text

def before_comments(st, line, indent):
    out : []
    for k in st["comments"].keys():
        kn : int(k)
        if kn > st["last_comment"] and kn < line:
            out.append(pad(indent) + st["comments"][k])
            st["last_comment"] : kn
    return out

def render_body(body, st, indent, doc_ok):
    out : []
    i : 0
    while i < len(body):
        s : body[i]
        cs : before_comments(st, s["line"], indent)
        for c in cs:
            out.append(c)
        if doc_ok and i = 0 and s["t"] = "Expr" and s["value"]["t"] = "Const" and s["value"]["kind"] = "string":
            parts : re_split("\n", s["value"]["value"])
            for q in parts:
                out.append(pad(indent) + ("# " + q if len(q) > 0 else "#"))
        else:
            rs : render_stmt(s, st, indent)
            key : str(s["line"])
            if key in st["inline"]:
                rs[0] : rs[0] + "  " + st["inline"][key]
            for q in rs:
                if q != "":
                    out.append(q)
        i += 1
    return out

def render_stmt(s, st, ind):
    p : pad(ind)
    t : s["t"]
    if t = "Assign":
        return [p + target_text(s["target"], st) + " : " + expr_text(s["value"], st)]
    if t = "AugAssign":
        return [p + target_text(s["target"], st) + " " + s["op"] + " " + expr_text(s["value"], st)]
    if t = "Return":
        return [p + ("return" if s["value"] = None else "return " + expr_text(s["value"], st))]
    if t = "break" or t = "continue" or t = "pass":
        return [p + t]
    if t = "Import":
        return ["" if s["erase"] else p + "import " + s["name"]]
    if t = "Assert":
        return [p + "assert(" + expr_text(s["test"], st) + ")"]
    if t = "Expr":
        return [p + expr_text(s["value"], st)]
    if t = "FunctionDef":
        out : []
        for d in s["decorators"]:
            out.append(p + "@" + expr_text(d, st))
        parts : []
        i : 0
        while i < len(s["args"]):
            q : s["args"][i]
            if s["defaults"][i] != None:
                q += ":" + expr_text(s["defaults"][i], st)
            parts.append(q)
            i += 1
        out.append(p + "def " + s["name"] + "(" + join_text(parts, ", ") + "):")
        for q in render_body(s["body"], st, ind + 1, True):
            out.append(q)
        return out
    if t = "If":
        out : [p + "if " + expr_text(s["test"], st) + ":"]
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        for e in s["elifs"]:
            out.append(p + "elif " + expr_text(e["test"], st) + ":")
            for q in render_body(e["body"], st, ind + 1, False):
                out.append(q)
        if len(s["orelse"]) > 0:
            out.append(p + "else:")
            for q in render_body(s["orelse"], st, ind + 1, False):
                out.append(q)
        return out
    if t = "While":
        out : [p + "while " + expr_text(s["test"], st) + ":"]
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        return out
    if t = "For":
        out : [p + "for " + target_text(s["target"], st) + " in " + expr_text(s["iter"], st) + ":"]
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        return out
    return []

def join_text(xs, sep):
    out : ""
    i : 0
    while i < len(xs):
        if i > 0:
            out += sep
        out += xs[i]
        i += 1
    return out

def target_text(x, st):
    if x["t"] = "Tuple" or x["t"] = "List":
        parts : []
        for e in x["elts"]:
            parts.append(target_text(e, st))
        return join_text(parts, ", ")
    return expr_text(x, st)

def slice_text(x, st):
    if x["t"] = "Slice":
        a : "" if x["lower"] = None else expr_text(x["lower"], st)
        b : "" if x["upper"] = None else expr_text(x["upper"], st)
        q : a + ":" + b
        if x["step"] != None:
            q += ":" + expr_text(x["step"], st)
        return q
    if x["t"] = "SliceTuple":
        parts : []
        for e in x["elts"]:
            parts.append(slice_text(e, st))
        return join_text(parts, ", ")
    return expr_text(x, st)

def expr_text(x, st):
    t : x["t"]
    if t = "Name":
        return x["value"]
    if t = "Const":
        if x["kind"] = "string":
            return quote_string(x["value"])
        return x["value"]
    if t = "FString":
        return "f" + quote_string(x["value"])
    if t = "List":
        parts : []
        for e in x["elts"]:
            parts.append(expr_text(e, st))
        return "[" + join_text(parts, ", ") + "]"
    if t = "Tuple":
        parts : []
        for e in x["elts"]:
            parts.append(expr_text(e, st))
        if len(parts) = 1:
            return "(" + parts[0] + ",)"
        return "(" + join_text(parts, ", ") + ")"
    if t = "Dict":
        parts : []
        i : 0
        while i < len(x["keys"]):
            parts.append(expr_text(x["keys"][i], st) + ": " + expr_text(x["values"][i], st))
            i += 1
        return "{" + join_text(parts, ", ") + "}"
    if t = "Attr":
        if x["value"]["t"] = "Name" and x["value"]["value"] in st["aliases"]:
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": " + st["aliases"][x["value"]["value"]] + "." + x["attr"] + " is unsupported outside a mapped call"
        return expr_text(x["value"], st) + "." + x["attr"]
    if t = "Subscript":
        return expr_text(x["value"], st) + "[" + slice_text(x["slice"], st) + "]"
    if t = "Unary":
        return "(" + ("not " if x["op"] = "not" else "-") + expr_text(x["value"], st) + ")"
    if t = "BinOp":
        if x["op"] = "@":
            return "mmul(" + expr_text(x["left"], st) + ", " + expr_text(x["right"], st) + ")"
        return "(" + expr_text(x["left"], st) + " " + x["op"] + " " + expr_text(x["right"], st) + ")"
    if t = "BoolOp":
        parts : []
        for e in x["values"]:
            parts.append(expr_text(e, st))
        return "(" + join_text(parts, " " + x["op"] + " ") + ")"
    if t = "Compare":
        op : "=" if x["op"] = "==" else x["op"]
        return "(" + expr_text(x["left"], st) + " " + op + " " + expr_text(x["right"], st) + ")"
    if t = "IfExp":
        return expr_text(x["body"], st) + " if " + expr_text(x["test"], st) + " else " + expr_text(x["orelse"], st)
    if t = "Lambda":
        return "(lambda " + join_text(x["args"], ", ") + ": " + expr_text(x["body"], st) + ")"
    if t = "Call":
        lowered : lower_call(x, st)
        if lowered != None:
            return lowered
        parts : []
        for e in x["args"]:
            parts.append(expr_text(e, st))
        for kv in x["kwargs"]:
            parts.append(kv[0]["text"] + ":" + expr_text(kv[1], st))
        return expr_text(x["func"], st) + "(" + join_text(parts, ", ") + ")"
    return ""

def lower_call(x, st):
    f : x["func"]
    if f["t"] != "Attr" or f["value"]["t"] != "Name":
        return None
    alias : f["value"]["value"]
    if not alias in st["aliases"]:
        return None
    mod : st["aliases"][alias]
    name : f["attr"]
    if mod = "numpy":
        if name = "array" or name = "asarray":
            if len(x["args"]) != 1 or len(x["kwargs"]) != 0:
                raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": numpy." + name + " requires one argument without dtype/options"
            return expr_text(x["args"][0], st)
        maps : {"sum":"sum", "mean":"avg", "min":"min", "max":"max", "dot":"dot",
                "matmul":"mmul", "abs":"abs", "sqrt":"sqrt", "exp":"exp", "log":"log",
                "sin":"sin", "cos":"cos", "tan":"tan"}
        if not name in maps:
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": numpy." + name + " is unsupported"
        if len(x["kwargs"]) > 0:
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": numpy." + name + " options are unsupported"
        parts : []
        for e in x["args"]:
            parts.append(expr_text(e, st))
        return maps[name] + "(" + join_text(parts, ", ") + ")"
    if mod = "pandas":
        if name = "Series":
            if len(x["args"]) != 1 or len(x["kwargs"]) != 0:
                raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": pandas.Series requires one argument"
            return expr_text(x["args"][0], st)
        if name != "DataFrame":
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": pandas." + name + " is unsupported"
        if len(x["args"]) != 1 or len(x["kwargs"]) != 0 or x["args"][0]["t"] != "Dict":
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": pandas.DataFrame requires one dictionary argument"
        d : x["args"][0]
        parts : []
        i : 0
        while i < len(d["keys"]):
            k : d["keys"][i]
            if k["t"] != "Const" or k["kind"] != "string" or not re_match("^[A-Za-z_][A-Za-z0-9_]*$", k["value"]):
                raise st["filename"] + ":" + str(k["line"]) + ":" + str(k["col"]) + ": DataFrame column names must be valid string identifiers"
            parts.append(k["value"] + ":" + expr_text(d["values"][i], st))
            i += 1
        return "table(" + join_text(parts, ", ") + ")"
    return None

def transpile(source, filename):
    ast : parse(source, filename)
    return render(ast, {"aliases":ast["aliases"]})

def main():
    if len(argv) < 2:
        raise "usage: s2p.ie input.py [-o out.ie]"
    inp : None
    out : None
    i : 1
    while i < len(argv):
        if argv[i] = "-o" or argv[i] = "--output":
            if i + 1 >= len(argv):
                raise "missing output path"
            out : argv[i + 1]
            i += 2
        elif argv[i][0] = "-":
            raise "unknown option: " + argv[i]
        elif inp = None:
            inp : argv[i]
            i += 1
        else:
            raise "unexpected argument: " + argv[i]
    if inp = None:
        raise "usage: s2p.ie input.py [-o out.ie]"
    result : transpile(read(inp), inp)
    if out = None:
        write("/dev/stdout", result)
    else:
        write(out, result)

# Run CLI only when this file is the entry script.
if re_match("s2p\\.ie$", argv[0]):
    main()
