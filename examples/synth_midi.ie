# iRig Keys 2 → Shakti synth
#
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti examples/synth_midi.ie
#
# Maps notes, pitch bend, Mod (CC1), and knobs CC12–19.
# Select "iRig Keys 2" as macOS sound output so the analog Volume knob works.
# Close the synth window or Ctrl+C to exit.

import synth
import midi

PORT : getenv("MIDI_PORT")
if not PORT:
    PORT : "iRig"

# Knobs CC12–19 follow on-screen order: LEVEL CUT RES ATT DEC SUS REL REVERB.
# iRig Keys 2: press the 5-8 button to send CC16–19 from the four physical knobs.
knobs : {
    12: synth.set_level,
    13: synth.set_cutoff,
    14: synth.set_reso,
    15: synth.set_attack,
    16: synth.set_decay,
    17: synth.set_sustain,
    18: synth.set_release,
    19: synth.set_reverb
}

def apply_cc(cc, val):
    n : val / 127.0
    if cc = 1:
        synth.set_mod(n)
    elif cc in knobs:
        f : knobs[cc]
        f(n)

def drain_midi():
    while 1:
        ev : midi.poll()
        if ev = None:
            break
        t : ev["type"]
        if t = "note_on":
            synth.note_on(ev["note"], ev["vel"] / 127.0)
        elif t = "note_off":
            synth.note_off(ev["note"])
        elif t = "pitch_bend":
            synth.set_pitch_bend(ev["bend"])
        elif t = "cc":
            apply_cc(ev["cc"], ev["val"])

assert(type(synth.alive()) != "error", "synth not available (build with SHAKTI_SYNTH=1)")
backend : midi.backend()
assert(type(backend) != "error" and backend != "none", "midi not available (needs SHAKTI_MIDI=1 and ALSA or CoreMIDI)")
print("backend:", backend)
midi.open()
print("ports:")
for p in midi.list():
    print(" ", p["id"], p["name"], p["kind"])

midi.connect(PORT)
print("connected:", PORT)
print("Jam — keys, pitch/mod wheels, knobs CC12–19 (= LEVEL…REVERB). Enable iRig 5-8 for knobs 5–8.")

synth.open()
while synth.alive():
    drain_midi()
    synth.tick()

midi.close()
print("Done")
