# stem demo — separate a short synthetic tone stream and print latency
import stem

TWOPI : 6.283185307179586

info : stem.info()
assert(type(info) != "error", "stem not available (build with SHAKTI_STEM=1)")
print("stem info:", info)
stem.open(44100, 256)
print("algorithmic latency_ms:", stem.latency_ms())

sr : 44100.0
secs : 0.5
n : int(sr * secs)
block_sz : 256
pos : 0
energy : {"drums": 0.0, "bass": 0.0, "vocals": 0.0, "other": 0.0}

t0 : clock()
while pos < n:
    take : block_sz
    if pos + take > n:
        take : n - pos
    t : (range(take) + pos) / sr
    blk : (0.2 * sin(TWOPI * 110.0 * t)) + (0.15 * sin(TWOPI * 440.0 * t))
    out : stem.process(blk)
    for name in ["drums", "bass", "vocals", "other"]:
        energy[name] : energy[name] + sum(out[name] * out[name])
    pos : pos + take
dt : clock() - t0

print("process wall_s:", dt)
print("audio_s:", secs)
print("xrt:", dt / secs)
print("stem energy:", energy)
stem.set_gains(1, 1, 0, 1)
print("gains (vocals muted):", stem.gains())
stem.close()
print("stem demo done")
