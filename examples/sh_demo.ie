# Native sh(cmd) — /bin/sh -c, Isolde-compatible wait status.
# 0 = success; any non-zero value means failure (waitpid status, not bash 0–255).
# Disabled when SHAKTI_SAFE=1 or SHAKTI_ALLOW_EXEC=0.
#   ./shakti examples/sh_demo.ie

ok : sh("true")
bad : sh("false")
print("true wait status:", ok)
print("false failed:", bad != 0)

home : getenv("HOME")
print("cwd:", getcwd())
if home != None:
    print("HOME set")

print("sh_demo ok")
