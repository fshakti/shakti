# pyplot demo — line, scatter, and bar on gfx
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti examples/pyplot_demo.ie
#   SHAKTI_GFX_SKIP=1 ./shakti examples/pyplot_demo.ie   # no window
import pyplot
import gfx

if getenv("SHAKTI_GFX_SKIP") = "1":
    print("pyplot demo: show skipped (SHAKTI_GFX_SKIP=1)")
else:
    if not gfx.available():
        print("pyplot demo: gfx not available")
    else:
        pyplot.plot([0, 1, 2, 3, 4, 5], [0, 1, 4, 9, 16, 25], color:"C0", label:"sq")
        pyplot.scatter([0, 1, 2, 3, 4, 5], [0, 1.5, 3, 6, 12, 20], color:"C1", label:"pts")
        pyplot.bar([0.3, 1.3, 2.3], [4, 2, 5], color:"C2", label:"bars")
        pyplot.title("pyplot demo")
        pyplot.xlabel("x")
        pyplot.ylabel("y")
        pyplot.grid(1)
        pyplot.legend()
        pyplot.show()
        print("done")
