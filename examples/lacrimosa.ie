synth.open()
synth.set_mute(0)
synth.set_level(0.82)
synth.set_bpm(65)
synth.set_cutoff(0.48)
synth.set_reso(0.18)
synth.set_attack(0.22)
synth.set_decay(0.28)
synth.set_sustain(0.72)
synth.set_release(0.40)
synth.set_reverb(0.28)

print("Lacrimosa — choir + cello/bass; close the synth window to stop")

n : len(ev)
i : 0
t_base : ev[0]
ended : 0
t0 : clock()
print("playing", n / 4, "events from t=0 (skipped", t_base / 1000.0, "s rest)")
while synth.alive():
    now_ms : (clock() - t0) * 1000.0
    while i < n and (ev[i] - t_base) <= now_ms:
        hit : ev[i + 1]
        note : ev[i + 2]
        vel : ev[i + 3]
        if hit:
            synth.note_on(note, vel / 127.0)
        else:
            synth.note_off(note)
        i : i + 4
    if i >= n and not ended:
        print("piece ended — close the synth window")
        ended : 1
    synth.tick()

print("done")
