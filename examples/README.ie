# README as a gfx page (same mark + six links as the site).
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti examples/README.ie
#   SHAKTI_GFX_SKIP=1 ./shakti examples/README.ie
import gfx

W : 960
H : 720
UNITS : 42
OUTER : 3
INNER : 17
ORANGE : 0xFF751F
BLUE : 0x1F48FF
WHITE : 0xFFFFFF
MARK : 588
NWORD : 6

labels : ["site", "runtime", "modules", "license", "tree-sitter", "discord"]
urls : [
    "https://shakti.com",
    "https://github.com/fshakti/shakti/tree/master/src",
    "https://github.com/fshakti/shakti/tree/master/lib",
    "https://www.apache.org/licenses/LICENSE-2.0.txt",
    "https://github.com/avillega/tree-sitter-shakti",
    "https://discord.gg/kf8hXkZSb"
]

hit_x : [0, 0, 0, 0, 0, 0]
hit_w : [0, 0, 0, 0, 0, 0]
hit_y : [0, 0, 0, 0, 0, 0]
hit_h : [24]

def dump():
    print("site        https://shakti.com")
    print("runtime     https://github.com/fshakti/shakti/tree/master/src")
    print("modules     https://github.com/fshakti/shakti/tree/master/lib")
    print("license     https://www.apache.org/licenses/LICENSE-2.0.txt")
    print("tree-sitter https://github.com/avillega/tree-sitter-shakti")
    print("discord     https://discord.gg/kf8hXkZSb")
    return 0

def fill_frame(x, y, side, thick, col):
    if thick < 1:
        return 0
    if side < 1:
        return 0
    gfx.fill_rect(x, y, side, thick, col)
    gfx.fill_rect(x, y + side - thick, side, thick, col)
    gfx.fill_rect(x, y, thick, side, col)
    gfx.fill_rect(x + side - thick, y, thick, side, col)
    return 0

def draw_mark(cx, cy, size, field):
    n : UNITS
    x0 : cx - size // 2
    y0 : cy - size // 2
    thick : (OUTER * size) // n
    fill_frame(x0, y0, size, thick, field)
    k : 0
    while k < INNER:
        two : k // 2
        if k - two * 2 = 1:
            if k >= INNER - 2:
                k : k + 1
                continue
            inset : ((OUTER + k) * size) // n
            side : size - 2 * inset
            next_in : ((OUTER + k + 1) * size) // n
            band : next_in - inset
            fill_frame(x0 + inset, y0 + inset, side, band, field)
        k : k + 1
    return 0

def col_max(a, b):
    if b > a:
        return b
    return a

def in_hit(k, x, y):
    hx : hit_x[k]
    hy : hit_y[k]
    hw : hit_w[k]
    hh : hit_h[0]
    if x < hx:
        return 0
    if x > hx + hw:
        return 0
    if y < hy:
        return 0
    if y >= hy + hh:
        return 0
    return 1

def place_word(k, widths, x, y, scale, mx, my):
    hit_x[k] : x - 10
    hit_w[k] : widths[k] + 20
    hit_y[k] : y - 10
    col : WHITE
    if in_hit(k, mx, my):
        col : ORANGE
    gfx.text(x, y, labels[k], col, scale)
    return 0

def layout_words(cx, y, mx, my):
    scale : 3
    gap : 36
    widths : [0, 0, 0, 0, 0, 0]
    i : 0
    while i < NWORD:
        widths[i] : gfx.text_width(labels[i], scale)
        i : i + 1
    c0 : col_max(widths[0], widths[3])
    c1 : col_max(widths[1], widths[4])
    c2 : col_max(widths[2], widths[5])
    block : c0 + c1 + c2 + gap * 2
    x : cx - block / 2
    x1 : x + c0 + gap
    x2 : x1 + c1 + gap
    lead : 8 * scale + 8
    y1 : y + lead
    place_word(0, widths, x, y, scale, mx, my)
    place_word(1, widths, x1, y, scale, mx, my)
    place_word(2, widths, x2, y, scale, mx, my)
    place_word(3, widths, x, y1, scale, mx, my)
    place_word(4, widths, x1, y1, scale, mx, my)
    place_word(5, widths, x2, y1, scale, mx, my)
    hit_h[0] : lead
    return 0

def hit_nav(x, y):
    i : 0
    while i < NWORD:
        if in_hit(i, x, y):
            return i + 1
        i : i + 1
    return 0

def frame():
    cx : W / 2
    cy : H / 2 - 24
    mx : gfx.mouse_x()
    my : gfx.mouse_y()
    gfx.clear(BLUE)
    draw_mark(cx, cy, MARK, ORANGE)
    layout_words(cx, cy + MARK / 2 + 10, mx, my)
    if gfx.click_pending():
        nav : hit_nav(gfx.click_x(), gfx.click_y())
        gfx.consume_click()
        if nav > 0:
            print(urls[nav - 1])
    gfx.tick()
    return 0

if getenv("SHAKTI_GFX_SKIP") = "1":
    dump()
elif not gfx.available():
    print("gfx not available")
    dump()
else:
    gfx.open("shakti", W, H)
    while gfx.alive():
        frame()
    gfx.close()
