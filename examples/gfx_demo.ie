# Minimal Shakti GFX demo — clear, draw, tick until window closes.
import gfx

def pkg_ver():
    raw : read("src/VERSION")
    if type(raw) = "str":
        n : len(raw)
        if n > 0:
            if raw[n - 1] = "\n":
                raw : raw[0:n - 1]
        if len(raw) > 0:
            return raw
    return "0.16.0"

if not gfx.available():
    print("gfx not available")
else:
    gfx.open("Shakti GFX")
    gfx.clear(0x0a0a12)
    gfx.fill_rect(80, 60, 800, 40, 0x2244aa)
    gfx.text(100, 68, "Shakti " + pkg_ver(), 0xffffff, 2)
    gfx.fill_rect(120, 160, 200, 200, 0xff6644)
    gfx.fill_circle(640, 300, 90, 0x44dd88)
    gfx.line(40, 500, 920, 40, 0xffffff)
    while gfx.alive():
        if gfx.click_pending():
            x : gfx.click_x()
            y : gfx.click_y()
            gfx.fill_circle(x, y, 12, 0xffcc00)
            gfx.consume_click()
        gfx.tick()
    gfx.close()
    print("done")
