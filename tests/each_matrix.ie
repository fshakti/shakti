# each_matrix.ie — cover each_pack_mat shape/null guards (analyzer null-deref fix)
def inc(x):
    return x + 1

def add(a, b):
    return a + b

def label(x):
    if x > 2:
        return "big"
    return x

# Unary each on int matrix → packed int matrix
m: [[1, 2], [3, 4]]
r: inc@ m
assert(type(r) = "matrix[int]")
assert(r[0, 0] = 2)
assert(r[0, 1] = 3)
assert(r[1, 0] = 4)
assert(r[1, 1] = 5)

# Dyadic each matrix×matrix
n: [[10, 20], [30, 40]]
s: m add@ n
assert(type(s) = "matrix[int]")
assert(s[0, 0] = 11)
assert(s[1, 1] = 44)

# Scalar extension either side
assert((m add@ 10)[1, 0] = 13)
assert((5 add@ m)[0, 1] = 7)

# Float matrix packs to matrix[float]
f: abs@ [[-1.5, 2.0], [-3.25, 4.0]]
assert(type(f) = "matrix[float]")
assert(f[0, 0] = 1.5)
assert(f[1, 0] = 3.25)

# Heterogeneous cell results → list-of-row-lists (not a native matrix)
h: label@ [[1, 2], [3, 4]]
assert(type(h) = "list")
assert(len(h) = 2)
assert(h[0][0] = 1)
assert(h[1][0] = "big")

# Empty containers retain shape through each (no pack of null cells)
assert(len(inc@ []) = 0)
t0: table(a:[], b:[])
e0: abs@ t0
assert(type(e0) = "table")
assert(len(e0) = 0)

print("each_matrix ok")
