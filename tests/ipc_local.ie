# IPC local round-trip (UDS on localhost) + async poll
import ipc

port : 19987
sh("rm -f /tmp/shakti-19987.sock 2>/dev/null; true")
sh("./shakti -c 'import ipc; srv: ipc.listen(19987); c: ipc.accept(srv); ipc.send(c, ipc.recv(c)); ipc.close(c); ipc.close(srv)' &")
sh("sleep 1")

c : ipc.connect("127.0.0.1", port)
ipc.send(c, "ping")
assert(ipc.recv(c) = "ping")
ipc.close(c)

port2 : 19988
sh("rm -f /tmp/shakti-19988.sock 2>/dev/null; true")
sh("./shakti -c 'import ipc; srv: ipc.listen(19988); c: ipc.accept(srv); ipc.send(c, ipc.recv(c)); ipc.close(c); ipc.close(srv)' &")
sh("sleep 0.3")

c2 : ipc.connect("127.0.0.1", port2)
ipc.set_nonblock(c2, 1)
ipc.send(c2, "async")
ready : ipc.poll([c2], 3000)
assert(len(ready) >= 1)
msg : ipc.recv(c2)
assert(msg = "async")
ipc.close(c2)

tok : ipc.shm_open("smoke", 4096)
assert(tok >= 1)
ipc.shm_close(tok)

print("ipc ok")
