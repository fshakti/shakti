# Matrix type correctness (NEON / AVX / scalar)
a: [[1, 2], [3, 4]]
b: [[5, 6], [7, 8]]
c: mmul(a, b)
assert c[0, 0] = 19
assert c[0, 1] = 22
assert c[1, 0] = 43
assert c[1, 1] = 50
assert sum(a * b) = 70

f: [[1.0, 2.0], [3.0, 4.0]]
assert sum(f) = 10.0

flags: [[True, False], [False, True]]
cmp: flags > 0
assert cmp[0, 0] = True
assert cmp[0, 1] = False

mc: matrix[char](2, 2)
mc[0, 0]:1
mc[0, 1]:2
mc[1, 0]:3
mc[1, 1]:4
assert type(mc) = "matrix[char]"
assert mc[1, 1] = 4
print("matrix ok")
