def assert_true(cond, msg):
    if not cond:
        print("FAIL:", msg)
        raise msg

def assert_eq(a, b, msg):
    if a != b:
        print("FAIL:", msg, "got", a, "want", b)
        raise msg

m : [[1, 2], [3, 4]]
assert_eq(type(m), "matrix[int]", "literal promotes to matrix[int]")
assert_eq(m[0, 1], 2, "cell m[0,1]")
assert_eq(m[0], [1, 2], "row m[0]")

a : [[1, 2], [3, 4]]
b : [[5, 6], [7, 8]]
c : mmul(a, b)
assert_eq(c[0, 0], 19, "mmul [0,0]")
assert_eq(c[0, 1], 22, "mmul [0,1]")
assert_eq(c[1, 0], 43, "mmul [1,0]")
assert_eq(c[1, 1], 50, "mmul [1,1]")
assert_eq(type(c), "matrix[int]", "mmul int→int")

f : [[1.0, 2.0], [3.0, 4.0]]
g : [[5.0, 6.0], [7.0, 8.0]]
h : mmul(f, g)
assert_eq(type(h), "matrix[float]", "mmul float→float")
assert_eq(h[0, 0], 19.0, "mmul float [0,0]")
assert_eq(h[1, 1], 50.0, "mmul float [1,1]")

mixed : mmul(a, g)
assert_eq(type(mixed), "matrix[float]", "mmul int×float→float")
assert_eq(mixed[0, 0], 19.0, "mmul mixed [0,0]")

# rectangular / non-square
r : mmul([[1, 2, 3]], [[1], [2], [3]])
assert_eq(type(r), "matrix[int]", "mmul 1x3 @ 3x1 type")
assert_eq(shape(r), [1, 1], "mmul 1x3 @ 3x1 shape")
assert_eq(r[0, 0], 14, "mmul 1x3 @ 3x1 value")

# identity-ish via range rows
id4 : [range(4), range(4), range(4), range(4)]
assert_eq(type(id4), "matrix[int]", "range-row literal is matrix")
assert_eq(shape(id4), [4, 4], "range-row shape")

# error paths
assert_eq(type(mmul([[True, False], [False, True]], [[True, False], [False, True]])), "error", "mmul rejects matrix[bool]")
assert_eq(type(mmul([[1, 2], [3, 4]], [[1, 2, 3]])), "error", "mmul shape mismatch")
assert_eq(type(mmul([1, 2], [3, 4])), "error", "mmul rejects vectors")
assert_eq(type(mmul(a)), "error", "mmul arity")

# bare '@' is each, not matrix multiply — left must be callable
at : a @ b
assert_eq(type(at), "error", "@ requires callable")
assert_true("callable" in str(at), "@ error mentions callable")
assert_true("mmul" in str(at), "@ error mentions mmul")

p : a * b
assert_eq(p[0, 0], 5, "element-wise mul [0,0]")

s : m[0:1]
assert_eq(len(s), 1, "row slice len")
assert_eq(s[0, 0], 1, "row slice cell")

sh : shape(m)
assert_eq(sh[0], 2, "shape rows")
assert_eq(sh[1], 2, "shape cols")

flags : [[True, False], [False, True]]
mask : flags > 0
assert_eq(type(mask), "matrix[bool]", "comparison to bmat")

t : table(x: [[1, 2], [3, 4]])
col : t["x"]
assert_eq(type(col), "matrix[int]", "table matrix column")
assert_eq(col[1, 0], 3, "table column cell")

assert_true(isinstance(m, "matrix[int]"), "isinstance matrix[int]")

print("matrix tests ok")
