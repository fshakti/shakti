# M3 peer: connects with the shared SHAKTI_IPC_TOKEN, then a second
# connection with a wrong token must be rejected.
import ipc

port : 19271
c : None
for i in range(80):
    c : ipc.connect("127.0.0.1", port, "tcp")
    if type(c) = "int":
        break
    sh("sleep 0.05")
assert type(c) = "int"
ipc.send(c, "hello-secure")
got : ipc.recv(c)
assert got = "pong"
rep : ipc.send_sync(c, "ping", 5000)
assert rep = "ok-secure"
ipc.close(c)
print("ipc_secure_peer ok")
