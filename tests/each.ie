# Each (`f@ xs` / `xs f@ ys`)
# Run: SHAKTI_LIB=$PWD/lib ./shakti tests/each.ie

def add(a, b):
    return a + b

def neg1(x):
    return 0 - x

def id(x):
    return x

def wrap(x):
    return [x]

def offset(k):
    def apply(x):
        return x + k
    return apply

def make_add(k):
    def apply(a, b):
        return a + b + k
    return apply

# --- unary each -----------------------------------------------------------
assert(abs@ [1, -2, 3] = [1, 2, 3])
assert(type(abs@ range(4)) = "list[int]")
assert(neg1@ range(3) = [0, -1, -2])
assert(type(neg1@ [1.5, 2.5]) = "list[float]")
assert(type(wrap@ [1, 2]) = "list")
w : wrap@ [1, 2]
assert(w[0] = [1])
assert(w[1] = [2])
assert(offset(2)@ [1, 2] = [3, 4])
assert((lambda x: x + 1)@ [1, 2] = [2, 3])

# scalar unary
assert(abs@ -7 = 7)

# empty / string preservation
assert(id@ "" = "")
assert(type(id@ "") = "str")
assert(id@ "xy" = "xy")
assert(type(id@ "xy") = "str")
assert(neg1@ range(0) = [])
assert(type(id@ range(0)) = "list[int]")
assert(type(id@ []) = "list")
assert(type(range(0) add@ range(0)) = "list[int]")
assert(type((1.0 * range(0)) add@ (1.0 * range(0))) = "list[float]")
assert(type(range(0) add@ 1) = "list[int]")
assert(type(1 add@ range(0)) = "list[int]")

# nested list
assert(id@ [[1, 2], [3]] = [[1, 2], [3]])

# matrices (cellwise)
m : [[1, -2], [-3, 4]]
assert(abs@ m = [[1, 2], [3, 4]])
assert(type(abs@ m) = "matrix[int]")

# dictionaries (preserve keys, map values)
d : {"a": -1, "b": 2}
rd : abs@ d
assert(rd["a"] = 1)
assert(rd["b"] = 2)
assert(keys(rd) = ["a", "b"])

# tables (preserve columns / shape, map cells)
t : table(id:[1, -2], amt:[-3.0, 4.0])
rt : abs@ t
assert(columns(rt) = ["id", "amt"])
assert(shape(rt) = [2, 2])
assert(rt["id"] = [1, 2])
assert(rt["amt"] = [3.0, 4.0])

# --- dyadic each ----------------------------------------------------------
assert([1, 2] add@ [10, 20] = [11, 22])
assert(type([1, 2] add@ [10, 20]) = "list[int]")

# scalar extension both sides
assert([1, 2] add@ 5 = [6, 7])
assert(5 add@ [1, 2] = [6, 7])
assert(2 add@ 3 = 5)
assert([1, 2] make_add(1)@ [10, 20] = [12, 23])

# strings pairwise
assert("ab" add@ "cd" = ["ac", "bd"])

# matrices
a : [[1, 2], [3, 4]]
b : [[10, 20], [30, 40]]
assert(a add@ b = [[11, 22], [33, 44]])
assert(type(a add@ b) = "matrix[int]")
assert(a add@ 1 = [[2, 3], [4, 5]])

# dictionaries by matching keys
d1 : {"x": 1, "y": 2}
d2 : {"y": 20, "x": 10}
rd2 : d1 add@ d2
assert(rd2["x"] = 11)
assert(rd2["y"] = 22)
assert((d1 add@ 5)["x"] = 6)
assert((5 add@ d1)["y"] = 7)

# tables by matching columns
t1 : table(a:[1, 2], b:[3, 4])
t2 : table(b:[30, 40], a:[10, 20])
rt2 : t1 add@ t2
assert(columns(rt2) = ["a", "b"])
assert(rt2["a"] = [11, 22])
assert(rt2["b"] = [33, 44])
assert((t1 add@ 1)["a"] = [2, 3])
assert((1 add@ t1)["b"] = [4, 5])

te : table(a:range(0), b:1.0 * range(0))
assert(type((abs@ te)["a"]) = "list[int]")
assert(type((abs@ te)["b"]) = "list[float]")
assert(type((te add@ te)["a"]) = "list[int]")
assert(type((te add@ te)["b"]) = "list[float]")

# --- errors ---------------------------------------------------------------
err_len : range(2) add@ range(3)
assert(type(err_len) = "error")

err_mat : [[1, 2]] add@ [[1, 2], [3, 4]]
assert(type(err_mat) = "error")

err_keys : {"a": 1} add@ {"b": 2}
assert(type(err_keys) = "error")

err_schema : table(a:[1]) add@ table(b:[2])
assert(type(err_schema) = "error")

# bare infix with non-callable left operand
mm : [[1, 2], [3, 4]]
err_bare : mm @ mm
assert(type(err_bare) = "error")

# live streams are intentionally not consumed
err_stream : id@ input(2)
assert(type(err_stream) = "error")

# dotted callable
fns : {"neg": neg1}
assert(fns.neg@ [1, -2] = [-1, 2])

print("each ok")
