# sql_insert_numeric.ie — VALUES all-numeric must not segfault / no-op;
# char / matrix[char] columns must grow on insert and empty on delete.
import sql

create table t (a: 0, b: 0.0)
insert into t (a, b) values (1, 2.5)
insert into t (a, b) values (3, 4.0)
assert(len(t) = 2)
assert(t["a"][0] = 1)
assert(t["b"][1] = 4.0)

c0 : list[char](0)
create table ch (id: 0, flags: c0)
insert into ch (id, flags) values (1, 0x41)
insert into ch (id, flags) values (2, 0x0a)
assert(len(ch) = 2)
assert(type(ch.flags) = "list[char]")
assert(ch.flags[0] = 65)
assert(ch.flags[1] = 10)

m0 : matrix[char](0, 2)
create table cm (id: 0, row: m0)
insert into cm (id, row) values (1, list[char](2))
assert(len(cm) = 1)
assert(type(cm.row) = "matrix[char]")
assert(cm.row[0, 0] = 0)
assert(cm.row[0, 1] = 0)

delete from ch
assert(len(ch) = 0)
assert(type(ch.flags) = "list[char]")
assert(len(ch.flags) = 0)

u: table(x:[10], y:[20])
insert into u (x, y) values (30, 40)
assert(len(u) = 2)
assert(u["x"][1] = 30)
print("sql_insert_numeric ok")
