import synth

assert synth.open() = nil

# Verify initial states
assert synth.metro_on() = 0
assert synth.playing() = 0

initial_steps : synth.steps()

# Click on metro button at (78, 26)
synth.mouse_press(78, 26)
synth.mouse_release(78, 26)

synth.tick()

assert synth.metro_on() = 1

# Click on step_plus button at (315, 26)
# Let's find step_plus in the layout:
# L->step_plus is at x : L->step_box.x + L->step_box.w + 4
# step_box is {262, 16, 44, 28}
# So step_plus is {310, 16, 22, 28}
# We'll click at (320, 26)
synth.mouse_press(320, 26)
synth.mouse_release(320, 26)

synth.tick()

assert synth.steps() = initial_steps + 1

synth.close()
print("Synth UI tests passed.")
