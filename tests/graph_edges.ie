# graph edge cases — wildcards, multiple graphs, neighbor directions
import graph

graph.create()

assert(graph.add("Ada", "knows", "Bob") = 1)
assert(graph.add("Bob", "knows", "Carol") = 2)
assert(graph.add("Carol", "knows", "Dave") = 3)

in_only : graph.neighbors("Carol", "in")
assert(shape(in_only)[0] = 1)
assert(in_only["subject"][0] = "Bob")

out_only : graph.neighbors("Carol", "out")
assert(shape(out_only)[0] = 1)
assert(out_only["object"][0] = "Dave")

assert(graph.add("", "empty_subj", "obj") = 4)
q : graph.query("", "empty_subj", "obj")
assert(shape(q)[0] = 1)

assert(graph.add("Ada", "knows", "") = 5)
q2 : graph.query("Ada", "knows", "*")
assert(shape(q2)[0] = 2)

g2 : graph_create()
graph_add(g2, "X", "p", "Y")
assert(graph_count(g2) = 1)
assert(graph_count(0) = 5)

pred_q : graph_query(0, "*", "knows", "*")
assert(shape(pred_q)[0] = 4)

long_path : graph.path("Ada", "Dave", 10)
assert(len(long_path) = 4)

print("graph_edges ok")
