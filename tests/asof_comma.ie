# Dyadic comma as-of join tests.

left : table(time:[0, 2, 3, 7, 11], order_id:[10, 11, 12, 13, 14])
right : table(time:[1, 3, 3, 8], quote_id:[20, 30, 31, 80], px:[1.0, 3.0, 3.1, 8.0])
got : left, right

assert(columns(got) = ["time", "order_id", "quote_id", "px"])
assert(shape(got) = [5, 4])
assert(got.time = left.time)
assert(got.order_id = left.order_id)

# Below-range misses are null; duplicates select the last equal row.
assert(type(got.quote_id[0]) = "NoneType")
assert(got.quote_id[1] = 20)
assert(got.quote_id[2] = 31)
assert(got.quote_id[3] = 31)
assert(got.quote_id[4] = 80)
assert(got.px[2] = 3.1)

# time_ns is also accepted and a no-miss join preserves typed payload vectors.
left_ns : table(time_ns:[2, 9], id:[1, 2])
right_ns : table(time_ns:[1, 8], bid:[10.5, 11.5])
got_ns : left_ns, right_ns
assert(type(got_ns.bid) = "list[float]")
assert(got_ns.bid = [10.5, 11.5])

# Empty right side produces null payloads for every left row.
empty_right : table(time:range(0), value:range(0))
empty_got : left, empty_right
assert(type(empty_got.value[0]) = "NoneType")
assert(type(empty_got.value[4]) = "NoneType")

# Both operands must be tables keyed by the same sorted integer time column.
bad_name : table(ts:[1], value:[1])
e1 : left, bad_name
assert(type(e1) = "error")
bad_order : table(time:[3, 1], value:[3, 1])
e2 : left, bad_order
assert(type(e2) = "error")
bad_left_order : table(time:[2, 1], id:[2, 1])
e3 : bad_left_order, right
assert(type(e3) = "error")
duplicate_payload : table(time:[1], order_id:[99])
e4 : left, duplicate_payload
assert(type(e4) = "error")
e5 : [1], [2]
assert(type(e5) = "error")

print("asof comma ok")
