# Char types, hex ints, constructors, table head/tail.

assert(type(0x44dd88) = "int")
assert(0x44dd88 = 4513160)
assert(0x0a = 10)
assert((-0x0a) = -10)
assert(type(0x0) = "int")
assert(type(0x0a) = "char")
assert(type(0xff) = "char")
assert(type(0x100) = "int")

assert(type(list()) = "list")
assert(len(list()) = 0)

x : list[char](4)
assert(type(x) = "list[char]")
assert(len(x) = 4)
x[0]:65
x[1]:10
assert(type(x[0]) = "char")
assert(x[0] = 65)
assert(x[1] = 10)

m : matrix[char](2, 2)
assert(type(m) = "matrix[char]")
m[0, 0]:65
m[0, 1]:66
assert(m[0, 0] = 65)
assert(m[0, 1] = 66)

f : list[char](5)
f[0]:10
f[1]:20
f[2]:30
f[3]:40
f[4]:50
t : table(id: 1 2 3 4 5, flags: f)
assert(type(t.flags) = "list[char]")
h : head(t, 2)
assert(len(h) = 2)
assert(type(h.flags) = "list[char]")
assert(h.flags[0] = 10)
assert(h.flags[1] = 20)
tl : tail(t, 2)
assert(len(tl) = 2)
assert(tl.flags[0] = 40)
assert(tl.flags[1] = 50)

print("char ok")
