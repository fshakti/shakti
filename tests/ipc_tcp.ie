# IPC over TCP loopback (explicit transport, not UDS default).
import ipc

port : 19990
sh("rm -f /tmp/shakti-19990.sock 2>/dev/null; true")
sh("./shakti -c 'import ipc; srv: ipc.listen(19990, \"127.0.0.1\", \"tcp\"); c: ipc.accept(srv); ipc.send(c, ipc.recv(c)); ipc.close(c); ipc.close(srv)' &")
sh("sleep 0.5")

c : ipc.connect("127.0.0.1", port, "tcp")
ipc.send(c, "tcp-hello")
assert(ipc.recv(c) = "tcp-hello")
ipc.close(c)
print("ipc tcp ok")
