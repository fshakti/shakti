# RDMA IPC smoke — skips when no device
import ipc

if ipc.rdma_available() != 1:
    print("ipc rdma skip (no device)")
else:
    port : 19989
    sh("./shakti -c 'import ipc; srv: ipc.listen(19989, \"127.0.0.1\", \"rdma\"); c: ipc.accept(srv); ipc.send(c, ipc.recv(c)); ipc.close(c); ipc.close(srv)' &")
    sh("sleep 1")
    c : ipc.connect("127.0.0.1", port, "rdma")
    ipc.send(c, "rdma-ping")
    assert(ipc.recv(c) = "rdma-ping")
    ipc.close(c)
    print("ipc rdma ok")
