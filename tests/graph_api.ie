# graph module API tests
import graph

graph.create()

assert(graph.add("Ada", "knows", "Bob") = 1)
assert(graph.add("Bob", "knows", "Carol") = 2)
assert(graph.add("Ada", "worksAt", "Acme") = 3)
assert(graph.count() = 3)

q : graph.query("Ada", "knows", "*")
assert(shape(q)[0] = 1)
assert(q["subject"][0] = "Ada")
assert(q["predicate"][0] = "knows")
assert(q["object"][0] = "Bob")

q2 : graph.query("*", "worksAt", "*")
assert(shape(q2)[0] = 1)
assert(q2["object"][0] = "Acme")

nb : graph.neighbors("Bob", "both")
assert(shape(nb)[0] = 2)

path : graph.path("Ada", "Carol", 4)
assert(len(path) = 3)
assert(path[0] = "Ada")
assert(path[1] = "Bob")
assert(path[2] = "Carol")

empty : graph.path("Ada", "Dave", 2)
assert(len(empty) = 0)

graph.clear()
assert(graph.count() = 0)

graph.add("X", "link", "Y")
people : table(name: ["A", "B"], friend: ["B", "C"])
graph.from_table(people, "name", "knows", "friend")
assert(graph.count() = 3)

tbl : graph.to_table("*", "knows", "*")
assert(shape(tbl)[0] = 2)

chain_g : graph_create()
for i in range(50):
    graph_add(chain_g, "c" + str(i), "next", "c" + str(i + 1))
chain_path : graph_path(chain_g, "c0", "c50", 60)
assert(len(chain_path) = 51)

print("graph_api ok")
