# Syntax: colon assignment, equals equality

x : 1
assert(x = 1)

a : 2
b : 3
assert(a = 2 and b = 3)

def g(n:2):
    return n + 1

assert(g() = 3)
assert(g(5) = 6)

def kw(k):
    return k

assert(kw(k:1) = 1)

d : {"k": "v"}
assert(d["k"] = "v")

v : [0, 1, 2, 3][1:3]
assert(len(v) = 2)
assert(v[0] = 1)

if 1 = 1:
    ok : 1
else:
    ok : 0
assert(ok = 1)

print("syntax_assign ok")
