# Decorator sugar — parser and evaluator coverage.
# Run: SHAKTI_LIB=$PWD/lib ./shakti tests/decorators.ie

# 1. simple wrap
def times(f):
    def w(n):
        return f(n) * n
    return w

@times
def id1(n):
    return n

assert(id1(5) = 25)

# 2. stacked (nearest-first: bang(shout(x)))
def bang(f):
    def w(s):
        return f(s) + "!"
    return w
def shout(f):
    def w(s):
        return f(s) + "?"
    return w

@bang
@shout
def say(s):
    return s

assert(say("hi") = "hi?!")

# 3. decorator factory
def repeat(k):
    def deco(f):
        def w(s):
            out : ""
            for i in range(k):
                out : out + f(s)
            return out
        return w
    return deco

@repeat(3)
def emit(s):
    return s

assert(emit("ab") = "ababab")

# 4. decorating an actual class
def tag(c):
    return c

@tag
class Widget:
    label : "widget"

assert(Widget["label"] = "widget")

# 5. decorating a lambda assignment (RHS wrapped directly)
def compose(f):
    def w(x):
        return f(f(x))
    return w

@compose
dbl : lambda x: x + x

assert(dbl(3) = 12)

# 6. dotted decorator lookup
decorators : {"identity": tag}

@decorators.identity
def dotted(n):
    return n + 1

assert(dotted(4) = 5)

# 7. factory closures retain their arguments
def add(k):
    def deco(f):
        def w(n):
            return f(n) + k
        return w
    return deco

@add(2)
@add(3)
def base(n):
    return n

assert(base(10) = 15)

print("decorators ok")
