# pyplot.show() must return immediately when SHAKTI_GFX_SKIP=1.
import pyplot
import gfx

assert getenv("SHAKTI_GFX_SKIP") = "1"

pyplot.clf()
pyplot.plot([1, 2, 3, 5])
pyplot.title("skip")
pyplot.xlabel("x")
pyplot.ylabel("y")
pyplot.grid(1)
pyplot.show()
pyplot.close()

# Stubs used by show()/draw remain callable without a window.
av : gfx.available()
t : type(av)
ok : 0
if t = "bool":
    ok : 1
if t = "int":
    ok : 1
if t = "error":
    ok : 1
assert ok = 1

print("pyplot_skip ok")
