# rest — HTTP client (curl) and minimal HTTP/1.1 server (TCP)
#
# Client requires curl on PATH. Optional bearer token:
#   export SHAKTI_REST_TOKEN=...
#
#   import rest
#   resp : rest.get("https://example.com/api")
#   if rest.ok(resp):
#       print(rest.json(resp))
#
# Binary Shakti values over HTTP:
#   rest.post_iefs(url, obj)           # Content-Type: application/iefs
#   rest.post_hld(url, obj, codec:"zstd")
#   rest.respond_iefs(conn, 200, obj)
#   rest.respond_hld(conn, 200, obj)
#
# Server:
#   srv : rest.listen(8080)
#   conn : rest.accept(srv)
#   req : rest.read(conn)
#   rest.write(conn, 200, "hello")
#   rest.close(conn)
#   rest.close(srv)

def request(method, url, body:"", content_type:"", headers:0):
    if headers:
        return rest_request(method, url, body, content_type, headers)
    return rest_request(method, url, body, content_type)

def get(url):
    return rest_get(url)

def post(url, body:"", content_type:""):
    return rest_post(url, body, content_type)

def put(url, body:"", content_type:""):
    return rest_put(url, body, content_type)

def delete(url):
    return rest_delete(url)

def post_json(url, obj):
    return rest_post(url, json_dumps(obj), "application/json")

def put_json(url, obj):
    return rest_put(url, json_dumps(obj), "application/json")

def post_iefs(url, obj, codec:"", level:3):
    if codec = "":
        blob : iefs_dumps(obj)
    else:
        blob : iefs_dumps(obj, codec, level)
    return rest_post(url, blob, "application/iefs")

def put_iefs(url, obj, codec:"", level:3):
    if codec = "":
        blob : iefs_dumps(obj)
    else:
        blob : iefs_dumps(obj, codec, level)
    return rest_put(url, blob, "application/iefs")

def post_hld(url, obj, codec:"", level:3):
    if codec = "":
        blob : hld_encode(obj)
    else:
        blob : hld_encode(obj, codec, level)
    return rest_post(url, blob, "application/x-hld")

def put_hld(url, obj, codec:"", level:3):
    if codec = "":
        blob : hld_encode(obj)
    else:
        blob : hld_encode(obj, codec, level)
    return rest_put(url, blob, "application/x-hld")

def status(resp):
    return resp["status"]

def ok(resp):
    s : resp["status"]
    return s >= 200 and s < 300

def text(resp):
    if hasattr(resp, "raw"):
        return resp["raw"]
    return str(resp["body"])

def json(resp):
    return resp["body"]

def iefs(resp):
    return resp["body"]

def hld(resp):
    return resp["body"]

def listen(port, host:"127.0.0.1"):
    return rest_listen(port, host)

def listen_tls(port, cert, key, host:"127.0.0.1"):
    return rest_listen_tls(port, cert, key, host)

def accept(listen_h):
    return rest_accept(listen_h)

def read(conn):
    return rest_read(conn)

def write(conn, status, body:"", content_type:"text/plain"):
    return rest_write(conn, status, body, content_type)

def respond_json(conn, status, obj):
    return rest_write(conn, status, json_dumps(obj), "application/json")

def respond_iefs(conn, status, obj, codec:"", level:3):
    if codec = "":
        blob : iefs_dumps(obj)
    else:
        blob : iefs_dumps(obj, codec, level)
    return rest_write(conn, status, blob, "application/iefs")

def respond_hld(conn, status, obj, codec:"", level:3):
    if codec = "":
        blob : hld_encode(obj)
    else:
        blob : hld_encode(obj, codec, level)
    return rest_write(conn, status, blob, "application/x-hld")

def set_nonblock(h, enabled):
    return rest_set_nonblock(h, enabled)

def close(h):
    return rest_close(h)
