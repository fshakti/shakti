# draughts_ai — negamax + alpha-beta, material and man advancement

import draughts_core
import gfx
import input

KEY_ESC : 65307

MAN_VAL : 100
KING_VAL : 300

def evaluate(st):
    board : st["board"]
    score : 0
    r : 0
    while r < 8:
        c : 0
        while c < 8:
            p : board[r, c]
            if p != 0:
                col : draughts_core.piece_color(p)
                t : draughts_core.piece_type(p)
                v : MAN_VAL
                if t = draughts_core.KING:
                    v : KING_VAL
                else:
                    adv : r
                    if col = 1:
                        adv : 7 - r
                    v : v + adv * 4
                score : score + col * v
            c : c + 1
        r : r + 1
    return score

def order_moves(moves):
    jumps : []
    quiet : []
    i : 0
    while i < len(moves):
        mv : moves[i]
        step0 : mv["steps"][0]
        if step0["cr"] >= 0 or mv["promo"] = 1:
            jumps.append(mv)
        else:
            quiet.append(mv)
        i : i + 1
    out : []
    i : 0
    while i < len(jumps):
        out.append(jumps[i])
        i : i + 1
    i : 0
    while i < len(quiet):
        out.append(quiet[i])
        i : i + 1
    return out

def negamax(st, depth, alpha, beta, color):
    if depth = 0:
        return color * evaluate(st)
    moves : draughts_core.legal_moves(st)
    if len(moves) = 0:
        return -100000 - depth
    moves : order_moves(moves)
    best : -999999
    i : 0
    while i < len(moves):
        mv : moves[i]
        undo : draughts_core.make_move(st, mv)
        val : 0 - negamax(st, depth + (-1), 0 - beta, 0 - alpha, 0 - color)
        draughts_core.unmake_move(st, undo)
        if val > best:
            best : val
        if val > alpha:
            alpha : val
        if alpha >= beta:
            break
        i : i + 1
    return best

def default_depth():
    v : getenv("DRAUGHTS_DEPTH")
    if type(v) = "NoneType":
        return 4
    if type(v) = "str":
        if len(v) = 0:
            return 4
        n : int(v)
        if n < 1:
            return 1
        if n > 4:
            return 4
        return n
    return 4

def esc_pressed():
    if gfx.alive() = 1:
        gfx.tick()
        gfx.sync_keys()
    for ev in input(0):
        if ev["kind"] = "key":
            if ev["code"] = KEY_ESC:
                return 1
    return 0

def choose_move(st, depth:0):
    if depth = 0:
        depth : default_depth()
    moves : draughts_core.legal_moves(st)
    if len(moves) = 0:
        return 0
    moves : order_moves(moves)
    color : st["turn"]
    best_val : -999999
    best_mv : moves[0]
    alpha : -999999
    beta : 999999
    i : 0
    while i < len(moves):
        if esc_pressed() = 1:
            return "cancel"
        mv : moves[i]
        undo : draughts_core.make_move(st, mv)
        val : 0 - negamax(st, depth + (-1), 0 - beta, 0 - alpha, 0 - color)
        draughts_core.unmake_move(st, undo)
        if val > best_val:
            best_val : val
            best_mv : mv
        if val > alpha:
            alpha : val
        i : i + 1
    return best_mv

def play_ai_move(st, depth:0):
    mv : choose_move(st, depth)
    st["ai_pending"] : 0
    if type(mv) = "str":
        if mv = "cancel":
            st["ai_cancel"] : 1
            return
    if type(mv) = "dict":
        draughts_core.apply_and_finish(st, mv)
        st["ai_pending"] : 0
