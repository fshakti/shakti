def _blank(v):
    if v = None:
        return 1
    if type(v) = "str":
        if v = "":
            return 1
    return 0

def _on(v):
    if v = True:
        return 1
    if v = False or v = None:
        return 0
    if type(v) = "int" or type(v) = "float":
        if v = 0:
            return 0
        return 1
    if type(v) = "str":
        if v = "":
            return 0
        return 1
    return 1

def _parse_color(c):
    if type(c) = "int":
        return c
    if type(c) = "float":
        return int(c)
    if type(c) != "str":
        return 0xffffff
    if c in _NAMES:
        return _NAMES[c]
    if len(c) > 0:
        if c[0] = "#":
            n : int("0x" + c[1:])
            if type(n) != "error":
                return n
    return 0xffffff

def _color(c, default):
    if _blank(c):
        return default
    return _parse_color(c)

def _as_list(v):
    t : type(v)
    if t = "int" or t = "float" or t = "bool" or t = "str" or t = "NoneType" or t = "error":
        out : []
        out.append(v)
        return out
    out : []
    for x in v:
        out.append(x)
    return out

def _pair(a, b):
    xs : _as_list(a)
    ys : _as_list(b)
    if len(xs) = 1 and len(ys) > 1:
        v : xs[0]
        xs : []
        i : 0
        while i < len(ys):
            xs.append(v)
            i : i + 1
    if len(ys) = 1 and len(xs) > 1:
        v : ys[0]
        ys : []
        i : 0
        while i < len(xs):
            ys.append(v)
            i : i + 1
    if len(xs) != len(ys):
        raise "mplsoccer: x and y length mismatch"
    return dict(x:xs, y:ys)

def _quad(a, b, c, d):
    xs : _pair(a, b)
    ys : _pair(c, d)
    if len(xs["x"]) != len(ys["x"]):
        raise "mplsoccer: start and end length mismatch"
    return dict(x0:xs["x"], y0:xs["y"], x1:ys["x"], y1:ys["y"])

def _atan2(y, x):
    if x = 0:
        if y = 0:
            return 0.0
    ax : x
    if ax < 0:
        ax : -ax
    ay : y
    if ay < 0:
        ay : -ay
    small : ax
    big : ay
    if ay < ax:
        small : ay
        big : ax
    if big = 0:
        return 0.0
    q : small / big
    s : q * q
    r : ((-0.0464964749 * s + 0.15931422) * s - 0.327622764) * s * q + q
    if ay > ax:
        r : 1.5707963267948966 - r
    if x < 0:
        r : 3.141592653589793 - r
    if y < 0:
        r : -r
    return r

def _canon(name):
    if name = "statsbomb" or name = "uefa" or name = "opta" or name = "wyscout" or name = "tracab" or name = "metricasports" or name = "skillcorner" or name = "impect" or name = "secondspectrum" or name = "custom":
        return name
    raise "mplsoccer: pitch type not supported: " + str(name)

def _varies(name):
    if name = "tracab" or name = "metricasports" or name = "custom" or name = "skillcorner" or name = "secondspectrum":
        return 1
    return 0

def _sizes(name, length, width):
    if _varies(name) = 0:
        return dict(length:0.0, width:0.0)
    if name = "custom" and _blank(length) and _blank(width):
        return dict(length:105.0, width:68.0)
    if _blank(length) or _blank(width):
        raise "mplsoccer: pitch_length and pitch_width required for " + name
    L : float(length)
    W : float(width)
    if type(L) = "error" or type(W) = "error" or L <= 0 or W <= 0:
        raise "mplsoccer: pitch_length and pitch_width must be positive"
    return dict(length:L, width:W)

def _sort_nums(a):
    i : 1
    while i < len(a):
        v : a[i]
        j : i
        while j > 0 and a[j - 1] > v:
            a[j] : a[j - 1]
            j : j - 1
        a[j] : v
        i : i + 1
    return a

def _finish(d):
    d["x_marks"] : _sort_nums([d["left"], d["six_left"], d["pen_left"], d["box_left"], d["center_length"], d["box_right"], d["pen_right"], d["six_right"], d["right"]])
    d["y_marks"] : _sort_nums([d["bottom"], d["box_bottom"], d["six_bottom"], d["goal_bottom"], d["goal_top"], d["six_top"], d["box_top"], d["top"]])
