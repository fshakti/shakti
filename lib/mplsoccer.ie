    if dy < 0:
        dy : -dy
    rr : dx
    if dy > rr:
        rr : dy
    if rr < 2:
        rr : 2
    gfx.fill_circle(p["x"], p["y"], rr, color)

def _arc_theta(dim):
    dx : dim["penalty_area_length"] - dim["pen_math"]
    rx : dim["circle_rx"]
    ry : dim["circle_ry"]
    if dx <= 0:
        return 90.0
    if rx <= 0:
        return 0.0
    if dx >= rx:
        return 0.0
    inner : 1.0 - (dx / rx) * (dx / rx)
    if inner <= 0:
        return 0.0
    dy : ry * sqrt(inner)
    return _atan2(dy, dx) * 180.0 / _PI

def _stripe_edges(dim):
    pen : (dim["penalty_area_length"] - dim["six_yard_length"]) / 2.0
    other : (dim["length"] - 2.0 * dim["six_yard_length"] - 6.0 * pen) / 10.0
    widths : []
    widths.append(dim["six_yard_length"])
    i : 0
    while i < 3:
        widths.append(pen)
        i : i + 1
    i : 0
    while i < 10:
        widths.append(other)
        i : i + 1
    i : 0
    while i < 3:
        widths.append(pen)
        i : i + 1
    widths.append(dim["six_yard_length"])
    edges : []
    edges.append(0.0)
    acc : 0.0
    for dw in widths:
        acc : acc + dw
        edges.append(acc)
    return edges

def _paint_pitch():
    dim : _pitch["dim"]
    length : dim["length"]
    width : dim["width"]
    col : _pitch["line_color"]
    _rect_math(0.0, 0.0, length, width, _pitch["pitch_color"])
    if _pitch["stripe"]:
        edges : _stripe_edges(dim)
        i : 1
        while i < len(edges):
            _rect_math(edges[i - 1], 0.0, edges[i], width, _pitch["stripe_color"])
            i : i + 2
    if _pitch["shade_middle"]:
        _rect_math(length / 3.0, 0.0, length * 2.0 / 3.0, width, _pitch["shade_color"])
    if _pitch["positional"]:
        pa : dim["penalty_area_length"]
        c : dim["length"] / 2.0
        mid_l : pa + (c - pa) / 2.0
        mid_r : c + (length - pa - c) / 2.0
        pcol : _pitch["positional_color"]
        for mx in [0.0, pa, mid_l, c, mid_r, length - pa, length]:
            _line_math(mx, 0.0, mx, width, pcol)
        ylo_pen : (width - dim["penalty_area_width"]) / 2.0
        ylo_six : (width - dim["six_yard_width"]) / 2.0
        for my in [0.0, ylo_pen, ylo_six, width - ylo_six, width - ylo_pen, width]:
            _line_math(0.0, my, length, my, pcol)
    _box_math(0.0, 0.0, length, width, col)
    _line_math(length / 2.0, 0.0, length / 2.0, width, col)
    pen_lo : (width - dim["penalty_area_width"]) / 2.0
    pen_hi : width - pen_lo
    six_lo : (width - dim["six_yard_width"]) / 2.0
    six_hi : width - six_lo
    pa : dim["penalty_area_length"]
    six : dim["six_yard_length"]
    _box_math(0.0, pen_lo, pa, pen_hi, col)
    _box_math(length - pa, pen_lo, length, pen_hi, col)
    _box_math(0.0, six_lo, six, six_hi, col)
    _box_math(length - six, six_lo, length, six_hi, col)
    radx : dim["circle_rx"]
    rady : dim["circle_ry"]
    _stroke_arc(length / 2.0, width / 2.0, radx, rady, 0.0, 360.0, col)
    theta : _arc_theta(dim)
    if theta > 0:
        _stroke_arc(dim["pen_math"], width / 2.0, radx, rady, -theta, theta, col)
        _stroke_arc(length - dim["pen_math"], width / 2.0, radx, rady, 180.0 - theta, 180.0 + theta, col)
    if _pitch["corner_arcs"]:
        crx : dim["corner_rx"]
        cry : dim["corner_ry"]
        _stroke_arc(0.0, 0.0, crx, cry, 0.0, 90.0, col)
        _stroke_arc(length, 0.0, crx, cry, 90.0, 180.0, col)
        _stroke_arc(length, width, crx, cry, 180.0, 270.0, col)
        _stroke_arc(0.0, width, crx, cry, 270.0, 360.0, col)
    _spot_math(length / 2.0, width / 2.0, col)
    _spot_math(dim["pen_math"], width / 2.0, col)
    _spot_math(length - dim["pen_math"], width / 2.0, col)
    glo : (width - dim["goal_width"]) / 2.0
    ghi : width - glo
    _line_math(0.0, glo, 0.0, ghi, col)
    _line_math(length, glo, length, ghi, col)
    if _pitch["goal_type"] = "box":
        gl : dim["goal_length"]
        _line_math(-gl, glo, -gl, ghi, col)
        _line_math(-gl, glo, 0.0, glo, col)
        _line_math(-gl, ghi, 0.0, ghi, col)
        _line_math(length + gl, glo, length + gl, ghi, col)
        _line_math(length, glo, length + gl, glo, col)
        _line_math(length, ghi, length + gl, ghi, col)

def _cmap(t):
    r : int(247 + (8 - 247) * t)
    g : int(251 + (48 - 251) * t)
    b : int(255 + (107 - 255) * t)
    return r * 65536 + g * 256 + b

def _paint_heatmap(op):
    st : op["stats"]
    grid : st["statistic"]
    xe : st["x_edge"]
    ye : st["y_edge"]
    ny : len(grid)
    if ny = 0:
        return
    nx : len(grid[0])
    lo : 0.0
    hi : 0.0
    seen : 0
    if _blank(op["vmin"]) or _blank(op["vmax"]):
        for row in grid:
            for v in row:
                if seen = 0:
                    lo : v
                    hi : v
                    seen : 1
                else:
                    if v < lo:
                        lo : v
                    if v > hi:
                        hi : v
    if not _blank(op["vmin"]):
        lo : float(op["vmin"])
    if not _blank(op["vmax"]):
        hi : float(op["vmax"])
    span : hi - lo
    if len(xe) < nx + 1 or len(ye) < ny + 1:
        return
    iy : 0
    while iy < ny:
        ix : 0
        while ix < nx:
            t : 0.0
            if span > 0:
                t : (grid[iy][ix] - lo) / span
            if t < 0:
                t : 0.0
            if t > 1:
                t : 1.0
            _rect_data(xe[ix], ye[iy], xe[ix + 1], ye[iy + 1], _cmap(t))
            ix : ix + 1
        iy : iy + 1

def _arrow_px(x0, y0, x1, y1, color):
    if x0 = x1 and y0 = y1:
        return
    gfx.line(x0, y0, x1, y1, color)
    ang : _atan2(y1 - y0, x1 - x0)
    h : 10.0
    a : 0.45
    gfx.line(x1, y1, int(x1 - h * cos(ang - a)), int(y1 - h * sin(ang - a)), color)
    gfx.line(x1, y1, int(x1 - h * cos(ang + a)), int(y1 - h * sin(ang + a)), color)

def _paint_arrows(x0, y0, x1, y1, color):
    i : 0
    while i < len(x0):
        p : _px(x0[i], y0[i])
        q : _px(x1[i], y1[i])
        _arrow_px(p["x"], p["y"], q["x"], q["y"], color)
        i : i + 1

def _bin_index(v, lo, hi, n):
    vs : str(v)
    if type(v) = "error" or vs = "nan" or vs = "-nan":
        return -1
    if v < lo or v > hi:
        return -1
    i : int((v - lo) / (hi - lo) * n)
    if i >= n:
        i : n - 1
    if i < 0:
        i : 0
    return i

def _limit_bins(n):
    if type(n) = "error":
        raise "mplsoccer: bins must be a positive count"
    if n < 1:
        n : 1
    if n > _BIN_MAX:
        raise "mplsoccer: bins exceed 200 per axis"
    return n

def _parse_bins(bins):
    if _blank(bins):
        return dict(nx:5, ny:4)
    t : type(bins)
    if t = "int" or t = "float":
        n : _limit_bins(int(bins))
        return dict(nx:n, ny:n)
    nx : 5
    ny : 4
    if len(bins) >= 2:
        nx : int(bins[0])
        ny : int(bins[1])
    elif len(bins) = 1:
        nx : int(bins[0])
        ny : nx
    return dict(nx:_limit_bins(nx), ny:_limit_bins(ny))

def _paint_flow(op):
    dim : _pitch["dim"]
    b : _parse_bins(op["bins"])
    nx : b["nx"]
    ny : b["ny"]
    x0 : dim["left"]
    x1 : dim["right"]
    y0 : _y_lo(dim)
    y1 : _y_hi(dim)
    sums : []
    iy : 0
    while iy < ny:
        row : []
        ix : 0
        while ix < nx:
            row.append(dict(sx:0.0, sy:0.0, n:0))
            ix : ix + 1
        sums.append(row)
        iy : iy + 1
    i : 0
    while i < len(op["x0"]):
        ix : _bin_index(op["x0"][i], x0, x1, nx)
        iy : _bin_index(op["y0"][i], y0, y1, ny)
        if ix >= 0 and iy >= 0:
            cell : sums[iy][ix]
            cell["sx"] : cell["sx"] + (op["x1"][i] - op["x0"][i])
            cell["sy"] : cell["sy"] + (op["y1"][i] - op["y0"][i])
            cell["n"] : cell["n"] + 1
        i : i + 1
    iy : 0
    while iy < ny:
        ix : 0
        while ix < nx:
            cell : sums[iy][ix]
            if cell["n"] > 0:
                cx : x0 + (ix + 0.5) * (x1 - x0) / nx
                cy : y0 + (iy + 0.5) * (y1 - y0) / ny
                p : _px(cx, cy)
                q : _px(cx + cell["sx"] / cell["n"], cy + cell["sy"] / cell["n"])
                _arrow_px(p["x"], p["y"], q["x"], q["y"], op["color"])
            ix : ix + 1
        iy : iy + 1

def _paint_op(op):
    kind : op["kind"]
    if kind = "heatmap":
        _paint_heatmap(op)
    elif kind = "scatter":
        i : 0
        while i < len(op["x"]):
            p : _px(op["x"][i], op["y"][i])
            gfx.fill_circle(p["x"], p["y"], op["r"], op["color"])
            i : i + 1
    elif kind = "plot":
        i : 0
        while i < len(op["x"]) - 1:
            p : _px(op["x"][i], op["y"][i])
            q : _px(op["x"][i + 1], op["y"][i + 1])
            gfx.line(p["x"], p["y"], q["x"], q["y"], op["color"])
            i : i + 1
    elif kind = "lines":
        i : 0
        while i < len(op["x0"]):
            p : _px(op["x0"][i], op["y0"][i])
            q : _px(op["x1"][i], op["y1"][i])
            gfx.line(p["x"], p["y"], q["x"], q["y"], op["color"])
            i : i + 1
    elif kind = "arrows":
        _paint_arrows(op["x0"], op["y0"], op["x1"], op["y1"], op["color"])
    elif kind = "flow":
        _paint_flow(op)
    elif kind = "text":
        p : _px(op["x"], op["y"])
        tw : gfx.text_width(op["s"], 1)
        gfx.text(p["x"] - tw // 2, p["y"] + op["dy"], op["s"], op["color"], 1)

def draw():
    _layout()
    gfx.clear(0x101410)
    _paint_pitch()
    for op in _pitch["overlays"]:
        _paint_op(op)
    gfx.tick()

def show():
    if getenv("SHAKTI_GFX_SKIP") = "1":
        print("mplsoccer: show skipped (SHAKTI_GFX_SKIP=1)")
        return
    if not gfx.available():
        print("mplsoccer: gfx not available")
        return
    r : gfx.open("mplsoccer")
    if type(r) = "error":
        print("mplsoccer: cannot open window:", r)
        return
    draw()
    while gfx.alive():
        gfx.tick()
    gfx.close()

def close():
    if gfx.available():
        if gfx.alive():
            gfx.close()

def scatter(x, y, color:"", r:3):
    xy : _pair(x, y)
    rr : int(r)
    if rr < 1:
        rr : 1
    _pitch["overlays"].append(dict(kind:"scatter", x:xy["x"], y:xy["y"], color:_color(color, 0xffffff), r:rr))

def plot(x, y, color:""):
    xy : _pair(x, y)
    _pitch["overlays"].append(dict(kind:"plot", x:xy["x"], y:xy["y"], color:_color(color, 0xffffff)))

def lines(x0, y0, x1, y1, color:""):
    q : _quad(x0, y0, x1, y1)
    _pitch["overlays"].append(dict(kind:"lines", x0:q["x0"], y0:q["y0"], x1:q["x1"], y1:q["y1"], color:_color(color, 0xffffff)))

def arrows(x0, y0, x1, y1, color:""):
    q : _quad(x0, y0, x1, y1)
    _pitch["overlays"].append(dict(kind:"arrows", x0:q["x0"], y0:q["y0"], x1:q["x1"], y1:q["y1"], color:_color(color, 0xf2c14e)))

def text(x, y, s, color:"", dy:0):
    _pitch["overlays"].append(dict(kind:"text", x:float(x), y:float(y), s:str(s), color:_color(color, 0xffffff), dy:int(dy)))

def flow(x0, y0, x1, y1, bins:"", color:""):
    _parse_bins(bins)
    q : _quad(x0, y0, x1, y1)
    _pitch["overlays"].append(dict(kind:"flow", x0:q["x0"], y0:q["y0"], x1:q["x1"], y1:q["y1"], bins:bins, color:_color(color, 0xffffff)))

def _blank_grid(nx, ny):
    grid : []
    iy : 0
    while iy < ny:
        row : []
        ix : 0
        while ix < nx:
            row.append(0.0)
            ix : ix + 1
        grid.append(row)
        iy : iy + 1
    return grid

def _bad_num(v):
    if type(v) = "error":
        return 1
    vs : str(v)
    if vs = "nan" or vs = "-nan":
        return 1
    return 0

def _blank_bags(nx, ny):
    grid : []
    iy : 0
    while iy < ny:
        row : []
        ix : 0
        while ix < nx:
            row.append([])
            ix : ix + 1
        grid.append(row)
        iy : iy + 1
    return grid

def bin_statistic(x, y, values:"", statistic:"count", bins:"", normalize:0):
    if statistic != "count" and statistic != "sum" and statistic != "mean" and statistic != "std" and statistic != "median":
        raise "mplsoccer: statistic must be count, sum, mean, std, or median"
    dim : _pitch["dim"]
    xy : _pair(x, y)
    xs : xy["x"]
    ys : xy["y"]
    vs : []
    if statistic != "count":
        if _blank(values):
            raise "mplsoccer: values required for " + statistic
        vs : _as_list(values)
        if len(vs) != len(xs):
            raise "mplsoccer: values length mismatch"
    elif not _blank(values):
        vs : _as_list(values)
        if len(vs) != len(xs):
            raise "mplsoccer: values length mismatch"
    b : _parse_bins(bins)
    nx : b["nx"]
    ny : b["ny"]
    x0 : dim["left"]
    x1 : dim["right"]
    y0 : _y_lo(dim)
    y1 : _y_hi(dim)
    total : _blank_grid(nx, ny)
    counts : _blank_grid(nx, ny)
    sq : []
    bags : []
    if statistic = "std":
        sq : _blank_grid(nx, ny)
    if statistic = "median":
        bags : _blank_bags(nx, ny)
    i : 0
    while i < len(xs):
        ix : _bin_index(float(xs[i]), x0, x1, nx)
        iy : _bin_index(float(ys[i]), y0, y1, ny)
        vv : 0.0
        if statistic != "count":
            vv : float(vs[i])
            if _bad_num(vv):
                ix : -1
        if ix >= 0 and iy >= 0:
            counts[iy][ix] : counts[iy][ix] + 1.0
            if statistic = "count":
                total[iy][ix] : total[iy][ix] + 1.0
            elif statistic = "median":
                bags[iy][ix].append(vv)
            else:
                total[iy][ix] : total[iy][ix] + vv
                if statistic = "std":
                    sq[iy][ix] : sq[iy][ix] + vv * vv
        i : i + 1
    grid : total
    if statistic = "mean" or statistic = "std":
        grid : _blank_grid(nx, ny)
        iy : 0
        while iy < ny:
            ix : 0
            while ix < nx:
                if counts[iy][ix] > 0:
                    mean : total[iy][ix] / counts[iy][ix]
                    if statistic = "mean":
                        grid[iy][ix] : mean
                    else:
                        var : sq[iy][ix] / counts[iy][ix] - mean * mean
                        if var < 0:
                            var : 0.0
                        grid[iy][ix] : sqrt(var)
                ix : ix + 1
            iy : iy + 1
    if statistic = "median":
        grid : _blank_grid(nx, ny)
        iy : 0
        while iy < ny:
            ix : 0
            while ix < nx:
                n : int(counts[iy][ix])
                if n > 0:
                    a : _sort_nums(bags[iy][ix])
                    mid : int(n / 2)
                    if n - mid * 2 = 1:
                        grid[iy][ix] : a[mid]
                    else:
                        grid[iy][ix] : (a[mid - 1] + a[mid]) / 2.0
                ix : ix + 1
            iy : iy + 1
    if _on(normalize):
        tot : 0.0
        for row in grid:
            for v in row:
                tot : tot + v
        if tot != 0:
            iy : 0
            while iy < ny:
                ix : 0
                while ix < nx:
                    grid[iy][ix] : grid[iy][ix] / tot
                    ix : ix + 1
                iy : iy + 1
    x_edge : []
    y_edge : []
    cx : []
    cy : []
    i : 0
    while i <= nx:
        x_edge.append(x0 + (x1 - x0) * i / nx)
        i : i + 1
    i : 0
    while i <= ny:
        y_edge.append(y0 + (y1 - y0) * i / ny)
        i : i + 1
    i : 0
    while i < nx:
        cx.append((x_edge[i] + x_edge[i + 1]) / 2.0)
        i : i + 1
    i : 0
    while i < ny:
        cy.append((y_edge[i] + y_edge[i + 1]) / 2.0)
        i : i + 1
    return dict(statistic:grid, x_edge:x_edge, y_edge:y_edge, cx:cx, cy:cy, nx:nx, ny:ny)

def _fmt_cell(v):
    iv : int(v)
    if abs(v - iv) < 0.0005:
        return str(iv)
    s : v * 10.0
    n : 0
    if s >= 0.0:
        n : int(s + 0.5)
    else:
        n : int(s - 0.5)
    return str(n / 10.0)

def label_heatmap(stats, color:""):
    if type(stats) != "dict" or not ("statistic" in stats):
        raise "mplsoccer: label_heatmap expects bin_statistic"
    if not ("cx" in stats) or not ("cy" in stats):
        raise "mplsoccer: label_heatmap expects bin_statistic"
    grid : stats["statistic"]
    cx : stats["cx"]
    cy : stats["cy"]
    col : color
    if _blank(color):
        col : "black"
    iy : 0
    while iy < len(grid):
        row : grid[iy]
        if len(cx) < len(row) or iy >= len(cy):
            raise "mplsoccer: label_heatmap expects bin_statistic"
        ix : 0
        while ix < len(row):
            text(cx[ix], cy[iy], _fmt_cell(row[ix]), color:col)
            ix : ix + 1
        iy : iy + 1

def heatmap(stats, vmin:"", vmax:""):
    if type(stats) != "dict":
        raise "mplsoccer: heatmap expects bin_statistic"
    if not ("statistic" in stats):
        raise "mplsoccer: heatmap expects bin_statistic"
    _pitch["overlays"].append(dict(kind:"heatmap", stats:stats, vmin:vmin, vmax:vmax))

def calculate_angle_and_distance(x0, y0, x1, y1):
    q : _quad(x0, y0, x1, y1)
    ang : []
    dist : []
    i : 0
    while i < len(q["x0"]):
        dx : float(q["x1"][i]) - float(q["x0"][i])
        dy : float(q["y1"][i]) - float(q["y0"][i])
        ang.append(_atan2(dy, dx))
        dist.append(sqrt(dx * dx + dy * dy))
        i : i + 1
    return dict(angle:ang, distance:dist)

def flip_side(x, y, flip:1):
    xy : _pair(x, y)
    fs : _as_list(flip)
    if len(fs) != 1 and len(fs) != len(xy["x"]):
        raise "mplsoccer: flip length mismatch"
    dim : _pitch["dim"]
    ox : []
    oy : []
    i : 0
    while i < len(xy["x"]):
        f : fs[0]
        if len(fs) != 1:
            f : fs[i]
        if _on(f):
            ox.append(dim["left"] + dim["right"] - float(xy["x"][i]))
            oy.append(dim["top"] + dim["bottom"] - float(xy["y"][i]))
        else:
            ox.append(float(xy["x"][i]))
            oy.append(float(xy["y"][i]))
        i : i + 1
    return dict(x:ox, y:oy)

def _linspace(a, b, n):
    out : []
    i : 0
    last : n - 1
    while i < n:
        out.append(a + (b - a) * i / last)
        i : i + 1
    return out

def _y_slots(a, b, n, odd):
    full : _linspace(a, b, n)
    out : []
    if odd:
        i : 1
        while i < len(full):
            out.append(full[i])
            i : i + 2
        return out
    i : 1
    last : len(full) - 1
    while i < last:
        out.append(full[i])
        i : i + 1
    return out

def _mesh(xs, ys):
    pts : []
    for y in ys:
        for x in xs:
            pts.append(x)
            pts.append(y)
    return pts

def _line_pts(kind):
    dim : _pitch["dim"]
    nx : 6
    odd : 0
    if kind = 5 or kind = 7:
        odd : 1
    if kind = 6 or kind = 7:
        nx : 7
    n : 9
    if odd:
        n : 11
    ys : _y_slots(dim["bottom"], dim["top"], n, odd)
    xs : _linspace(dim["pen_left"], dim["pen_right"], nx)
    return _mesh(xs, ys)

def _form_key(name):
    s : str(name)
    out : ""
    i : 0
    while i < len(s):
        c : s[i]
        if c != "-" and c != "0":
            out : out + c
        i : i + 1
    return out

def _dashed(s):
    out : ""
    i : 0
    while i < len(s):
        if i > 0:
            out : out + "-"
        out : out + s[i]
        i : i + 1
    return out

def _digit_key(s):
    if len(s) = 0:
        return 0
    i : 0
    while i < len(s):
        if not (s[i] in "0123456789"):
            return 0
        i : i + 1
    return 1

def formations():
    out : []
    for k in _FORMS:
        out.append(k)
        if _digit_key(k):
            out.append(_dashed(k))
    return out

def formation(name):
    key : _form_key(name)
    if not (key in _FORMS):
        raise "mplsoccer: unknown formation " + str(name)
    rows : _FORMS[key]
    grids : {}
    ps : []
    xs : []
    ys : []
    for row in rows:
        kind : str(row[1])
        if not (kind in grids):
            grids[kind] : _line_pts(row[1])
        pts : grids[kind]
        at : row[2] * 2
        ps.append(row[0])
        xs.append(pts[at])
        ys.append(pts[at + 1])
    return table(pos:ps, x:xs, y:ys)

def draw_formation(name, color:""):
    t : formation(name)
    scatter(t.x, t.y, color:color, r:4)
    for r in t:
        text(r["x"], r["y"], r["pos"], color:color, dy:-12)

def _xy_of(loc):
    if loc = None:
        return None
    t : type(loc)
    if t != "list" and t != "list[int]" and t != "list[float]":
        return None
    if len(loc) < 2:
        return None
    x : float(loc[0])
    y : float(loc[1])
    if type(x) = "error" or type(y) = "error":
        return None
    return dict(x:x, y:y)

def _int_of(v):
    if v = None:
        return 0
    n : int(v)
    if type(n) = "error":
        return 0
    return n

def _id_of(obj):
    if type(obj) != "dict":
        return 0
    if not ("id" in obj):
        return 0
    return _int_of(obj["id"])

def _outcome_of(ev):
    if "outcome" in ev:
        return _label(ev["outcome"])
    for k in ["pass", "shot", "duel", "goalkeeper", "dribble", "interception", "clearance", "block", "miscontrol", "ball_recovery", "50_50", "bad_behaviour"]:
        if k in ev:
            body : ev[k]
            if type(body) = "dict":
                if "outcome" in body:
                    return _label(body["outcome"])
    return ""

def _label(obj):
    if obj = None:
        return ""
    if type(obj) = "str":
        return obj
    if type(obj) = "dict":
        if "name" in obj:
            if obj["name"] = None:
                return ""
            return str(obj["name"])
    return ""

def _end_of(ev):
    for k in ["pass", "shot", "carry"]:
        if k in ev:
            body : ev[k]
            if type(body) = "dict":
                if "end_location" in body:
                    loc : _xy_of(body["end_location"])
                    if not (loc = None):
                        return loc
    return None

def _events_table(raw):
    if type(raw) = "dict":
        if "events" in raw:
            raw : raw["events"]
        elif "location" in raw:
            one : []
            one.append(raw)
            raw : one
    if type(raw) != "list":
        raise "mplsoccer: expected a list of events"
    xs : []
    ys : []
    ex : []
    ey : []
    minutes : []
    angs : []
    lens : []
    hes : []
    hps : []
    kinds : []
    players : []
    teams : []
    pids : []
    tids : []
    outcomes : []
    periods : []
    for ev in raw:
        if type(ev) != "dict":
            continue
        loc : None
        if "location" in ev:
            loc : _xy_of(ev["location"])
        if loc = None:
            continue
        end : _end_of(ev)
        has_end : 0
        endx : loc["x"]
        endy : loc["y"]
        if not (end = None):
            has_end : 1
            endx : end["x"]
            endy : end["y"]
        ang : 0.0
        ln : 0.0
        hp : 0
        if "pass" in ev:
            body : ev["pass"]
            if type(body) = "dict":
                hp : 1
                if "angle" in body:
                    if not (body["angle"] = None):
                        ang : float(body["angle"])
                if "length" in body:
                    if not (body["length"] = None):
                        ln : float(body["length"])
        minute : 0.0
        if "minute" in ev:
            if not (ev["minute"] = None):
                minute : float(ev["minute"])
        kind : ""
        if "type" in ev:
            kind : _label(ev["type"])
        player : ""
        if "player" in ev:
            player : _label(ev["player"])
        team : ""
        pid : 0
        tid : 0
        if "player" in ev:
            pid : _id_of(ev["player"])
        if "team" in ev:
            team : _label(ev["team"])
            tid : _id_of(ev["team"])
        period : 0
        if "period" in ev:
            period : _int_of(ev["period"])
        xs.append(loc["x"])
        ys.append(loc["y"])
        ex.append(endx)
        ey.append(endy)
        minutes.append(minute)
        angs.append(ang)
        lens.append(ln)
        hes.append(has_end)
        hps.append(hp)
        kinds.append(kind)
        players.append(player)
        teams.append(team)
        pids.append(pid)
        tids.append(tid)
        outcomes.append(_outcome_of(ev))
        periods.append(period)
    return table(x:xs, y:ys, end_x:ex, end_y:ey, minute:minutes, angle:angs, length:lens, has_end:hes, has_pass:hps, type:kinds, player:players, team:teams, player_id:pids, team_id:tids, outcome:outcomes, period:periods)

def sblocal(path):
    raw : json_load(path)
    if type(raw) = "error":
        raise "mplsoccer: " + str(raw)
    return _events_table(raw)

def _digits(v):
    s : str(v)
    if len(s) = 0:
        raise "mplsoccer: match id required"
    i : 0
    while i < len(s):
        if not (s[i] in "0123456789"):
            raise "mplsoccer: match id must be digits"
        i : i + 1
    return s

def sbopen(match_id):
    mid : _digits(match_id)
    url : "https://raw.githubusercontent.com/statsbomb/open-data/master/data/events/" + mid + ".json"
    resp : rest.get(url)
    if type(resp) = "error":
        raise "mplsoccer: " + str(resp)
    if not rest.ok(resp):
        raise "mplsoccer: statsbomb open-data HTTP " + str(rest.status(resp))
    return _events_table(rest.json(resp))

