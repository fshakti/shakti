def clf():
    _pitch["overlays"] : []

def _layout():
    dim : _pitch["dim"]
    x1 : dim["right"]
    if _pitch["half"]:
        x1 : dim["center_length"]
    vx0 : dim["left"] - _pitch["pad_left"]
    vx1 : x1 + _pitch["pad_right"]
    if dim["invert"]:
