def _box_math(x0, y0, x1, y1, color):
    _line_math(x0, y0, x1, y0, color)
    _line_math(x1, y0, x1, y1, color)
    _line_math(x1, y1, x0, y1, color)
    _line_math(x0, y1, x0, y0, color)

def _stroke_arc(cx, cy, rx, ry, deg0, deg1, color):
    span : deg1 - deg0
    if span < 0:
        span : span + 360.0
    n : int(span / 8.0)
