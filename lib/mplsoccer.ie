def _y_lo(dim):
    if dim["top"] < dim["bottom"]:
        return dim["top"]
    return dim["bottom"]

def _y_hi(dim):
    if dim["top"] > dim["bottom"]:
        return dim["top"]
    return dim["bottom"]

def _std_axis(src, dst, coord):
    last : len(src) - 1
    if coord <= src[0]:
        return dst[0]
    if coord >= src[last]:
        return dst[last]
    i : 1
    while i < last and src[i] < coord:
        i : i + 1
    span : src[i] - src[i - 1]
    if span = 0:
        return dst[i]
    prop : (coord - src[i - 1]) / span
    return dst[i - 1] + (dst[i] - dst[i - 1]) * prop

def _one_xy(x, y, src, dst):
    if x < src["left"]:
        x : src["left"]
    if x > src["right"]:
        x : src["right"]
    lo : _y_lo(src)
    hi : _y_hi(src)
    if y < lo:
        y : lo
    if y > hi:
        y : hi
    y_up : y
    if src["invert"]:
        y_up : src["bottom"] - y
    xs : _std_axis(src["x_marks"], dst["x_marks"], x)
    ys : _std_axis(src["y_marks"], dst["y_marks"], y_up)
    if dst["invert"]:
        ys : dst["bottom"] - ys
    return dict(x:xs, y:ys)

def standardize(x, y, pitch_from, pitch_to:"", length_from:"", width_from:"", length_to:"", width_to:""):
