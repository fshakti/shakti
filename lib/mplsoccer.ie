        _lay["vy_bot"] : dim["bottom"] + _pitch["pad_bottom"]
    else:
        _lay["vy_top"] : dim["top"] + _pitch["pad_top"]
        _lay["vy_bot"] : dim["bottom"] - _pitch["pad_bottom"]
    disp_l : vx1 - vx0
    disp_w : _lay["vy_bot"] - _lay["vy_top"]
    if disp_w < 0:
        disp_w : -disp_w
    if disp_l < 0.000001:
        disp_l : 0.000001
    if disp_w < 0.000001:
        disp_w : 0.000001
    aspect : disp_l / (disp_w * dim["aspect"])
