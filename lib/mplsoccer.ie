def vertical_pitch(pitch_type:"statsbomb", half:0, pitch_color:"", line_color:"", stripe:0, stripe_color:"", pad_left:"", pad_right:"", pad_bottom:"", pad_top:"", goal_type:"line", corner_arcs:0, positional:0, positional_color:"", shade_middle:0, shade_color:"", pitch_length:"", pitch_width:""):
