# draughts — title / play / game-over loop (press-drag-release pieces)
# Requires Shakti built with SHAKTI_GFX=1.
#
#   import draughts
#   draughts.run()

import gfx
import input
import draughts_core
import draughts_ai
import draughts_render

SCR_TITLE : 0

KEY_ESC : 65307

def poll_esc():
    for ev in input(0):
        if ev["kind"] = "key":
            if ev["code"] = KEY_ESC:
                return 1
    return 0

def run_play(mode):
    st : draughts_core.new_state(mode)
    draughts_core.update_status(st)
    prev_down : gfx.mouse_down()
    while gfx.alive() = 1:
        gfx.tick()
        gfx.sync_keys()
        if poll_esc() = 1:
            return
        if st["ai_pending"] = 1:
            draughts_core.clear_selection(st)
            draughts_render.draw_play(gfx, st)
            wait(16)
            draughts_ai.play_ai_move(st, 0)
            if st["ai_cancel"] = 1:
                return
            while gfx.click_pending() = 1:
                gfx.consume_click()
            prev_down : gfx.mouse_down()
            if gfx.alive() = 0:
                return
            draughts_render.draw_play(gfx, st)
            wait(16)
            continue
        down : gfx.mouse_down()
        mx : gfx.mouse_x()
        my : gfx.mouse_y()
        if st["drag"] = 1:
            draughts_core.update_drag(st, mx, my)
        if down = 1 and prev_down = 0:
            gfx.consume_click()
            if st["status"] = draughts_core.STATUS_DONE:
                rr : draughts_render.rematch_rect()
                if draughts_render.in_rect(mx, my, rr["x"], rr["y"], rr["w"], rr["h"]) = 1:
                    st : draughts_core.new_state(mode)
                    draughts_core.update_status(st)
            else:
                cell : draughts_render.px_to_cell(mx, my)
                if cell["r"] >= 0:
                    p : st["board"][cell["r"], cell["c"]]
                    if draughts_core.piece_color(p) = st["turn"]:
                        draughts_core.begin_drag(st, cell["r"], cell["c"], mx, my)
                    elif st["selected_r"] >= 0:
                        draughts_core.click_cell(st, cell["r"], cell["c"])
        if down = 0 and prev_down = 1:
            if st["drag"] = 1:
                cell : draughts_render.px_to_cell(mx, my)
                draughts_core.end_drag(st, cell["r"], cell["c"])
        prev_down : down
        draughts_render.draw_play(gfx, st)
        wait(16)

def run():
    if gfx.available() = 0:
        print("draughts: gfx not available (build with SHAKTI_GFX=1)")
        return 1
    gfx.open("Draughts")
    while gfx.alive() = 1:
        gfx.tick()
        gfx.sync_keys()
        if poll_esc() = 1:
            break
        if gfx.click_pending() = 1:
            cx : gfx.click_x()
            cy : gfx.click_y()
            gfx.consume_click()
            hit : draughts_render.hit_title(cx, cy)
            if hit = -1:
                break
            if hit = draughts_core.MODE_AI or hit = draughts_core.MODE_HUMAN:
                run_play(hit)
                if gfx.alive() = 0:
                    break
        draughts_render.draw_title(gfx)
        wait(16)
    gfx.close()
    return 0
