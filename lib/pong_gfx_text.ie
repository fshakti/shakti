def row_S(r):
    if r = 0:
        return "01111"
    if r = 1:
        return "10000"
    if r = 2:
        return "10000"
    if r = 3:
        return "01110"
    if r = 4:
        return "00001"
    if r = 5:
        return "00001"
    if r = 6:
        return "11110"
    return "00000"

def glyph_row(ch, row):
    if ch = " ":
        return "00000"
    if ch = "P":
        return row_P(row)
    if ch = "O":
        return row_O(row)
    if ch = "N":
        return row_N(row)
    if ch = "G":
        return row_G(row)
    if ch = "M":
        return row_M(row)
    if ch = "D":
        return row_D(row)
    if ch = "E":
        return row_E(row)
    if ch = "1":
        return row_1(row)
    if ch = "2":
        return row_2(row)
    if ch = "3":
        return row_3(row)
    if ch = "L":
        return row_L(row)
    if ch = "A":
        return row_A(row)
    if ch = "Y":
        return row_Y(row)
    if ch = "R":
        return row_R(row)
    if ch = "C":
        return row_C(row)
    if ch = "U":
        return row_U(row)
    if ch = "T":
        return row_T(row)
    if ch = "V":
        return row_V(row)
    if ch = "I":
        return row_I(row)
    if ch = "W":
        return row_W(row)
    if ch = "H":
        return row_H(row)
    if ch = "S":
        return row_S(row)
    return "00000"

def draw_char(gfx, x, y, ch, color, scale):
    row : 0
    while row < 7:
        bits : glyph_row(ch, row)
        col : 0
        while col < 5:
            if bits[col] = "1":
                start : col
                while col < 5 and bits[col] = "1":
                    col : col + 1
                gfx.fill_rect(x + start * scale, y + row * scale, (col - start) * scale, scale, color)
            else:
                col : col + 1
        row : row + 1

def text_w(s, scale):
    return len(s) * 6 * scale

def draw_text(gfx, x, y, s, color, scale):
    i : 0
    adv : 6 * scale
    while i < len(s):
        draw_char(gfx, x + i * adv, y, s[i], color, scale)
        i : i + 1

def draw_text_c(gfx, cx, y, s, color, scale):
    w : text_w(s, scale)
    draw_text(gfx, cx + (-(w // 2)), y, s, color, scale)

