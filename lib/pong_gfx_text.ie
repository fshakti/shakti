# 5x7 bitmap text — glyphs matched to Shakti synth font.
# P is customized (open bowl) so it cannot be read as F.

def row_P(r):
    if r = 0:
        return "11110"
    if r = 1:
        return "10001"
    if r = 2:
        return "10001"
    if r = 3:
        return "11110"
    if r = 4:
        return "10000"
    if r = 5:
        return "10000"
    return "10000"

def row_O(r):
    if r = 0:
        return "01110"
    if r = 6:
        return "01110"
    return "10001"

