# Shared CLI wrapper for the source-to-Shakti converters.

def run(argvv, script_name, input_ext, transpile_fn):
    usage : "usage: " + script_name + " input." + input_ext + " [-o out.ie]"
    if len(argvv) < 2:
        raise usage
    inp : None
    out : None
    i : 1
    while i < len(argvv):
        if argvv[i] = "-o" or argvv[i] = "--output":
            if i + 1 >= len(argvv):
                raise "missing output path"
            out : argvv[i + 1]
            i += 2
        elif argvv[i][0] = "-":
            raise "unknown option: " + argvv[i]
        elif inp = None:
            inp : argvv[i]
            i += 1
        else:
            raise "unexpected argument: " + argvv[i]
    if inp = None:
        raise usage
    result : transpile_fn(read(inp), inp)
    if out = None:
        write("/dev/stdout", result)
    else:
        write(out, result)
