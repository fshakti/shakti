# draughts_render — board, pieces, click hit-tests
# Layout fits the default gfx framebuffer 960x540.
# Squares and pieces are drawn with gfx.fill_rect / fill_circle.

import draughts_core
import gfx

CELL : 56
ORIGIN_X : 28
ORIGIN_Y : 28

LIGHT : 0xe7d3a1
LIGHT_GRAIN : 0xd4bc88
LIGHT_EDGE : 0xc4a574
DARK : 0x8b5a2b
DARK_GRAIN : 0x6e4520
DARK_EDGE : 0x4a2e16
SEL : 0xf6f669
LEGAL : 0xf2d16b
BG : 0x1a1a1a
HUD : 0xf0e6d8
ACCENT : 0xe8c547
BTN : 0x2a2a3a
BTN_HI : 0x3d5a80
DIM : 0x8888aa
MAN_LIGHT : 0xf4ead2
MAN_LIGHT_RIM : 0xb7a48a
MAN_LIGHT_HI : 0xfffaf3
MAN_DARK : 0x3b2416
MAN_DARK_RIM : 0x1a100c
MAN_DARK_HI : 0x6a4632
CROWN : 0xe8c547
CROWN_HI : 0xffe08a

def in_rect(x, y, rx, ry, rw, rh):
    if x < rx:
        return 0
    if y < ry:
        return 0
    if x >= rx + rw:
        return 0
    if y >= ry + rh:
        return 0
    return 1

def cell_px(c):
    return ORIGIN_X + c * CELL

def cell_py(r):
    return ORIGIN_Y + r * CELL

def px_to_cell(x, y):
    if x < ORIGIN_X or y < ORIGIN_Y:
        return dict(r: -1, c: -1)
    if x >= ORIGIN_X + 8 * CELL or y >= ORIGIN_Y + 8 * CELL:
        return dict(r: -1, c: -1)
    c : int((x - ORIGIN_X) / CELL)
    r : int((y - ORIGIN_Y) / CELL)
    return dict(r: r, c: c)

def is_legal_sq(legals, r, c):
    i : 0
    while i < len(legals):
        mv : legals[i]
        if mv["tr"] = r and mv["tc"] = c:
            return 1
        i : i + 1
    return 0

def draw_disc(g, cx, cy, piece):
    rim : MAN_DARK_RIM
    body : MAN_DARK
    hi : MAN_DARK_HI
    if piece > 0:
        rim : MAN_LIGHT_RIM
        body : MAN_LIGHT
        hi : MAN_LIGHT_HI
    g.fill_circle(cx, cy, 20, rim)
    g.fill_circle(cx, cy, 16, body)
    g.fill_circle(cx - 5, cy - 6, 6, hi)
    if draughts_core.piece_type(piece) = draughts_core.KING:
        g.fill_circle(cx, cy, 11, CROWN)
        g.fill_circle(cx, cy, 7, body)
        g.fill_rect(cx - 14, cy - 14, 28, 5, CROWN)
        g.fill_rect(cx - 14, cy - 14, 28, 2, CROWN_HI)
        g.fill_circle(cx - 12, cy - 18, 4, CROWN)
        g.fill_circle(cx, cy - 22, 4, CROWN_HI)
        g.fill_circle(cx + 12, cy - 18, 4, CROWN)

def draw_piece(g, x, y, piece):
    draw_disc(g, x + CELL / 2, y + CELL / 2, piece)

def draw_piece_at(g, cx, cy, piece):
    x : cx - CELL / 2
    y : cy - CELL / 2
    draw_piece(g, x, y, piece)

def draw_square(g, x, y, dark):
    base : LIGHT
    grain : LIGHT_GRAIN
    edge : LIGHT_EDGE
    if dark = 1:
        base : DARK
        grain : DARK_GRAIN
        edge : DARK_EDGE
    g.fill_rect(x, y, CELL, CELL, base)
    nudge : (x / 7) % 4
    g.fill_rect(x, y + 8 + nudge, CELL, 2, grain)
    g.fill_rect(x, y + 24 + nudge, CELL, 2, grain)
    g.fill_rect(x, y + 40, CELL, 2, grain)
    g.fill_rect(x, y, CELL, 2, edge)
    g.fill_rect(x, y + CELL - 2, CELL, 2, edge)
    g.fill_rect(x, y, 2, CELL, edge)
    g.fill_rect(x + CELL - 2, y, 2, CELL, edge)

def draw_board(g, st):
    board : st["board"]
    r : 0
    while r < 8:
        c : 0
        while c < 8:
            dark : 0
            if (r + c) % 2 = 1:
                dark : 1
            x : cell_px(c)
            y : cell_py(r)
            draw_square(g, x, y, dark)
            if st["selected_r"] = r and st["selected_c"] = c:
                g.fill_rect(x, y, CELL, 4, SEL)
                g.fill_rect(x, y + CELL + (-4), CELL, 4, SEL)
                g.fill_rect(x, y, 4, CELL, SEL)
                g.fill_rect(x + CELL + (-4), y, 4, CELL, SEL)
            if is_legal_sq(st["legal"], r, c) = 1:
                g.fill_circle(x + CELL / 2, y + CELL / 2, 8, LEGAL)
            if on_path_capture(st, r, c) = 1:
                g.fill_circle(x + CELL / 2, y + CELL / 2, 10, 0xe74c3c)
            p : board[r, c]
            if st["drag"] = 1 and st["selected_r"] = r and st["selected_c"] = c:
                p : 0
            if p != 0:
                draw_piece(g, x, y, p)
            c : c + 1
        r : r + 1
    if st["drag"] = 1 and st["drag_piece"] != 0:
        draw_piece_at(g, st["drag_x"], st["drag_y"], st["drag_piece"])

def on_path_capture(st, r, c):
    if len(st["paths"]) < 2:
        return 0
    mv : st["paths"][st["path_i"]]
    steps : mv["steps"]
    i : 0
    while i < len(steps):
        step : steps[i]
        if step["cr"] = r and step["cc"] = c:
            return 1
        i : i + 1
    return 0

def status_text(st):
    if len(st["paths"]) > 1:
        return "Path " + str(st["path_i"] + 1) + "/" + str(len(st["paths"])) + " — click piece"
    if st["status"] = draughts_core.STATUS_DONE:
        if st["winner"] = 1:
            return "Light wins"
        return "Dark wins"
    if st["ai_pending"] = 1:
        return "Dark thinking..."
    if st["turn"] = 1:
        return "Light to move"
    return "Dark to move"

def draw_hud(g, st):
    hx : ORIGIN_X + 8 * CELL + 24
    g.text(hx, 40, "DRAUGHTS", ACCENT, 2)
    g.text(hx, 80, status_text(st), HUD, 2)
    mode : "Human vs AI"
    if st["mode"] = draughts_core.MODE_HUMAN:
        mode : "Two Player"
    g.text(hx, 120, mode, DIM, 2)
    g.text(hx, 160, "Esc = menu", DIM, 1)
    if st["status"] = draughts_core.STATUS_DONE:
        g.fill_rect(hx, 200, 200, 44, BTN_HI)
        g.text(hx + 24, 212, "REMATCH", HUD, 2)

def rematch_rect():
    return dict(x: ORIGIN_X + 8 * CELL + 24, y: 200, w: 200, h: 44)

def draw_play(g, st):
    g.clear(BG)
    draw_board(g, st)
    draw_hud(g, st)

def title_buttons():
    return [
        dict(x: 280, y: 200, w: 400, h: 56, label: "Human vs AI", mode: draughts_core.MODE_AI),
        dict(x: 280, y: 280, w: 400, h: 56, label: "Two Player", mode: draughts_core.MODE_HUMAN),
        dict(x: 280, y: 360, w: 400, h: 56, label: "Quit", mode: -1)
    ]

def draw_title(g):
    g.clear(BG)
    g.text(310, 80, "DRAUGHTS", ACCENT, 4)
    g.text(250, 140, "English draughts  ·  jumps required", DIM, 2)
    draw_piece(g, 300, 430, draughts_core.MAN)
    draw_piece(g, 380, 430, 0 - draughts_core.MAN)
    draw_piece(g, 460, 430, draughts_core.KING)
    draw_piece(g, 540, 430, 0 - draughts_core.KING)
    btns : title_buttons()
    i : 0
    while i < len(btns):
        b : btns[i]
        g.fill_rect(b["x"], b["y"], b["w"], b["h"], BTN)
        g.fill_rect(b["x"], b["y"], b["w"], 4, ACCENT)
        g.text(b["x"] + 100, b["y"] + 14, b["label"], HUD, 3)
        i : i + 1

def hit_title(x, y):
    btns : title_buttons()
    i : 0
    while i < len(btns):
        b : btns[i]
        if in_rect(x, y, b["x"], b["y"], b["w"], b["h"]) = 1:
            return b["mode"]
        i : i + 1
    return -2
