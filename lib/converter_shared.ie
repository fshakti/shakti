# Shared low-level converter helpers used by p2s / c2s / cs2s / j2s.

def tok(kind, text, val, line, col):
    return {"kind":kind, "text":text, "val":val, "line":line, "col":col}

def node(t, x):
    return {"t":t, "line":x["line"], "col":x["col"]}

def starts(s, p):
    if len(s) < len(p):
        return False
    return s[0:len(p)] = p

def is_alpha(c):
    return ("a" <= c and c <= "z") or ("A" <= c and c <= "Z") or c = "_"

def is_digit(c):
    return "0" <= c and c <= "9"

def is_alnum(c):
    return is_alpha(c) or is_digit(c)

def num_clean(t):
    out : ""
    i : 0
    while i < len(t):
        c : t[i]
        if c != "_":
            out += c
        i += 1
    return out

def quote_string(s):
    out : ""
    i : 0
    while i < len(s):
        c : s[i]
        if c = "\\":
            out += "\\\\"
        elif c = "\"":
            out += "\\\""
        elif c = "\n":
            out += "\\n"
        elif c = "\t":
            out += "\\t"
        else:
            out += c
        i += 1
    return "\"" + out + "\""

def peek(p):
    return p["tokens"][p["pos"]]

def peekn(p, k):
    j : p["pos"] + k
    if j >= len(p["tokens"]):
        j : len(p["tokens"]) - 1
    return p["tokens"][j]

def take(p):
    x : peek(p)
    p["pos"] += 1
    return x

def at(p, text):
    return peek(p)["text"] = text

def kind(p, k):
    return peek(p)["kind"] = k

def fail(p, msg, x):
    raise p["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": " + msg

def need(p, text):
    x : peek(p)
    if x["text"] != text:
        fail(p, "expected '" + text + "'", x)
    return take(p)

def need_kind(p, k):
    x : peek(p)
    if x["kind"] != k:
        fail(p, "expected " + k, x)
    return take(p)

def pad(n):
    return "    " * n

def join_text(xs, sep):
    out : ""
    i : 0
    while i < len(xs):
        if i > 0:
            out += sep
        out += xs[i]
        i += 1
    return out
