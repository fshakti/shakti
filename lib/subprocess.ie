# Lightweight subprocess shim that uses sh(). The full PTY-based Popen was removed
# because it did not parse cleanly under the current grammar.

class Popen:
	def __init__(*args, executable:None, stdin:None, stdout:None, shell:False, cwd:None, env:None):
		parts : []
		for a in args:
			if type(a) = "list":
				for x in a:
					parts.append(x)
			else:
				parts.append(a)
		cmd : ""
		if shell and len(parts) = 1:
			cmd : str(parts[0])
		else:
			for p in parts:
				if cmd = "":
					cmd : str(p)
				else:
					cmd : cmd + " " + str(p)
		if cwd:
			cmd : "cd " + str(cwd) + " && " + cmd
		self.cmd : cmd
		self.stdout : stdout
		self.stderr : None
		self.stdin : stdin
		self.returncode : sh(cmd)
	def wait(self, timeout:None):
		return self.returncode
	def communicate(self, input:None, timeout:None):
		return [None, None]
	def poll(self):
		return self.returncode

def run(command, shell:False, check:False):
	return sh(command)
