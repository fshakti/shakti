# graph — in-memory knowledge graph (subject–predicate–object triples)
#
#   import graph
#   graph.create()
#   graph.add("Ada", "knows", "Bob")
#   graph.query("Ada", "knows", "*")

_g : 0

def create():
    _g : graph_create()
    return _g

def use(g):
    _g : g

def add(s, p, o):
    return graph_add(_g, s, p, o)

def query(s:"*", p:"*", o:"*"):
    return graph_query(_g, s, p, o)

def neighbors(node, direction:"out"):
    return graph_neighbors(_g, node, direction)

def path(from_node, to_node, max_depth:8):
    return graph_path(_g, from_node, to_node, max_depth)

def from_table(t, subj_col, pred, obj_col):
    return graph_from_table(_g, t, subj_col, pred, obj_col)

def to_table(s:"*", p:"*", o:"*"):
    return graph_to_table(_g, s, p, o)

def count():
    return graph_count(_g)

def clear():
    return graph_clear(_g)

def add_many(triples):
    n : 0
    for t in triples:
        r : graph_add(_g, t[0], t[1], t[2])
        if type(r) = "error":
            return r
        n : n + 1
    return n

def related(node, max_depth:2):
    seen : [node]
    frontier : [node]
    depth : 0
    while depth < max_depth and len(frontier) > 0:
        nxt : []
        for cur in frontier:
            out_t : neighbors(cur, "out")
            if type(out_t) = "error":
                return out_t
            for nb in out_t["object"]:
                if not (nb in seen):
                    append(seen, nb)
                    append(nxt, nb)
            in_t : neighbors(cur, "in")
            if type(in_t) = "error":
                return in_t
            for nb in in_t["subject"]:
                if not (nb in seen):
                    append(seen, nb)
                    append(nxt, nb)
        frontier : nxt
        depth : depth + 1
    return seen
