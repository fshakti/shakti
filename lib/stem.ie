# stem — streaming 4-stem separator (drums / bass / vocals / other)
# Requires shakti built with SHAKTI_STEM=1 (default).
#
# Classical (streaming):
#   import stem
#   stem.open(44100, 256)
#   out : stem.process(block)   # dict of fvecs
#   stem.set_gains(1, 1, 0, 1)  # mute vocals
#   mix : stem.mix(out)
#
# Offline ML (SHAKST01 spectrogram MLP, CPU-only):
#   stem.write_ml_synth("ckpt.stemw", 32)
#   stem.load_ml("ckpt.stemw")
#   out : stem.separate_file_ml("mix.wav")
#
# WAV I/O is the edge only (engine stays f32). Read: PCM16 / PCM24 / PCM32 integer /
# IEEE float32. Write: pcm16 (default) / pcm24 / f32.
#   stem.si_sdr(est, ref)           # scale-invariant SDR (dB)
#   stem.write_wav("x.wav", samples, 44100, "f32")
#   r : stem.read_wav("x.wav")      # {"samples","sr","n"}
#   stem.separate_file("mix.wav", "out", wavfmt="pcm24")

def open(sr:44100, block:256):
    return stem_open(sr, block)

def close():
    return stem_close()

def alive():
    return stem_alive()

def process(samples):
    return stem_process(samples)

def set_gains(drums, bass, vocals, other):
    return stem_set_gains(drums, bass, vocals, other)

def gains():
    return stem_gains()

def latency_ms():
    return stem_latency_ms()

def mix(stems):
    return stem_mix(stems)

def separate_file(path, outdir:"", wavfmt:""):
    if wavfmt:
        return stem_separate_file(path, outdir, wavfmt)
    if outdir:
        return stem_separate_file(path, outdir)
    return stem_separate_file(path)

def info():
    return stem_info()

def load_ml(path):
    return stem_load_ml(path)

def unload_ml():
    return stem_unload_ml()

def ml_info():
    return stem_ml_info()

def write_ml_synth(path, nhidden:64):
    return stem_write_ml_synth(path, nhidden)

def ml_spike(batch:64, iters:20):
    return stem_ml_spike(batch, iters)

def si_sdr(est, ref):
    return stem_si_sdr(est, ref)

def write_wav(path, samples, sr:44100, fmt:"pcm16"):
    return stem_write_wav(path, samples, sr, fmt)

def read_wav(path):
    return stem_read_wav(path)

def separate_file_ml(path, outdir:"", wavfmt:""):
    if wavfmt:
        return stem_separate_file_ml(path, outdir, wavfmt)
    if outdir:
        return stem_separate_file_ml(path, outdir)
    return stem_separate_file_ml(path)
