# p2s — strict Python 3 subset to Shakti (not CPython).
#
# Supported (summary):
#   assignment (= → :); chained a = b = e via temp; == → =; chained compare → and;
#   def with defaults/kwargs; annotations erased; nested def; @decorator;
#   0–1 arg lambda (no comps in body); if/elif/else, while, for x in; for a, b in → iter temp;
#   list/dict comps (one for, optional if) → append / subscript bind;
#   lists/tuples/dicts; index/slice; arith // % **; @ → mmul; and/or/not; in;
#   bitwise → band/bor/bxor/shl/shr/bnot; += -= *= /=; //= **= %= @= bit-aug
#   rewritten to binds; ternary; assert; # comments; one-line f-strings without specs;
#   import name; numpy/pandas mapped calls; class with no bases (body flattened).
#
# Unsupported (hard reject):
#   tabs; line joining; inheritance; nested/set/genexp comps; comps in lambda; sets/bytes/complex;
#   is; *args/**kwargs; multi-arg lambdas; loop-else; from-import;
#   try/with/yield/async; match; del/global/nonlocal; walrus.

import converter_shared
import transpile_cli

python_reserved : ["def", "return", "if", "elif", "else", "while", "for", "in",
                   "break", "continue", "and", "or", "not", "import", "try", "except",
                   "finally", "as", "lambda", "pass", "class", "global", "del", "raise",
                   "with", "yield", "True", "False", "None"]
shakti_reserved : ["select", "update", "delete", "by", "from", "where",
                   "create", "insert", "into", "values", "join", "on",
                   "union", "outer"]
bit_binop_names : {"&":"band", "|":"bor", "^":"bxor", "<<":"shl", ">>":"shr"}
bit_aug_ops : {"&=":"band", "|=":"bor", "^=":"bxor", "<<=":"shl", ">>=":"shr"}
arith_aug_ops : ["+=", "-=", "*=", "/="]
rewrite_aug_ops : ["//=", "**=", "%=", "@=", "&=", "|=", "^=", "<<=", ">>="]

def tok(kind, text, val, line, col):
    return converter_shared.tok(kind, text, val, line, col)

def node(t, x):
    return converter_shared.node(t, x)

def starts(s, p):
    return converter_shared.starts(s, p)

def is_alpha(c):
    return converter_shared.is_alpha(c)

def is_digit(c):
    return converter_shared.is_digit(c)

def is_alnum(c):
    return converter_shared.is_alnum(c)

def trim_left(s):
    i : 0
    while i < len(s) and (s[i] = " " or s[i] = "\t"):
        i += 1
    return s[i:]

def quote_string(s):
    return converter_shared.quote_string(s)

def lex_string(line, i, ln):
    start : i
    prefix : ""
    if (line[i] = "f" or line[i] = "F") and i + 1 < len(line) and (line[i + 1] = "\"" or line[i + 1] = "'"):
        prefix : line[i]
        i += 1
    q : line[i]
    triple : False
    if i + 2 < len(line) and line[i:i + 3] = q + q + q:
        triple : True
        i += 3
    else:
        i += 1
    val : ""
    while i < len(line):
        if triple and i + 2 < len(line) and line[i:i + 3] = q + q + q:
            i += 3
            return [tok("STRING", line[start:i], {"s":val, "f":prefix != "", "triple":True}, ln, start + 1), i]
        if not triple and line[i] = q:
            i += 1
            return [tok("STRING", line[start:i], {"s":val, "f":prefix != "", "triple":False}, ln, start + 1), i]
        if line[i] = "\\":
            if i + 1 >= len(line):
                raise str(ln) + ":" + str(i + 1) + ": unterminated string"
            e : line[i + 1]
            if e = "n":
                val += "\n"
            elif e = "t":
                val += "\t"
            elif e = "r":
                val += "\r"
            else:
                val += e
            i += 2
        else:
            val += line[i]
            i += 1
    raise str(ln) + ":" + str(start + 1) + ": unterminated string"

def lex(source):
    lines : re_split("\n", source)
    ts : []
    comments : {"0":""}
    inline : {"0":""}
    # Keep this heterogeneous: native integer vectors are immutable.
    indents : [None, 0]
    ln : 1
    for line in lines:
        nsp : 0
        while nsp < len(line) and line[nsp] = " ":
            nsp += 1
        if nsp < len(line) and line[nsp] = "\t":
            raise str(ln) + ":" + str(nsp + 1) + ": tabs are unsupported"
        rest : line[nsp:]
        if len(rest) = 0:
            ln += 1
            continue
        if rest[0] = "#":
            comments[str(ln)] : rest
            ln += 1
            continue
        if nsp > indents[len(indents) + -1]:
            indents.append(nsp)
            ts.append(tok("INDENT", "", None, ln, 1))
        elif nsp < indents[len(indents) + -1]:
            while nsp < indents[len(indents) + -1]:
                indents.pop()
                ts.append(tok("DEDENT", "", None, ln, 1))
            if nsp != indents[len(indents) + -1]:
                raise str(ln) + ":1: inconsistent indentation"
        i : nsp
        while i < len(line):
            c : line[i]
            if c = " " or c = "\t":
                i += 1
                continue
            if c = "#":
                inline[str(ln)] : line[i:]
                break
            if is_alpha(c):
                if (c = "f" or c = "F") and i + 1 < len(line) and (line[i + 1] = "\"" or line[i + 1] = "'"):
                    z : lex_string(line, i, ln)
                    ts.append(z[0])
                    i : z[1]
                    continue
                j : i + 1
                while j < len(line) and is_alnum(line[j]):
                    j += 1
                text : line[i:j]
                ts.append(tok("NAME", text, text, ln, i + 1))
                i : j
                continue
            if is_digit(c) or (c = "." and i + 1 < len(line) and is_digit(line[i + 1])):
                j : i + 1
                while j < len(line) and (is_alnum(line[j]) or line[j] = "." or line[j] = "_"):
                    j += 1
                if j > i and (line[j + -1] = "e" or line[j + -1] = "E") and j < len(line) and (line[j] = "+" or line[j] = "-"):
                    if j + 1 < len(line) and is_digit(line[j + 1]):
                        j += 1
                        while j < len(line) and (is_digit(line[j]) or line[j] = "_"):
                            j += 1
                text : line[i:j]
                ts.append(tok("NUMBER", text, text, ln, i + 1))
                i : j
                continue
            if c = "\"" or c = "'":
                z : lex_string(line, i, ln)
                ts.append(z[0])
                i : z[1]
                continue
            op : c
            if i + 2 < len(line) and (line[i:i + 3] = "**=" or line[i:i + 3] = "//=" or line[i:i + 3] = "<<=" or line[i:i + 3] = ">>=" or line[i:i + 3] = "..."):
                op : line[i:i + 3]
            elif i + 1 < len(line) and line[i:i + 2] in ["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "//", "**", "<<", ">>", ":=", "->", "@=", "&=", "|=", "^="]:
                op : line[i:i + 2]
            ts.append(tok("OP", op, op, ln, i + 1))
            i += len(op)
        ts.append(tok("NEWLINE", "", None, ln, len(line) + 1))
        ln += 1
    while len(indents) > 2:
        indents.pop()
        ts.append(tok("DEDENT", "", None, ln, 1))
    ts.append(tok("ENDMARKER", "", None, ln, 1))
    return {"tokens":ts, "comments":comments, "inline":inline}

def peek(p):
    return converter_shared.peek(p)
def peekn(p, n):
    return converter_shared.peekn(p, n)
def take(p):
    return converter_shared.take(p)
def at(p, text):
    return converter_shared.at(p, text)
def kind(p, k):
    return converter_shared.kind(p, k)
def fail(p, msg, x):
    converter_shared.fail(p, msg, x)
def need(p, text):
    return converter_shared.need(p, text)
def need_kind(p, k):
    return converter_shared.need_kind(p, k)
def ident(p, x):
    if x["text"] in python_reserved:
        fail(p, "identifier '" + x["text"] + "' is reserved in Shakti", x)
    # Mangle Shakti keywords. Also mangle any name that already starts with
    # the mangling prefix so user identifiers like __p2s_values cannot collide
    # with a mangled reserved word (values -> __p2s_values).
    name : x["text"]
    if name in shakti_reserved or starts(name, "__p2s_"):
        name : "__p2s_" + name
    x["text"] : name
    return name

def parse(source, filename):
    lx : lex(source)
    p : {"tokens":lx["tokens"], "pos":0, "filename":filename, "aliases":{"":""}, "comments":lx["comments"], "inline":lx["inline"]}
    body : []
    while not kind(p, "ENDMARKER"):
        if kind(p, "NEWLINE"):
            take(p)
        else:
            body.append(parse_stmt(p))
    return {"t":"Module", "body":body, "comments":p["comments"], "inline":p["inline"], "aliases":p["aliases"], "filename":filename}

def parse_stmt(p):
    decorators : []
    while at(p, "@"):
        take(p)
        decorators.append(parse_expr(p))
        need_kind(p, "NEWLINE")
    if len(decorators) > 0:
        if not at(p, "def"):
            fail(p, "decorators require a function", peek(p))
        x : parse_compound(p)
        x["decorators"] : decorators
        return x
    if at(p, "if") or at(p, "while") or at(p, "for") or at(p, "def") or at(p, "class") or at(p, "async") or at(p, "with") or at(p, "try"):
        return parse_compound(p)
    return parse_simple(p)

def parse_suite(p):
    need(p, ":")
    need_kind(p, "NEWLINE")
    need_kind(p, "INDENT")
    xs : []
    while not kind(p, "DEDENT") and not kind(p, "ENDMARKER"):
        if kind(p, "NEWLINE"):
            take(p)
        else:
            xs.append(parse_stmt(p))
    need_kind(p, "DEDENT")
    if len(xs) = 0:
        fail(p, "empty block", peek(p))
    return xs

def parse_class(p):
    x : take(p)
    name : need_kind(p, "NAME")
    ident(p, name)
    if at(p, "("):
        take(p)
        if not at(p, ")"):
            fail(p, "inheritance is unsupported", peek(p))
        need(p, ")")
    body : parse_suite(p)
    z : node("ClassShell", x)
    z["name"] : name["text"]
    z["body"] : body
    return z

def parse_compound(p):
    x : peek(p)
    if at(p, "class"):
        return parse_class(p)
    if at(p, "async"):
        fail(p, "async functions are unsupported", x)
    if at(p, "with"):
        fail(p, "With is unsupported", x)
    if at(p, "try"):
        fail(p, "Try is unsupported", x)
    if at(p, "def"):
        take(p)
        name : need_kind(p, "NAME")
        ident(p, name)
        need(p, "(")
        args : []
        defaults : []
        if not at(p, ")"):
            while True:
                if at(p, "*"):
                    fail(p, "variadic or keyword-only parameters are unsupported", peek(p))
                a : need_kind(p, "NAME")
                ident(p, a)
                if at(p, ":"):
                    take(p)
                    parse_expr(p)
                args.append(a["text"])
                if at(p, "="):
                    take(p)
                    defaults.append(parse_expr(p))
                else:
                    defaults.append(None)
                if not at(p, ","):
                    break
                take(p)
                if at(p, ")"):
                    break
        need(p, ")")
        if at(p, "->"):
            take(p)
            parse_expr(p)
        z : node("FunctionDef", x)
        z["name"] : name["text"]
        z["args"] : args
        z["defaults"] : defaults
        z["decorators"] : []
        z["body"] : parse_suite(p)
        return z
    if at(p, "if"):
        take(p)
        z : node("If", x)
        z["test"] : parse_expr(p)
        z["body"] : parse_suite(p)
        z["elifs"] : []
        z["orelse"] : []
        while at(p, "elif"):
            e : take(p)
            q : {"test":parse_expr(p), "body":parse_suite(p), "line":e["line"], "col":e["col"]}
            z["elifs"].append(q)
        if at(p, "else"):
            take(p)
            z["orelse"] : parse_suite(p)
        return z
    if at(p, "while"):
        take(p)
        z : node("While", x)
        z["test"] : parse_expr(p)
        z["body"] : parse_suite(p)
        if at(p, "else"):
            fail(p, "while-else is unsupported", peek(p))
        return z
    if at(p, "for"):
        take(p)
        z : node("For", x)
        target : parse_target(p)
        if target["t"] = "Tuple" or target["t"] = "List":
            if len(target["elts"]) = 0:
                fail(p, "empty unpacking is unsupported", target)
            for e in target["elts"]:
                if e["t"] != "Name":
                    fail(p, "nested unpacking is unsupported", e)
        need(p, "in")
        z["target"] : target
        z["iter"] : parse_expr(p)
        z["body"] : parse_suite(p)
        if at(p, "else"):
            fail(p, "for-else is unsupported", peek(p))
        return z
    fail(p, "unsupported compound statement", x)

def end_simple(p):
    need_kind(p, "NEWLINE")

def parse_simple(p):
    x : peek(p)
    if at(p, "return"):
        take(p)
        z : node("Return", x)
        z["value"] : None
        if not kind(p, "NEWLINE"):
            z["value"] : parse_expr(p)
        end_simple(p)
        return z
    if at(p, "break") or at(p, "continue") or at(p, "pass"):
        take(p)
        z : node(x["text"], x)
        end_simple(p)
        return z
    if at(p, "from"):
        fail(p, "from-import is unsupported", x)
    if at(p, "raise"):
        fail(p, "Raise is unsupported", x)
    if at(p, "yield"):
        fail(p, "Yield is unsupported", x)
    if at(p, "global") or at(p, "nonlocal") or at(p, "del"):
        fail(p, x["text"] + " is unsupported", x)
    if at(p, "import"):
        take(p)
        name : need_kind(p, "NAME")
        alias : None
        if at(p, "as"):
            take(p)
            alias : need_kind(p, "NAME")["text"]
        if at(p, ","):
            fail(p, "multiple imports in one statement are unsupported", x)
        end_simple(p)
        z : node("Import", x)
        z["name"] : name["text"]
        z["alias"] : alias
        if name["text"] = "numpy" or name["text"] = "pandas":
            bound : name["text"]
            if alias != None:
                bound : alias
            p["aliases"][bound] : name["text"]
            z["erase"] : True
        else:
            if alias != None:
                fail(p, "import aliases are unsupported", x)
            z["erase"] : False
        return z
    if at(p, "assert"):
        take(p)
        z : node("Assert", x)
        z["test"] : parse_expr(p)
        if at(p, ","):
            fail(p, "assert message is unsupported", x)
        end_simple(p)
        return z
    left : parse_expr_list(p)
    if at(p, ":"):
        take(p)
        parse_expr(p)
        if not at(p, "="):
            fail(p, "annotated assignment requires a value", peek(p))
    if at(p, "="):
        take(p)
        targets : [left]
        validate_target(p, left)
        while True:
            nxt : parse_expr_list(p)
            if at(p, "="):
                take(p)
                validate_target(p, nxt)
                targets.append(nxt)
            else:
                z : node("Assign", x)
                z["target"] : targets[0]
                z["targets"] : targets
                z["value"] : nxt
                end_simple(p)
                return z
    if peek(p)["text"] in arith_aug_ops or peek(p)["text"] in rewrite_aug_ops:
        op : take(p)
        z : node("AugAssign", x)
        z["target"] : left
        validate_target(p, left)
        z["op"] : op["text"]
        z["value"] : parse_expr(p)
        end_simple(p)
        return z
    z : node("Expr", x)
    z["value"] : left
    end_simple(p)
    return z

def validate_target(p, x):
    if x["t"] = "Name" or x["t"] = "Attr" or x["t"] = "Subscript":
        return
    if x["t"] = "Tuple" or x["t"] = "List":
        if len(x["elts"]) = 0:
            fail(p, "empty unpacking is unsupported", x)
        for e in x["elts"]:
            if e["t"] != "Name":
                fail(p, "nested unpacking is unsupported", e)
        return
    fail(p, "unsupported assignment target", x)

def parse_target(p):
    first : parse_postfix(p)
    if not at(p, ","):
        return first
    z : node("Tuple", first)
    z["elts"] : [first]
    while at(p, ","):
        take(p)
        z["elts"].append(parse_postfix(p))
    return z

def parse_expr_list(p):
    first : parse_expr(p)
    if not at(p, ","):
        return first
    z : node("Tuple", first)
    z["elts"] : [first]
    while at(p, ","):
        take(p)
        if at(p, ")") or at(p, "]") or kind(p, "NEWLINE"):
            break
        z["elts"].append(parse_expr(p))
    return z

def parse_expr(p):
    if at(p, "lambda"):
        return parse_lambda(p)
    return parse_ifexp(p)

def parse_lambda(p):
    x : take(p)
    args : []
    if not at(p, ":"):
        while True:
            if at(p, "*"):
                fail(p, "variadic or keyword-only lambda parameters are unsupported", peek(p))
            a : need_kind(p, "NAME")
            args.append(ident(p, a))
            if not at(p, ","):
                break
            take(p)
    if len(args) > 1:
        fail(p, "multi-argument lambdas are unsupported", x)
    need(p, ":")
    z : node("Lambda", x)
    z["args"] : args
    z["body"] : parse_expr(p)
    return z

def parse_ifexp(p):
    z : parse_or(p)
    if at(p, "if"):
        x : take(p)
        q : node("IfExp", x)
        q["body"] : z
        q["test"] : parse_or(p)
        need(p, "else")
        q["orelse"] : parse_expr(p)
        return q
    if at(p, ":="):
        fail(p, "walrus operator is unsupported", peek(p))
    return z

def parse_or(p):
    xs : [parse_and(p)]
    x : xs[0]
    while at(p, "or"):
        take(p)
        xs.append(parse_and(p))
    if len(xs) = 1:
        return x
    z : node("BoolOp", x)
    z["op"] : "or"
    z["values"] : xs
    return z

def parse_and(p):
    xs : [parse_not(p)]
    x : xs[0]
    while at(p, "and"):
        take(p)
        xs.append(parse_not(p))
    if len(xs) = 1:
        return x
    z : node("BoolOp", x)
    z["op"] : "and"
    z["values"] : xs
    return z

def parse_not(p):
    if at(p, "not") and peekn(p, 1)["text"] != "in":
        x : take(p)
        z : node("Unary", x)
        z["op"] : "not"
        z["value"] : parse_not(p)
        return z
    return parse_compare(p)

def parse_compare(p):
    left : parse_bitor(p)
    ops : []
    vals : []
    while peek(p)["text"] in ["==", "!=", "<", "<=", ">", ">=", "in", "is"] or (at(p, "not") and peekn(p, 1)["text"] = "in"):
        x : take(p)
        op : x["text"]
        if op = "not":
            take(p)
            op : "not in"
        elif op = "is":
            if at(p, "not"):
                take(p)
            fail(p, "comparison Is is unsupported", x)
        ops.append(op)
        vals.append(parse_bitor(p))
    if len(ops) = 0:
        return left
    if len(ops) = 1:
        z : node("Compare", left)
        z["left"] : left
        z["op"] : ops[0]
        z["right"] : vals[0]
        return z
    cmps : []
    prev : left
    i : 0
    while i < len(ops):
        c : node("Compare", prev)
        c["left"] : prev
        c["op"] : ops[i]
        c["right"] : vals[i]
        cmps.append(c)
        prev : vals[i]
        i += 1
    z : node("BoolOp", left)
    z["op"] : "and"
    z["values"] : cmps
    return z

def parse_bitor(p):
    return binary(p, parse_bitxor, ["|"])

def parse_bitxor(p):
    return binary(p, parse_bitand, ["^"])

def parse_bitand(p):
    return binary(p, parse_shift, ["&"])

def parse_shift(p):
    return binary(p, parse_arith, ["<<", ">>"])

def binary(p, sub, ops):
    z : sub(p)
    while peek(p)["text"] in ops:
        x : take(p)
        q : node("BinOp", x)
        q["left"] : z
        q["op"] : x["text"]
        q["right"] : sub(p)
        z : q
    return z

def parse_arith(p):
    return binary(p, parse_term, ["+", "-"])

def parse_term(p):
    return binary(p, parse_factor, ["*", "/", "//", "%", "@"])

def parse_factor(p):
    if peek(p)["text"] in ["+", "-", "~"]:
        x : take(p)
        if x["text"] = "+":
            return parse_factor(p)
        if x["text"] = "~":
            z : node("Unary", x)
            z["op"] : "~"
            z["value"] : parse_factor(p)
            return z
        z : node("Unary", x)
        z["op"] : "-"
        z["value"] : parse_factor(p)
        return z
    return parse_power(p)

def parse_power(p):
    z : parse_postfix(p)
    if at(p, "**"):
        x : take(p)
        q : node("BinOp", x)
        q["left"] : z
        q["op"] : "**"
        q["right"] : parse_factor(p)
        return q
    return z

def parse_postfix(p):
    z : parse_atom(p)
    while True:
        if at(p, "."):
            x : take(p)
            a : need_kind(p, "NAME")
            q : node("Attr", x)
            q["value"] : z
            q["attr"] : a["text"]
            z : q
        elif at(p, "("):
            x : take(p)
            q : node("Call", x)
            q["func"] : z
            q["args"] : []
            q["kwargs"] : []
            if not at(p, ")"):
                while True:
                    if at(p, "**"):
                        fail(p, "**kwargs is unsupported", peek(p))
                    if at(p, "*"):
                        fail(p, "*args is unsupported", peek(p))
                    if kind(p, "NAME") and peekn(p, 1)["text"] = "=":
                        k : take(p)
                        ident(p, k)
                        take(p)
                        q["kwargs"].append([k, parse_expr(p)])
                    else:
                        q["args"].append(parse_expr(p))
                    if not at(p, ","):
                        break
                    take(p)
                    if at(p, ")"):
                        break
            need(p, ")")
            z : q
        elif at(p, "["):
            x : take(p)
            q : node("Subscript", x)
            q["value"] : z
            q["slice"] : parse_slice_list(p)
            need(p, "]")
            z : q
        else:
            break
    return z

def parse_slice_list(p):
    xs : [parse_slice(p)]
    while at(p, ","):
        take(p)
        xs.append(parse_slice(p))
    if len(xs) = 1:
        return xs[0]
    z : node("SliceTuple", xs[0])
    z["elts"] : xs
    return z

def parse_slice(p):
    x : peek(p)
    lower : None
    if not at(p, ":"):
        lower : parse_expr(p)
    if not at(p, ":"):
        return lower
    take(p)
    upper : None
    step : None
    if not at(p, ":") and not at(p, "]") and not at(p, ","):
        upper : parse_expr(p)
    if at(p, ":"):
        take(p)
        if not at(p, "]") and not at(p, ","):
            step : parse_expr(p)
    z : node("Slice", x)
    z["lower"] : lower
    z["upper"] : upper
    z["step"] : step
    return z

def parse_atom(p):
    x : peek(p)
    if kind(p, "NUMBER"):
        take(p)
        if "j" in x["text"] or "J" in x["text"]:
            fail(p, "complex literals are unsupported", x)
        z : node("Const", x)
        z["value"] : x["text"]
        z["kind"] : "number"
        return z
    if kind(p, "STRING"):
        take(p)
        if x["val"]["f"]:
            depth : 0
            j : 0
            while j < len(x["val"]["s"]):
                c : x["val"]["s"][j]
                if c = "{":
                    if j + 1 < len(x["val"]["s"]) and x["val"]["s"][j + 1] = "{":
                        j += 2
                        continue
                    depth += 1
                elif c = "}":
                    depth += -1
                elif depth > 0 and (c = "!" or c = ":"):
                    fail(p, "f-string conversions/format specs are unsupported", x)
                j += 1
        z : node("FString" if x["val"]["f"] else "Const", x)
        z["value"] : x["val"]["s"]
        z["kind"] : "string"
        return z
    if kind(p, "NAME"):
        take(p)
        if (x["text"] = "b" or x["text"] = "B") and kind(p, "STRING"):
            fail(p, "bytes literals are unsupported", x)
        if x["text"] = "await":
            fail(p, "Await is unsupported", x)
        if x["text"] = "yield":
            fail(p, "Yield is unsupported", x)
        z : node("Const" if x["text"] in ["True", "False", "None"] else "Name", x)
        z["value"] : x["text"] if z["t"] = "Const" else ident(p, x)
        if z["t"] = "Name":
            x["text"] : z["value"]
        return z
    if at(p, "("):
        take(p)
        if at(p, ")"):
            take(p)
            z : node("Tuple", x)
            z["elts"] : []
            return z
        z : parse_expr_list(p)
        if at(p, "for"):
            fail(p, "comprehensions are unsupported", peek(p))
        need(p, ")")
        return z
    if at(p, "["):
        take(p)
        z : node("List", x)
        z["elts"] : []
        if not at(p, "]"):
            e : parse_expr(p)
            if at(p, "for"):
                return parse_comp_tail(p, x, "ListComp", e, None)
            z["elts"].append(e)
            while at(p, ","):
                take(p)
                if at(p, "]"):
                    break
                e : parse_expr(p)
                if at(p, "for"):
                    fail(p, "comprehensions are unsupported", x)
                z["elts"].append(e)
        need(p, "]")
        return z
    if at(p, "{"):
        take(p)
        z : node("Dict", x)
        z["keys"] : []
        z["values"] : []
        if not at(p, "}"):
            if at(p, "**"):
                fail(p, "dict unpacking is unsupported", peek(p))
            k : parse_expr(p)
            if at(p, "for"):
                fail(p, "set comprehensions are unsupported", x)
            if not at(p, ":"):
                fail(p, "set literals are unsupported", x)
            need(p, ":")
            v : parse_expr(p)
            if at(p, "for"):
                return parse_comp_tail(p, x, "DictComp", k, v)
            z["keys"].append(k)
            z["values"].append(v)
            while at(p, ","):
                take(p)
                if at(p, "}"):
                    break
                if at(p, "**"):
                    fail(p, "dict unpacking is unsupported", peek(p))
                k : parse_expr(p)
                if at(p, "for"):
                    fail(p, "comprehensions are unsupported", x)
                if not at(p, ":"):
                    fail(p, "set literals are unsupported", x)
                need(p, ":")
                z["keys"].append(k)
                z["values"].append(parse_expr(p))
        need(p, "}")
        return z
    fail(p, "unsupported expression", x)

def parse_comp_tail(p, x, kind, elt, val):
    take(p)
    target : parse_target(p)
    if target["t"] = "Tuple" or target["t"] = "List":
        if len(target["elts"]) = 0:
            fail(p, "empty unpacking is unsupported", target)
        for e in target["elts"]:
            if e["t"] != "Name":
                fail(p, "nested unpacking is unsupported", e)
    need(p, "in")
    it : parse_or(p)
    if at(p, "for"):
        fail(p, "nested comprehensions are unsupported", peek(p))
    filt : None
    if at(p, "if"):
        take(p)
        filt : parse_expr(p)
        if at(p, "for"):
            fail(p, "nested comprehensions are unsupported", peek(p))
    if kind = "ListComp":
        need(p, "]")
    else:
        need(p, "}")
    z : node(kind, x)
    z["elt"] : elt
    z["value"] : val
    z["target"] : target
    z["iter"] : it
    z["filt"] : filt
    return z

def pad(n):
    return converter_shared.pad(n)

def contains_comp(x):
    if x = None:
        return False
    tx : type(x)
    if tx = "list":
        for e in x:
            if contains_comp(e):
                return True
        return False
    if tx != "dict":
        return False
    if "t" in x:
        if x["t"] = "ListComp" or x["t"] = "DictComp":
            return True
    for k in x.keys():
        if contains_comp(x[k]):
            return True
    return False

def comp_fail(st, x, msg):
    raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": " + msg

def gensym(st, prefix):
    if not "tmpn" in st:
        st["tmpn"] : 0
    st["tmpn"] += 1
    return "__p2s_" + prefix + str(st["tmpn"])

def push_pre(st, line):
    if not "pre" in st:
        st["pre"] : []
    st["pre"].append(line)

def flush_pre(st, ind):
    out : []
    if not "pre" in st:
        return out
    for line in st["pre"]:
        out.append(pad(ind) + line)
    st["pre"] : []
    return out

def emit_comp(st, x, is_list):
    nested : contains_comp(x["elt"]) or contains_comp(x["iter"])
    if x["filt"] != None and contains_comp(x["filt"]):
        nested : True
    if x["value"] != None and contains_comp(x["value"]):
        nested : True
    if nested:
        comp_fail(st, x, "nested comprehensions are unsupported")
    tmp : gensym(st, "c")
    if is_list:
        push_pre(st, tmp + " : []")
    else:
        push_pre(st, tmp + " : {}")
    it : expr_text(x["iter"], st)
    tgt : x["target"]
    body : "    "
    if tgt["t"] = "Tuple" or tgt["t"] = "List":
        itv : gensym(st, "it")
        push_pre(st, "for " + itv + " in " + it + ":")
        push_pre(st, "    " + target_text(tgt, st) + " : " + itv)
        body : "    "
    else:
        push_pre(st, "for " + target_text(tgt, st) + " in " + it + ":")
    if x["filt"] != None:
        push_pre(st, body + "if " + expr_text(x["filt"], st) + ":")
        body += "    "
    if is_list:
        push_pre(st, body + tmp + ".append(" + expr_text(x["elt"], st) + ")")
    else:
        push_pre(st, body + tmp + "[" + expr_text(x["elt"], st) + "] : " + expr_text(x["value"], st))
    return tmp

def render(ast, state):
    state["comments"] : ast["comments"]
    state["inline"] : ast["inline"]
    state["last_comment"] : 0
    state["filename"] : ast["filename"]
    if not "pre" in state:
        state["pre"] : []
    if not "tmpn" in state:
        state["tmpn"] : 0
    lines : render_body(ast["body"], state, 0, True)
    for k in state["comments"].keys():
        kn : int(k)
        if kn > state["last_comment"]:
            lines.append(state["comments"][k])
    text : ""
    for line in lines:
        if line != "":
            text += line + "\n"
    return text

def before_comments(st, line, indent):
    out : []
    for k in st["comments"].keys():
        kn : int(k)
        if kn > st["last_comment"] and kn < line:
            out.append(pad(indent) + st["comments"][k])
            st["last_comment"] : kn
    return out

def render_body(body, st, indent, doc_ok):
    out : []
    i : 0
    while i < len(body):
        s : body[i]
        cs : before_comments(st, s["line"], indent)
        for c in cs:
            out.append(c)
        if doc_ok and i = 0 and s["t"] = "Expr" and s["value"]["t"] = "Const" and s["value"]["kind"] = "string":
            parts : re_split("\n", s["value"]["value"])
            for q in parts:
                out.append(pad(indent) + ("# " + q if len(q) > 0 else "#"))
        else:
            rs : render_stmt(s, st, indent)
            key : str(s["line"])
            if key in st["inline"] and len(rs) > 0:
                last : len(rs) + -1
                rs[last] : rs[last] + "  " + st["inline"][key]
            for q in rs:
                if q != "":
                    out.append(q)
        i += 1
    return out

def render_stmt(s, st, ind):
    p : pad(ind)
    t : s["t"]
    if t = "Assign":
        val : expr_text(s["value"], st)
        out : flush_pre(st, ind)
        ts : s["targets"] if "targets" in s else [s["target"]]
        if len(ts) = 1:
            out.append(p + target_text(ts[0], st) + " : " + val)
            return out
        tmp : gensym(st, "t")
        out.append(p + tmp + " : " + val)
        i : len(ts) + -1
        while i >= 0:
            out.append(p + target_text(ts[i], st) + " : " + tmp)
            i += -1
        return out
    if t = "AugAssign":
        tgt : target_text(s["target"], st)
        val : expr_text(s["value"], st)
        out : flush_pre(st, ind)
        if s["op"] in arith_aug_ops:
            out.append(p + tgt + " " + s["op"] + " " + val)
            return out
        if s["op"] = "@=":
            rhs : "mmul(" + tgt + ", " + val + ")"
        elif s["op"] in bit_aug_ops:
            rhs : bit_aug_ops[s["op"]] + "(" + tgt + ", " + val + ")"
        else:
            binop : s["op"][0:len(s["op"]) + -1]
            rhs : "(" + tgt + " " + binop + " " + val + ")"
        out.append(p + tgt + " : " + rhs)
        return out
    if t = "Return":
        if s["value"] = None:
            return [p + "return"]
        val : expr_text(s["value"], st)
        out : flush_pre(st, ind)
        out.append(p + "return " + val)
        return out
    if t = "pass" or t = "break" or t = "continue":
        return [p + t]
    if t = "ClassShell":
        out : []
        for c in s["body"]:
            for q in render_stmt(c, st, ind):
                out.append(q)
        if len(out) = 0:
            return [p + "pass"]
        return out
    if t = "Import":
        return ["" if s["erase"] else p + "import " + s["name"]]
    if t = "Assert":
        val : expr_text(s["test"], st)
        out : flush_pre(st, ind)
        out.append(p + "assert(" + val + ")")
        return out
    if t = "Expr":
        val : expr_text(s["value"], st)
        out : flush_pre(st, ind)
        out.append(p + val)
        return out
    if t = "FunctionDef":
        out : []
        deco_txt : []
        for d in s["decorators"]:
            deco_txt.append(expr_text(d, st))
        parts : []
        i : 0
        while i < len(s["args"]):
            q : s["args"][i]
            if s["defaults"][i] != None:
                q += ":" + expr_text(s["defaults"][i], st)
            parts.append(q)
            i += 1
        pre : flush_pre(st, ind)
        for q in pre:
            out.append(q)
        for d in deco_txt:
            out.append(p + "@" + d)
        out.append(p + "def " + s["name"] + "(" + join_text(parts, ", ") + "):")
        for q in render_body(s["body"], st, ind + 1, True):
            out.append(q)
        return out
    if t = "If":
        test : expr_text(s["test"], st)
        out : flush_pre(st, ind)
        out.append(p + "if " + test + ":")
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        for e in s["elifs"]:
            et : expr_text(e["test"], st)
            for q in flush_pre(st, ind):
                out.append(q)
            out.append(p + "elif " + et + ":")
            for q in render_body(e["body"], st, ind + 1, False):
                out.append(q)
        if len(s["orelse"]) > 0:
            out.append(p + "else:")
            for q in render_body(s["orelse"], st, ind + 1, False):
                out.append(q)
        return out
    if t = "While":
        test : expr_text(s["test"], st)
        out : flush_pre(st, ind)
        out.append(p + "while " + test + ":")
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        return out
    if t = "For":
        it : expr_text(s["iter"], st)
        out : flush_pre(st, ind)
        tgt : s["target"]
        if tgt["t"] = "Tuple" or tgt["t"] = "List":
            tmp : gensym(st, "it")
            out.append(p + "for " + tmp + " in " + it + ":")
            out.append(pad(ind + 1) + target_text(tgt, st) + " : " + tmp)
            for q in render_body(s["body"], st, ind + 1, False):
                out.append(q)
            return out
        out.append(p + "for " + target_text(tgt, st) + " in " + it + ":")
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        return out
    return []

def join_text(xs, sep):
    return converter_shared.join_text(xs, sep)
def target_text(x, st):
    if x["t"] = "Tuple" or x["t"] = "List":
        parts : []
        for e in x["elts"]:
            parts.append(target_text(e, st))
        return join_text(parts, ", ")
    return expr_text(x, st)

def slice_text(x, st):
    if x["t"] = "Slice":
        a : "" if x["lower"] = None else expr_text(x["lower"], st)
        b : "" if x["upper"] = None else expr_text(x["upper"], st)
        q : a + ":" + b
        if x["step"] != None:
            q += ":" + expr_text(x["step"], st)
        return q
    if x["t"] = "SliceTuple":
        parts : []
        for e in x["elts"]:
            parts.append(slice_text(e, st))
        return join_text(parts, ", ")
    return expr_text(x, st)

def expr_text(x, st):
    t : x["t"]
    if t = "Name":
        return x["value"]
    if t = "Const":
        if "kind" in x and x["kind"] = "string":
            return quote_string(x["value"])
        if "kind" in x and x["kind"] = "number":
            return converter_shared.num_clean(x["value"])
        return x["value"]
    if t = "FString":
        return "f" + quote_string(x["value"])
    if t = "List":
        parts : []
        for e in x["elts"]:
            parts.append(expr_text(e, st))
        return "[" + join_text(parts, ", ") + "]"
    if t = "Tuple":
        parts : []
        for e in x["elts"]:
            parts.append(expr_text(e, st))
        if len(parts) = 1:
            return "(" + parts[0] + ",)"
        return "(" + join_text(parts, ", ") + ")"
    if t = "Dict":
        parts : []
        i : 0
        while i < len(x["keys"]):
            parts.append(expr_text(x["keys"][i], st) + ": " + expr_text(x["values"][i], st))
            i += 1
        return "{" + join_text(parts, ", ") + "}"
    if t = "Attr":
        if x["value"]["t"] = "Name" and x["value"]["value"] in st["aliases"]:
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": " + st["aliases"][x["value"]["value"]] + "." + x["attr"] + " is unsupported outside a mapped call"
        return expr_text(x["value"], st) + "." + x["attr"]
    if t = "Subscript":
        return expr_text(x["value"], st) + "[" + slice_text(x["slice"], st) + "]"
    if t = "Unary":
        if x["op"] = "not":
            return "(not " + expr_text(x["value"], st) + ")"
        if x["op"] = "~":
            return "bnot(" + expr_text(x["value"], st) + ")"
        return "(-" + expr_text(x["value"], st) + ")"
    if t = "BinOp":
        if x["op"] = "@":
            return "mmul(" + expr_text(x["left"], st) + ", " + expr_text(x["right"], st) + ")"
        if x["op"] in bit_binop_names:
            return bit_binop_names[x["op"]] + "(" + expr_text(x["left"], st) + ", " + expr_text(x["right"], st) + ")"
        return "(" + expr_text(x["left"], st) + " " + x["op"] + " " + expr_text(x["right"], st) + ")"
    if t = "BoolOp":
        parts : []
        for e in x["values"]:
            parts.append(expr_text(e, st))
        return "(" + join_text(parts, " " + x["op"] + " ") + ")"
    if t = "Compare":
        op : "=" if x["op"] = "==" else x["op"]
        return "(" + expr_text(x["left"], st) + " " + op + " " + expr_text(x["right"], st) + ")"
    if t = "IfExp":
        return expr_text(x["body"], st) + " if " + expr_text(x["test"], st) + " else " + expr_text(x["orelse"], st)
    if t = "Lambda":
        if contains_comp(x["body"]):
            comp_fail(st, x, "comprehensions in lambda are unsupported")
        return "(lambda " + join_text(x["args"], ", ") + ": " + expr_text(x["body"], st) + ")"
    if t = "Call":
        lowered : lower_call(x, st)
        if lowered != None:
            return lowered
        parts : []
        for e in x["args"]:
            parts.append(expr_text(e, st))
        for kv in x["kwargs"]:
            parts.append(kv[0]["text"] + ":" + expr_text(kv[1], st))
        return expr_text(x["func"], st) + "(" + join_text(parts, ", ") + ")"
    if t = "ListComp":
        return emit_comp(st, x, True)
    if t = "DictComp":
        return emit_comp(st, x, False)
    return ""

def lower_call(x, st):
    f : x["func"]
    if f["t"] != "Attr" or f["value"]["t"] != "Name":
        return None
    alias : f["value"]["value"]
    if not alias in st["aliases"]:
        return None
    mod : st["aliases"][alias]
    name : f["attr"]
    if mod = "numpy":
        if name = "array" or name = "asarray":
            if len(x["args"]) != 1 or len(x["kwargs"]) != 0:
                raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": numpy." + name + " requires one argument without dtype/options"
            return expr_text(x["args"][0], st)
        maps : {"sum":"sum", "mean":"avg", "min":"min", "max":"max", "dot":"dot",
                "matmul":"mmul", "abs":"abs", "sqrt":"sqrt", "exp":"exp", "log":"log",
                "sin":"sin", "cos":"cos", "tan":"tan"}
        if not name in maps:
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": numpy." + name + " is unsupported"
        if len(x["kwargs"]) > 0:
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": numpy." + name + " options are unsupported"
        parts : []
        for e in x["args"]:
            parts.append(expr_text(e, st))
        return maps[name] + "(" + join_text(parts, ", ") + ")"
    if mod = "pandas":
        if name = "Series":
            if len(x["args"]) != 1 or len(x["kwargs"]) != 0:
                raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": pandas.Series requires one argument"
            return expr_text(x["args"][0], st)
        if name != "DataFrame":
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": pandas." + name + " is unsupported"
        if len(x["args"]) != 1 or len(x["kwargs"]) != 0 or x["args"][0]["t"] != "Dict":
            raise st["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": pandas.DataFrame requires one dictionary argument"
        d : x["args"][0]
        parts : []
        i : 0
        while i < len(d["keys"]):
            k : d["keys"][i]
            if k["t"] != "Const" or k["kind"] != "string" or not re_match("^[A-Za-z_][A-Za-z0-9_]*$", k["value"]):
                raise st["filename"] + ":" + str(k["line"]) + ":" + str(k["col"]) + ": DataFrame column names must be valid string identifiers"
            parts.append(k["value"] + ":" + expr_text(d["values"][i], st))
            i += 1
        return "table(" + join_text(parts, ", ") + ")"
    return None

def transpile(source, filename):
    ast : parse(source, filename)
    return render(ast, {"aliases":ast["aliases"], "pre":[], "tmpn":0})

def main():
    return transpile_cli.run(argv, "p2s.ie", "py", transpile)

# Run CLI only when this file is the entry script.
if re_match("p2s\\.ie$", argv[0]):
    main()
