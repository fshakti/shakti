# =============================================================================
# table_csv.ie
# =============================================================================
# CSV/TSV table save/load. String columns save as text; load is numeric-only.
# Normal-sized files use a buffered read; oversized files stream when
# SHAKTI_CSV_MAX_BYTES is exceeded (default 1 GiB).
#   ./shakti example.ie   # or copy this section to its own file

people : table(id:[1, 2, 3], name:["ada", "bob", "cam"])
r : save(people, "/tmp/shakti_people.csv")
print("save returned:", r)
print("csv bytes:", read("/tmp/shakti_people.csv"))

# Missing fields pad as 0
write("/tmp/shakti_short.csv", "id,val\n1,\n")
short : load("/tmp/shakti_short.csv")
print("short-row load:")
print(short)

# Reload of a string CSV is numeric
reloaded : load("/tmp/shakti_people.csv")
print("reloaded (numeric columns only):")
print(reloaded)

# TSV round-trip (same table API; tab delimiter)
save(people, "/tmp/shakti_people.tsv")
print("tsv bytes:", read("/tmp/shakti_people.tsv"))
tsv_reloaded : load("/tmp/shakti_people.tsv")
print("tsv reloaded (numeric columns only):")
print(tsv_reloaded)

# TSV empty leading / trailing fields pad as 0
write("/tmp/shakti_edge.tsv", "a\tb\tc\n\t2\t3\n1\t2\t\n")
edge : load("/tmp/shakti_edge.tsv")
print("tsv empty-edge load:")
print(edge)

write("/tmp/shakti_short.tsv", "id\tval\n1\t\n")
tsv_short : load("/tmp/shakti_short.tsv")
print("tsv short-row load:")
print(tsv_short)

