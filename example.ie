print("sum(u * v):", sum(u * v))

# =============================================================================
# sql_demo.ie
# =============================================================================
# In-memory table SQL — requires `import sql` before statement syntax.
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti sql_demo.ie

import sql

sales : table(
    id:[1, 2, 3, 4],
    dept:["sales", "eng", "sales", "eng"],
    amount:[10, 25, 30, 40]
)

print("rows:", shape(sales)[0])

by_dept : select amount by dept from sales where amount > 15
print("sum amount by dept (amount > 15):")
print(by_dept)

totals : select sum amount by dept from sales
print("sum amount by dept (all rows):")
print(totals)

create table roster (id: 0, name: "")
insert into roster (id, name) values (1, "ada")
insert into roster (id, name) values (2, "bob")
update name : "ADA" from roster where id = 1
print("roster after update:")
print(roster)

delete from roster where id = 2
print("roster after delete:")
print(roster)

# =============================================================================
# graph_demo.ie
# =============================================================================
# Knowledge graph demo — subject/predicate/object triples.
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti graph_demo.ie

import graph

graph.create()

graph.add("Ada", "knows", "Bob")
graph.add("Bob", "knows", "Carol")
graph.add("Carol", "knows", "Dave")
graph.add("Ada", "worksAt", "Acme")
graph.add("Bob", "worksAt", "Acme")

print("triples:", graph.count())

print("\nwho Ada knows:")
print(graph.query("Ada", "knows", "*"))

print("\noutgoing from Bob:")
print(graph.neighbors("Bob", "out"))

print("\npath Ada -> Dave:")
path : graph.path("Ada", "Dave", 6)
print(path)

people : table(
    name: ["Eve", "Frank"],
    friend: ["Frank", "Grace"]
)
graph.from_table(people, "name", "knows", "friend")
print("\nafter table load, count:", graph.count())
print(graph.query("*", "knows", "Grace"))

