# =============================================================================
# ipc_echo.ie
# =============================================================================
# Local IPC echo server — Unix domain socket on localhost (default port 19090).
# Run in one terminal:  ./shakti ipc_echo.ie
# Run in another:       ./shakti ipc_echo_client.ie

import ipc

port : 19090
srv : ipc.listen(port)
print("ipc echo listening on port", port, "(uds on localhost)")

conn : ipc.accept(srv)
msg : ipc.recv(conn)
print("recv:", msg)
ipc.send(conn, msg)
ipc.close(conn)
ipc.close(srv)
print("done")

# =============================================================================
# ipc_echo_client.ie
# =============================================================================
# Client for ipc_echo.ie — connects via UDS (localhost default).
import ipc

port : 19090
c : ipc.connect("127.0.0.1", port)
ipc.send(c, "hello from client")
msg : ipc.recv(c)
print("reply:", msg)
ipc.close(c)

# =============================================================================
# ipc_rdma.ie
# =============================================================================
# RDMA/RoCE IPC example — requires RDMA-capable NIC and rdma-core dev libraries.
# Server:  ./shakti ipc_rdma.ie
# Client:  ./shakti ipc_rdma_client.ie  (set host/port to match)

import ipc

if ipc.rdma_available() = 0:
    print("no RDMA device — install rdma-core and configure RoCE NIC")
else:
    port : 19100
    srv : ipc.listen(port, "0.0.0.0", "rdma")
    print("rdma server on port", port)
    conn : ipc.accept(srv)
    msg : ipc.recv(conn)
    print("recv:", msg)
    ipc.send(conn, "rdma-ok")
    ipc.close(conn)
    ipc.close(srv)

# =============================================================================
# ipc_rdma_client.ie
# =============================================================================
# RDMA client for ipc_rdma.ie — set host to server address.
import ipc

host : "127.0.0.1"
port : 19100

if ipc.rdma_available() = 0:
    print("no RDMA device")
else:
    c : ipc.connect(host, port, "rdma")
    ipc.send(c, "ping")
    print("reply:", ipc.recv(c))
    ipc.close(c)

