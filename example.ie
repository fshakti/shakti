# Merged Shakti examples — sections below are not meant to run as one script.
# Copy a section or run a single demo from doc.md instructions.
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti example.ie

# =============================================================================
# decorators.ie
# =============================================================================
# `@d` decorates a def, class, or name assignment:
#
#     @d
#     def f(...): ...        is sugar for     def f(...): ...
#                                             f : d(f)
#
# Stacked decorators apply nearest-first, so @a @b def f  ->  f : a(b(f)).

# --- 1. a simple wrapping decorator ---------------------------------------
def trace(f):
    def wrapper(x):
        print("  call ->", x)
        r : f(x)
        print("  ret  <-", r)
        return r
    return wrapper

@trace
def square(n):
    return n * n

print("decorated square(5):", square(5))

# --- 2. stacked decorators (applied nearest-first) ------------------------
def bang(f):
    def w(s):
        return f(s) + "!"
    return w

def shout(f):
    def w(s):
        return f(s) + "?"
    return w

@bang
@shout
def say(s):
    return s

# bang(shout(say)): say("hi") -> "hi" -> +"?" -> +"!"
print("stacked say('hi'):", say("hi"))

# --- 3. decorator factory (a decorator that takes arguments) --------------
def repeat(times):
    def deco(f):
        def w(s):
            out : ""
            for i in range(times):
                out : out + f(s)
            return out
        return w
    return deco

@repeat(3)
def emit(s):
    return s

print("repeat(3) emit('ab'):", emit("ab"))

# --- 4. decorating a lambda / name assignment -----------------------------
# The right-hand side is wrapped directly: dbl : compose(lambda x: x + x).
def compose(f):
    def w(x):
        return f(f(x))
    return w

@compose
dbl : lambda x: x + x

print("compose dbl(3):", dbl(3))   # ((3+3)+(3+3)) = 12

# --- 5. decorating a class through a dotted lookup ------------------------
def identity(value):
    return value

decorators : {"identity": identity}

@decorators.identity
class Widget:
    name : "widget"

print("decorated class:", Widget["name"])

# =============================================================================
# each.ie
# =============================================================================
#   f@ xs      — unary each
#   xs f@ ys   — dyadic each; scalars extend

def add(a, b):
    return a + b

def offset(k):
    def apply(x):
        return x + k
    return apply

print("unary each:", abs@ [1, -2, 3])
print("dyadic each:", [1, 2] add@ [10, 20])
print("scalar extension:", [1, 2] add@ 5)
print("factory verb:", offset(2)@ [1, 2, 3])

d : {"x": -1, "y": 2}
print("dict each:", abs@ d)

t : table(a:[1, -2], b:[-3, 4])
print("table each:")
print(abs@ t)

