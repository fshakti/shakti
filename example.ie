# =============================================================================
# gfx_demo.ie
# =============================================================================
# Standalone pixel window (960x540 design, presented at 1920x1080). Close the window to exit.
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti example.ie  # section: gfx_demo.ie
# Also: examples/gfx_demo.ie, examples/gfx_demo_timed.ie, examples/gfx_movie.ie
# Game (local): examples/infinibattle/ — make gfx-build && make duel

import gfx

if not gfx.available():
    print("gfx not available")
else:
    gfx.open("Shakti GFX")
    gfx.clear(0x0a0a12)
    gfx.fill_rect(80, 60, 800, 40, 0x2244aa)
    gfx.fill_rect(120, 160, 200, 200, 0xff6644)
    gfx.fill_circle(640, 300, 90, 0x44dd88)
    gfx.line(40, 500, 920, 40, 0xffffff)
    while gfx.alive():
        if gfx.click_pending():
            x : gfx.click_x()
            y : gfx.click_y()
            gfx.fill_circle(x, y, 12, 0xffcc00)
            gfx.consume_click()
        gfx.tick()
    gfx.close()
    print("done")

# =============================================================================
# pyplot_demo.ie
# =============================================================================
# matplotlib.pyplot-shaped charts on gfx.
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti example.ie  # section: pyplot_demo.ie
# Also: examples/pyplot_demo.ie

import pyplot
import gfx

if not gfx.available():
    print("pyplot demo: gfx not available")
else:
    if getenv("SHAKTI_GFX_SKIP") = "1":
        print("pyplot demo: show skipped (SHAKTI_GFX_SKIP=1)")
    else:
        pyplot.plot([0, 1, 2, 3, 4, 5], [0, 1, 4, 9, 16, 25], color:"C0", label:"sq")
        pyplot.scatter([0, 1, 2, 3, 4, 5], [0, 1.5, 3, 6, 12, 20], color:"C1", label:"pts")
        pyplot.bar([0.3, 1.3, 2.3], [4, 2, 5], color:"C2", label:"bars")
        pyplot.title("pyplot demo")
        pyplot.xlabel("x")
        pyplot.ylabel("y")
        pyplot.grid(1)
        pyplot.legend()
        pyplot.show()
        print("done")

# =============================================================================
# jupyter_demo.ie
# =============================================================================
# IPython / Notebook-shaped cells on eval + .ipynb R/W (optional gfx view).
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti example.ie  # section: jupyter_demo.ie
#   SHAKTI_GFX_SKIP=1 ./shakti examples/jupyter_demo.ie
# Also: examples/jupyter_demo.ie

import jupyter
import gfx

def _escape_nl(s):
    out : ""
    for ch in str(s):
        if ch = "\n":
            out : out + "\\n"
        else:
            out : out + ch
    return out

def _fmt_in(xs):
    parts : []
    for s in xs:
        parts.append(_escape_nl(s))
    return parts

jupyter.new()
jupyter.markdown("# jupyter demo")
jupyter.code("a : [1, 2, 3, 4]")
jupyter.code("b : 0\nfor x in a:\n    b : b + x\nb")
jupyter.code("a")
vals : jupyter.run_all()
print("run_all:", vals)
print("In:", _fmt_in(jupyter.get_in()))
print("Out:", jupyter.get_out())
path : "/tmp/shakti_jupyter_demo.ipynb"
nbytes : jupyter.save(path)
print("wrote", path, nbytes, "bytes")
err : jupyter.run("1 / 0")
print("error cell:", type(err))
print("run:", jupyter.run("10 * 10"))
jupyter.clear()
jupyter.load(path)
print("reloaded:", jupyter.ncells(), "cells; cell0:", jupyter.cell(0)["source"])
print("re-run_all:", jupyter.run_all())
if getenv("SHAKTI_GFX_SKIP") = "1":
    print("jupyter demo: show skipped (SHAKTI_GFX_SKIP=1)")
else:
    if gfx.available():
        jupyter.show()
    else:
        print("jupyter demo: gfx not available (skip show)")
print("done")

