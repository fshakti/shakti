# =============================================================================
# ipc_echo.ie
# =============================================================================
# Local IPC echo server — Unix domain socket on localhost (default port 19090).
# Copy the ipc_echo / ipc_echo_client sections into separate files, then:
#   Terminal 1: ./shakti ipc_echo.ie
#   Terminal 2: ./shakti ipc_echo_client.ie

import ipc

port : 19090
srv : ipc.listen(port)
print("ipc echo listening on port", port, "(uds on localhost)")

conn : ipc.accept(srv)
msg : ipc.recv(conn)
print("recv:", msg)
ipc.send(conn, msg)
ipc.close(conn)
ipc.close(srv)
print("done")

# =============================================================================
# ipc_echo_client.ie
# =============================================================================
# Client for ipc_echo.ie — connects via UDS (localhost default).
import ipc

port : 19090
c : ipc.connect("127.0.0.1", port)
ipc.send(c, "hello from client")
msg : ipc.recv(c)
print("reply:", msg)
ipc.close(c)

# =============================================================================
# ipc_rdma.ie
# =============================================================================
# RDMA/RoCE IPC example — requires RDMA-capable NIC and rdma-core dev libraries.
# Copy the ipc_rdma / ipc_rdma_client sections into separate files, then:
#   Server: ./shakti ipc_rdma.ie
#   Client: ./shakti ipc_rdma_client.ie  (set host/port to match)

import ipc

if ipc.rdma_available() = 0:
    print("no RDMA device — install rdma-core and configure RoCE NIC")
else:
    port : 19100
    srv : ipc.listen(port, "0.0.0.0", "rdma")
    print("rdma server on port", port)
    conn : ipc.accept(srv)
    msg : ipc.recv(conn)
    print("recv:", msg)
    ipc.send(conn, "rdma-ok")
    ipc.close(conn)
    ipc.close(srv)

# =============================================================================
# ipc_rdma_client.ie
# =============================================================================
# RDMA client for ipc_rdma.ie — set host to server address.
import ipc

host : "127.0.0.1"
port : 19100

if ipc.rdma_available() = 0:
    print("no RDMA device")
else:
    c : ipc.connect(host, port, "rdma")
    ipc.send(c, "ping")
    print("reply:", ipc.recv(c))
    ipc.close(c)

# =============================================================================
# rest_demo.ie
# =============================================================================
# REST client + local server demo
#
#   export SHAKTI_LIB=$PWD/lib
#   ./shakti example.ie  # section: rest_demo.ie
#
# Optional live API (needs network):
#   resp : rest.get("https://httpbin.org/get")

import rest

srv_src : "import rest\nport : 29878\nloops : 60\nsrv : rest.listen(port)\nfor i in range(loops):\n    c : rest.accept(srv)\n    req : rest.read(c)\n    body : \"pong\"\n    if req[\"path\"] = \"/echo\":\n        body : req[\"body\"]\n    rest.write(c, 200, body, \"text/plain\")\n    rest.close(c)\nrest.close(srv)\n"
write("/tmp/shakti_rest_ping_server.ie", srv_src)

sh("./shakti /tmp/shakti_rest_ping_server.ie &")
sh("sleep 0.5")

print("GET /ping")
resp : rest.get("http://127.0.0.1:29878/ping")
if rest.ok(resp):
    print("status:", rest.status(resp), "body:", rest.text(resp))
else:
    print("error status:", rest.status(resp))

sh("./shakti /tmp/shakti_rest_ping_server.ie &")
sh("sleep 0.5")

print("POST /echo")
resp2 : rest.post_json("http://127.0.0.1:29878/echo", {"msg": "hello"})
if rest.ok(resp2):
    print("echo:", rest.json(resp2))
else:
    print("error status:", rest.status(resp2))

print("rest demo done")

# =============================================================================
# example.py — Python 3 subset translated to Shakti
# =============================================================================
# Run the source directly with:
#   ./shakti example.py
#
# Regenerate this section with:
#   ./shakti s2p.ie example.py -o /tmp/example_python.ie

# Python 3 subset examples runnable by CPython or `./shakti example.py`.
def traced(f):
    def wrapper(x):
        print("call", x)
        return f(x)
    return wrapper
@traced
def square(x):
    return (x * x)
def clamp(x, low:0, high:10):
    if (x < low):
        return low
    elif (x > high):
        return high
    return x
# Arithmetic, defaults, keyword arguments, decorators, and one-argument lambda.
print("square", square(6))
print("clamp", clamp(15, high:12))
increment : (lambda x: (x + 1))
print("lambda", increment(9))
# Lists, slices, tuple unpacking, dictionaries, loops, and augmented assignment.
__s2p_values : [2, 4, 6, 8]
size : len(__s2p_values)
