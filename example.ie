first, second : (10, 20)
print("tuple", (first + second))
record : {"name": "shakti", "count": size}
print("dict", record["name"], record["count"])
total : 0
for i in range(len(__s2p_values)):
    total += __s2p_values[i]
print("for", total)
countdown : 3
while (countdown > 0):
    print("while", countdown)
    countdown -= 1
name : "python"
