# c2s -- strict K&R-oriented C subset to Shakti.

import converter_shared
import transpile_cli

shakti_reserved : ["select", "update", "delete", "by", "from", "where",
                   "create", "insert", "into", "values", "join", "on",
                   "union", "outer"]
c_keywords : ["if", "else", "while", "for", "do", "switch", "case", "default",
              "return", "break", "continue", "goto", "typedef", "struct",
              "union", "enum", "sizeof", "static", "extern", "register",
              "auto", "volatile", "restrict", "inline", "const", "signed",
              "unsigned", "void", "int", "long", "short", "double", "float",
              "char", "bool", "_Bool", "true", "false", "NULL"]
c_type_keywords : ["void", "int", "long", "short", "double", "float", "char",
                   "bool", "_Bool", "size_t"]
c_type_modifiers : ["const", "unsigned", "signed", "short", "long", "volatile",
                    "restrict"]
c_storage : ["static", "extern", "register", "auto", "inline"]
c_forbidden_names : ["malloc", "free", "sizeof"]
two_ops : ["==", "!=", "<=", ">=", "&&", "||", "++", "--", "+=", "-=", "*=",
           "/=", "%=", "&=", "|=", "^=", "->", "<<", ">>"]
three_ops : ["<<=", ">>="]
bit_binop_names : {"&":"band", "|":"bor", "^":"bxor", "<<":"shl", ">>":"shr"}
bit_aug_ops : {"&=":"band", "|=":"bor", "^=":"bxor", "<<=":"shl", ">>=":"shr"}

def is_kw(text):
    return text in c_keywords

def is_type_kw(text):
    return text in c_type_keywords

def is_type_mod(text):
    return text in c_type_modifiers

def is_storage(text):
    return text in c_storage

def tok(kind, text, val, line, col):
    return converter_shared.tok(kind, text, val, line, col)

def node(t, x):
    return converter_shared.node(t, x)

def starts(s, p):
    return converter_shared.starts(s, p)

def is_alpha(c):
    return converter_shared.is_alpha(c)

def is_digit(c):
    return converter_shared.is_digit(c)

def is_alnum(c):
    return converter_shared.is_alnum(c)

def quote_string(s):
    return converter_shared.quote_string(s)

def num_clean(t):
    out : ""
    i : 0
    while i < len(t):
        c : t[i]
        if c != "_":
            out += c
        i += 1
    return out

def lex_string(src, i, ln, col):
    start : i
    q : src[i]
    i += 1
    val : ""
    while i < len(src):
        c : src[i]
        if c = q:
            i += 1
            return [tok("STRING", src[start:i], {"s":val}, ln, col), i]
        if c = "\n":
            raise str(ln) + ":" + str(col) + ": unterminated string"
        if c = "\\":
            if i + 1 >= len(src):
                raise str(ln) + ":" + str(col) + ": unterminated string"
            e : src[i + 1]
            if e = "n":
                val += "\n"
            elif e = "t":
                val += "\t"
            elif e = "r":
                val += "\r"
            elif e = "\"":
                val += "\""
            elif e = "'":
                val += "'"
            elif e = "\\":
                val += "\\"
            else:
                val += e
            i += 2
        else:
            val += c
            i += 1
    raise str(ln) + ":" + str(col) + ": unterminated string"

def skip_ws_nl(source, i, n, ln, line_start):
    while i < n:
        c : source[i]
        if c = "\n":
            ln += 1
            i += 1
            line_start : i
            continue
        if c = " " or c = "\t" or c = "\r":
            i += 1
            continue
        break
    return [i, ln, line_start]

def lex_tokens_from(source, macros):
    n : len(source)
    ts : []
    comments : {"0":""}
    inline : {"0":""}
    i : 0
    ln : 1
    line_start : 0
    line_has_code : False
    while i < n:
        c : source[i]
        if c = "\n":
            ln += 1
            i += 1
            line_start : i
            line_has_code : False
            continue
        if c = " " or c = "\t" or c = "\r":
            i += 1
            continue
        col : i - line_start + 1
        if c = "#":
            j : i + 1
            while j < n and source[j] != "\n":
                j += 1
            line : source[i:j]
            if starts(line, "#include"):
                i : j
                continue
            if starts(line, "#define"):
                rest : line[7:]
                k : 0
                while k < len(rest) and (rest[k] = " " or rest[k] = "\t"):
                    k += 1
                if k >= len(rest) or not is_alpha(rest[k]):
                    raise str(ln) + ":" + str(col) + ": invalid #define"
                start_name : k
                k += 1
                while k < len(rest) and is_alnum(rest[k]):
                    k += 1
                name : rest[start_name:k]
                if k < len(rest) and rest[k] = "(":
                    raise str(ln) + ":" + str(col) + ": function-like #define is unsupported"
                while k < len(rest) and (rest[k] = " " or rest[k] = "\t"):
                    k += 1
                macros[name] : rest[k:]
                i : j
                continue
            if starts(line, "#if") or starts(line, "#ifdef") or starts(line, "#ifndef") or starts(line, "#endif") or starts(line, "#undef") or starts(line, "#elif") or starts(line, "#else"):
                raise str(ln) + ":" + str(col) + ": conditional/undef preprocessor directives are unsupported"
            raise str(ln) + ":" + str(col) + ": unsupported preprocessor directive"
        if c = "/" and i + 1 < n and source[i + 1] = "/":
            j : i + 2
            while j < n and source[j] != "\n":
                j += 1
            text : "#" + source[i + 2:j]
            if line_has_code:
                inline[str(ln)] : text
            else:
                comments[str(ln)] : text
            i : j
            continue
        if c = "/" and i + 1 < n and source[i + 1] = "*":
            start_ln : ln
            j : i + 2
            while j + 1 < n and not (source[j] = "*" and source[j + 1] = "/"):
                if source[j] = "\n":
                    ln += 1
                    line_start : j + 1
                j += 1
            if not (j + 1 < n and source[j] = "*" and source[j + 1] = "/"):
                raise str(start_ln) + ":" + str(col) + ": unterminated block comment"
            i : j + 2
            continue
        line_has_code : True
        if is_alpha(c):
            j : i + 1
            while j < n and is_alnum(source[j]):
                j += 1
            text : source[i:j]
            if text in macros:
                exp : macros[text]
                # Re-lex expansion at the current line/col; do not recurse macros.
                sub : lex_tokens_from(exp, {})
                for t in sub["tokens"]:
                    if t["kind"] = "END":
                        continue
                    t["line"] : ln
                    t["col"] : col
                    ts.append(t)
                i : j
                continue
            ts.append(tok("NAME", text, text, ln, col))
            i : j
            continue
        if is_digit(c) or (c = "." and i + 1 < n and is_digit(source[i + 1])):
            j : i + 1
            while j < n:
                cj : source[j]
                if is_alnum(cj) or cj = "_":
                    j += 1
                elif cj = "." and j + 1 < n and is_digit(source[j + 1]):
                    j += 1
                else:
                    break
            text : num_clean(source[i:j])
            ts.append(tok("NUMBER", text, text, ln, col))
            i : j
            continue
        if c = "\"" or c = "'":
            z : lex_string(source, i, ln, col)
            ts.append(z[0])
            i : z[1]
            continue
        op : c
        if i + 2 < n:
            three : source[i:i + 3]
            if three in three_ops:
                op : three
        if len(op) = 1 and i + 1 < n:
            two : source[i:i + 2]
            if two in two_ops:
                op : two
        ts.append(tok("OP", op, op, ln, col))
        i += len(op)
    ts.append(tok("END", "", None, ln, i - line_start + 1))
    return {"tokens":ts, "comments":comments, "inline":inline}

def lex(source):
    return lex_tokens_from(source, {})

def peek(p):
    return p["tokens"][p["pos"]]

def peekn(p, k):
    j : p["pos"] + k
    if j >= len(p["tokens"]):
        j : len(p["tokens"]) - 1
    return p["tokens"][j]

def take(p):
    x : peek(p)
    p["pos"] += 1
    return x

def at(p, text):
    return peek(p)["text"] = text

def kind(p, k):
    return peek(p)["kind"] = k

def fail(p, msg, x):
    raise p["filename"] + ":" + str(x["line"]) + ":" + str(x["col"]) + ": " + msg

def need(p, text):
    x : peek(p)
    if x["text"] != text:
        fail(p, "expected '" + text + "'", x)
    return take(p)

def need_kind(p, k):
    x : peek(p)
    if x["kind"] != k:
        fail(p, "expected " + k, x)
    return take(p)

def ident(p, x):
    name : x["text"]
    if name in shakti_reserved or starts(name, "__c_"):
        name : "__c_" + name
    x["text"] : name
    return name

def reject_pointer_type(p):
    if at(p, "*"):
        fail(p, "pointer types are unsupported", peek(p))

def skip_storage_class(p):
    while kind(p, "NAME") and is_storage(peek(p)["text"]):
        take(p)

def is_known_type_name(p, t):
    if is_type_kw(t) or t = "size_t":
        return True
    if t in p["aliases"]:
        return True
    return False

def skip_type(p):
    save : p["pos"]
    skip_storage_class(p)
    if not kind(p, "NAME"):
        p["pos"] : save
        return False
    saw : False
    struct_tag : None
    while kind(p, "NAME") or at(p, "struct") or at(p, "enum") or at(p, "union"):
        t : peek(p)["text"]
        if t = "union":
            fail(p, "union types are unsupported", peek(p))
        if t = "struct":
            take(p)
            if not kind(p, "NAME"):
                fail(p, "expected struct tag", peek(p))
            struct_tag : take(p)["text"]
            saw : True
            break
        if t = "enum":
            take(p)
            if kind(p, "NAME"):
                take(p)
            saw : True
            break
        if is_type_mod(t):
            take(p)
        elif is_known_type_name(p, t):
            take(p)
            saw : True
        elif is_storage(t):
            take(p)
        elif is_kw(t):
            break
        else:
            break
    if not saw:
        p["pos"] : save
        return False
    return True

def peek_struct_tag_after_type(p, save):
    # After a successful skip_type from save, recover struct tag if present.
    pos : p["pos"]
    p["pos"] : save
    skip_storage_class(p)
    tag : None
    if at(p, "struct"):
        take(p)
        if kind(p, "NAME"):
            tag : peek(p)["text"]
    elif kind(p, "NAME") and peek(p)["text"] in p["aliases"]:
        al : p["aliases"][peek(p)["text"]]
        if type(al) = "dict" and "struct" in al:
            tag : al["struct"]
    p["pos"] : pos
    return tag

def default_for_field(p, field_type_hint):
    z : node("Const", peek(p))
    z["value"] : "0"
    z["kind"] : "number"
    return z

def make_struct_dict(p, x, tag, init_elts):
    if tag = None or tag not in p["structs"]:
        fail(p, "unknown struct type", x)
    fields : p["structs"][tag]
    z : node("Dict", x)
    z["keys"] : []
    z["values"] : []
    i : 0
    while i < len(fields):
        k : node("Const", x)
        k["value"] : fields[i]
        k["kind"] : "string"
        z["keys"].append(k)
        if init_elts != None and i < len(init_elts):
            z["values"].append(init_elts[i])
        else:
            z["values"].append(default_for_field(p, None))
        i += 1
    if init_elts != None and len(init_elts) > len(fields):
        fail(p, "too many initializers for struct", x)
    return z

def skip_main_param_type(p):
    if not skip_type(p):
        return False
    while at(p, "*"):
        take(p)
    while at(p, "["):
        take(p)
        if not at(p, "]"):
            fail(p, "sized array parameters are unsupported", peek(p))
        take(p)
    return True

def parse_main_params(p):
    need(p, "(")
    if at(p, "void"):
        take(p)
        need(p, ")")
        return []
    if at(p, ")"):
        take(p)
        return []
    args : []
    while not at(p, ")"):
        if not skip_main_param_type(p):
            fail(p, "expected main parameter type", peek(p))
        if kind(p, "NAME"):
            a : take(p)
            ident(p, a)
            args.append(a["text"])
        if not at(p, ")"):
            need(p, ",")
    need(p, ")")
    return args

def parse(source, filename):
    lx : lex(source)
    p : {"tokens":lx["tokens"], "pos":0, "filename":filename, "aliases":{},
         "comments":lx["comments"], "inline":lx["inline"], "has_main":False,
         "main_arity":0, "structs":{}, "enums":{}, "goto_tmp":0}
    body : []
    while not kind(p, "END"):
        body.append(parse_stmt(p))
    if p["has_main"]:
        x : peek(p)
        call : node("Expr", x)
        c : node("Call", x)
        fn : node("Name", x)
        fn["value"] : "main"
        c["func"] : fn
        c["args"] : []
        c["kwargs"] : []
        if p["main_arity"] >= 1:
            sl : node("Subscript", x)
            av : node("Name", x)
            av["value"] : "argv"
            sl["value"] : av
            slice : node("Slice", x)
            one : node("Const", x)
            one["value"] : "1"
            one["kind"] : "number"
            slice["lower"] : one
            slice["upper"] : None
            slice["step"] : None
            sl["slice"] : slice
            if p["main_arity"] >= 2:
                ln : node("Call", x)
                lf : node("Name", x)
                lf["value"] : "len"
                ln["func"] : lf
                ln["args"] : [sl]
                ln["kwargs"] : []
                c["args"].append(ln)
                sl2 : node("Subscript", x)
                av2 : node("Name", x)
                av2["value"] : "argv"
                sl2["value"] : av2
                slice2 : node("Slice", x)
                one2 : node("Const", x)
                one2["value"] : "1"
                one2["kind"] : "number"
                slice2["lower"] : one2
                slice2["upper"] : None
                slice2["step"] : None
                sl2["slice"] : slice2
                c["args"].append(sl2)
            else:
                c["args"].append(sl)
        call["value"] : c
        body.append(call)
    return {"t":"Module", "body":body, "comments":p["comments"], "inline":p["inline"],
            "aliases":p["aliases"], "filename":filename, "has_main":p["has_main"],
            "structs":p["structs"]}

def parse_stmt(p):
    x : peek(p)
    if at(p, "union"):
        fail(p, "union declarations are unsupported", x)
    if at(p, "typedef"):
        return parse_typedef(p)
    if at(p, "struct"):
        return parse_struct_or_decl(p)
    if at(p, "enum"):
        return parse_enum(p)
    if at(p, "do"):
        return parse_do_while(p)
    if at(p, "switch"):
        return parse_switch(p)
    if at(p, "goto"):
        return parse_goto(p)
    if kind(p, "NAME") and peekn(p, 1)["text"] = ":" and not is_kw(peek(p)["text"]):
        return parse_label(p)
    if at(p, "if"):
        return parse_if(p)
    if at(p, "while"):
        return parse_while(p)
    if at(p, "for"):
        return parse_for(p)
    if at(p, "return"):
        return parse_return(p)
    if at(p, "break") or at(p, "continue"):
        take(p)
        z : node(x["text"], x)
        need(p, ";")
        return z
    if at(p, "{"):
        fail(p, "unexpected block", x)
    fn : try_parse_func(p)
    if fn != None:
        return fn
    d : try_parse_decl(p)
    if d != None:
        return d
    return parse_expr_stmt(p)

def parse_label(p):
    x : take(p)
    name : ident(p, x)
    need(p, ":")
    z : node("Label", x)
    z["name"] : name
    return z

def parse_goto(p):
    x : take(p)
    n : need_kind(p, "NAME")
    need(p, ";")
    z : node("Goto", x)
    z["name"] : ident(p, n)
    return z

def const_zero(x):
    z : node("Const", x)
    z["value"] : "0"
    z["kind"] : "number"
    return z

def const_true(x):
    z : node("Const", x)
    z["value"] : "True"
    z["kind"] : "number"
    return z

def const_str(x, s):
    z : node("Const", x)
    z["value"] : s
    z["kind"] : "string"
    return z

def name_node(x, s):
    z : node("Name", x)
    z["value"] : s
    return z

def assign_name(x, name, value):
    z : node("Assign", x)
    z["target"] : name_node(x, name)
    z["value"] : value
    return z

def desugar_goto_body(p, body, x):
    has : False
    for s in body:
        if s["t"] = "Label" or s["t"] = "Goto":
            has : True
            break
    if not has:
        return body
    # Split top-level body on Label nodes.
    segments : []
    cur_label : ""
    cur : []
    for s in body:
        if s["t"] = "Label":
            segments.append({"label":cur_label, "body":cur})
            cur_label : s["name"]
            cur : []
        else:
            cur.append(s)
    segments.append({"label":cur_label, "body":cur})
    out : []
    out.append(assign_name(x, "__c_goto", const_str(x, "")))
    w : node("While", x)
    w["test"] : const_true(x)
    wbody : []
    for seg in segments:
        # if __c_goto = "" or __c_goto = "lab":
        test : None
        left : name_node(x, "__c_goto")
        eq1 : node("Compare", x)
        eq1["left"] : left
        eq1["op"] : "=="
        eq1["right"] : const_str(x, "")
        if seg["label"] = "":
            test : eq1
        else:
            left2 : name_node(x, "__c_goto")
            eq2 : node("Compare", x)
            eq2["left"] : left2
            eq2["op"] : "=="
            eq2["right"] : const_str(x, seg["label"])
            bo : node("BoolOp", x)
            bo["op"] : "or"
            bo["values"] : [eq1, eq2]
            test : bo
        iff : node("If", x)
        iff["test"] : test
        iff["elifs"] : []
        iff["orelse"] : []
        sb : [assign_name(x, "__c_goto", const_str(x, ""))]
        for st in seg["body"]:
            if st["t"] = "Goto":
                sb.append(assign_name(st, "__c_goto", const_str(st, st["name"])))
                sb.append(node("continue", st))
            elif st["t"] = "Label":
                fail(p, "nested labels in goto desugar are unsupported", st)
            else:
                sb.append(st)
        if len(sb) = 0:
            sb.append(node("pass", x))
        iff["body"] : sb
        wbody.append(iff)
    wbody.append(node("break", x))
    w["body"] : wbody
    out.append(w)
    return out

def parse_struct_fields(p):
    need(p, "{")
    fields : []
    while not at(p, "}") and not kind(p, "END"):
        if not skip_type(p):
            fail(p, "expected field type", peek(p))
        reject_pointer_type(p)
        while True:
            if not kind(p, "NAME"):
                fail(p, "expected field name", peek(p))
            ft : take(p)
            while at(p, "["):
                fail(p, "array fields are unsupported", peek(p))
            fields.append(ft["text"])
            if at(p, ","):
                take(p)
                reject_pointer_type(p)
                continue
            break
        need(p, ";")
    need(p, "}")
    return fields

def parse_struct_or_decl(p):
    x : peek(p)
    save : p["pos"]
    take(p)  # struct
    if not kind(p, "NAME"):
        fail(p, "expected struct tag", peek(p))
    tag_tok : take(p)
    tag : tag_tok["text"]
    if at(p, "{"):
        fields : parse_struct_fields(p)
        p["structs"][tag] : fields
        if at(p, ";"):
            take(p)
            z : node("Seq", x)
            z["body"] : []
            return z
        # struct S {..} name;
        return finish_struct_var_decl(p, x, tag)
    # struct S name; / struct S name = {...};
    p["pos"] : save
    d : try_parse_decl(p)
    if d != None:
        return d
    fail(p, "invalid struct declaration", x)

def finish_struct_var_decl(p, x, tag):
    if not kind(p, "NAME"):
        fail(p, "expected declarator", peek(p))
    return parse_decl_list_after_type(p, x, tag)

def parse_enum(p):
    x : take(p)
    tag : None
    if kind(p, "NAME"):
        tag : take(p)["text"]
    need(p, "{")
    seq : node("Seq", x)
    seq["body"] : []
    next_val : 0
    while not at(p, "}") and not kind(p, "END"):
        if not kind(p, "NAME"):
            fail(p, "expected enumerator", peek(p))
        et : take(p)
        name : ident(p, et)
        val : next_val
        if at(p, "="):
            take(p)
            if not kind(p, "NUMBER"):
                fail(p, "enum value must be a number literal", peek(p))
            vt : take(p)
            val : int(vt["text"])
        c : node("Const", et)
        c["value"] : str(val)
        c["kind"] : "number"
        seq["body"].append(assign_name(et, name, c))
        next_val : val + 1
        if at(p, ","):
            take(p)
            if at(p, "}"):
                break
            continue
        break
    need(p, "}")
    if tag != None:
        p["enums"][tag] : True
    need(p, ";")
    if len(seq["body"]) = 0:
        z : node("Seq", x)
        z["body"] : []
        return z
    return seq

def empty_stmt(x):
    z : node("Seq", x)
    z["body"] : []
    return z

def parse_typedef(p):
    x : take(p)
    if at(p, "struct"):
        take(p)
        tag : None
        if kind(p, "NAME"):
            tag : take(p)["text"]
        if at(p, "{"):
            fields : parse_struct_fields(p)
            if tag = None:
                tag : "__c_anon_" + str(len(p["structs"]))
            p["structs"][tag] : fields
        elif tag = None:
            fail(p, "expected struct tag or body in typedef", peek(p))
        elif tag not in p["structs"]:
            p["structs"][tag] : []
        if not kind(p, "NAME"):
            fail(p, "expected typedef name", peek(p))
        alias : take(p)["text"]
        p["aliases"][alias] : {"struct":tag}
        need(p, ";")
        return empty_stmt(x)
    if at(p, "enum"):
        # typedef enum {..} Name; or typedef enum E Name;
        take(p)
        if kind(p, "NAME"):
            take(p)
        if at(p, "{"):
            # parse enumerators as side effect via temporary
            save_body : []
            need(p, "{")
            next_val : 0
            seq : node("Seq", x)
            seq["body"] : []
            while not at(p, "}") and not kind(p, "END"):
                if not kind(p, "NAME"):
                    fail(p, "expected enumerator", peek(p))
                et : take(p)
                name : ident(p, et)
                val : next_val
                if at(p, "="):
                    take(p)
                    if not kind(p, "NUMBER"):
                        fail(p, "enum value must be a number literal", peek(p))
                    vt : take(p)
                    val : int(vt["text"])
                c : node("Const", et)
                c["value"] : str(val)
                c["kind"] : "number"
                seq["body"].append(assign_name(et, name, c))
                next_val : val + 1
                if at(p, ","):
                    take(p)
                    if at(p, "}"):
                        break
                    continue
                break
            need(p, "}")
            if not kind(p, "NAME"):
                fail(p, "expected typedef name", peek(p))
            alias : take(p)["text"]
            p["aliases"][alias] : "enum"
            need(p, ";")
            if len(seq["body"]) = 0:
                return empty_stmt(x)
            return seq
        if not kind(p, "NAME"):
            fail(p, "expected typedef name", peek(p))
        alias : take(p)["text"]
        p["aliases"][alias] : "enum"
        need(p, ";")
        return empty_stmt(x)
    if not skip_type(p):
        fail(p, "expected type in typedef", peek(p))
    reject_pointer_type(p)
    if not kind(p, "NAME"):
        fail(p, "expected typedef name", peek(p))
    alias : take(p)["text"]
    p["aliases"][alias] : "type"
    need(p, ";")
    return empty_stmt(x)

def try_parse_func(p):
    save : p["pos"]
    ok : skip_type(p)
    if not ok:
        p["pos"] : save
        return None
    reject_pointer_type(p)
    if not kind(p, "NAME") or is_kw(peek(p)["text"]):
        p["pos"] : save
        return None
    name_tok : peek(p)
    if peekn(p, 1)["text"] != "(":
        p["pos"] : save
        return None
    x : name_tok
    take(p)
    ident(p, name_tok)
    z : node("FunctionDef", x)
    z["name"] : name_tok["text"]
    z["decorators"] : []
    z["defaults"] : []
    if name_tok["text"] = "main":
        p["has_main"] : True
        args : parse_main_params(p)
        z["args"] : args
        defaults : []
        for a in args:
            defaults.append(None)
        z["defaults"] : defaults
        p["main_arity"] : len(args)
        z["body"] : desugar_goto_body(p, parse_block(p), x)
        return z
    need(p, "(")
    # Detect K&R: (a, b) vs (int a, int b) vs ()
    knr : False
    if not at(p, ")"):
        # Lookahead: if first token is NAME and not a type, K&R param names
        if kind(p, "NAME") and not is_known_type_name(p, peek(p)["text"]) and not is_type_mod(peek(p)["text"]) and not is_storage(peek(p)["text"]) and peek(p)["text"] != "struct" and peek(p)["text"] != "enum" and peek(p)["text"] != "void":
            knr : True
    args : []
    defaults : []
    if knr:
        while not at(p, ")"):
            a : need_kind(p, "NAME")
            ident(p, a)
            args.append(a["text"])
            defaults.append(None)
            if not at(p, ")"):
                need(p, ",")
        need(p, ")")
        # K&R declaration list
        while not at(p, "{") and not kind(p, "END"):
            if not skip_type(p):
                fail(p, "expected K&R parameter declaration", peek(p))
            reject_pointer_type(p)
            while True:
                if not kind(p, "NAME"):
                    fail(p, "expected parameter name", peek(p))
                take(p)
                while at(p, "["):
                    take(p)
                    if not at(p, "]"):
                        fail(p, "sized array parameters are unsupported", peek(p))
                    take(p)
                if at(p, ","):
                    take(p)
                    reject_pointer_type(p)
                    continue
                break
            need(p, ";")
        z["args"] : args
        z["defaults"] : defaults
        z["body"] : desugar_goto_body(p, parse_block(p), x)
        return z
    if not at(p, ")"):
        while True:
            if at(p, "void") and peekn(p, 1)["text"] = ")":
                take(p)
                break
            if not skip_type(p):
                fail(p, "expected parameter type", peek(p))
            reject_pointer_type(p)
            a : need_kind(p, "NAME")
            while at(p, "["):
                take(p)
                if not at(p, "]"):
                    fail(p, "sized array parameters are unsupported", peek(p))
                take(p)
            ident(p, a)
            args.append(a["text"])
            defaults.append(None)
            if not at(p, ","):
                break
            take(p)
    need(p, ")")
    z["args"] : args
    z["defaults"] : defaults
    z["body"] : desugar_goto_body(p, parse_block(p), x)
    return z

def parse_init_value(p, struct_tag):
    x : peek(p)
    if at(p, "{"):
        if struct_tag != None and struct_tag in p["structs"]:
            take(p)
            elts : []
            if not at(p, "}"):
                while True:
                    elts.append(parse_expr(p))
                    if not at(p, ","):
                        break
                    take(p)
                    if at(p, "}"):
                        break
            need(p, "}")
            return make_struct_dict(p, x, struct_tag, elts)
        return parse_array_init(p, x)
    return parse_expr(p)

def parse_decl_list_after_type(p, x, struct_tag):
    seq : node("Seq", x)
    seq["body"] : []
    while True:
        reject_pointer_type(p)
        if not kind(p, "NAME") or is_kw(peek(p)["text"]):
            fail(p, "expected declarator name", peek(p))
        name_tok : take(p)
        is_array : False
        while at(p, "["):
            is_array : True
            take(p)
            if not at(p, "]"):
                if kind(p, "NUMBER"):
                    take(p)
                else:
                    fail(p, "sized array declarations require a numeric bound or []", peek(p))
            need(p, "]")
        ident(p, name_tok)
        value : None
        if at(p, "="):
            take(p)
            if is_array:
                value : parse_init_value(p, None)
            else:
                value : parse_init_value(p, struct_tag)
        else:
            if is_array:
                fail(p, "array declarations require an initializer", peek(p))
            elif struct_tag != None and struct_tag in p["structs"]:
                value : make_struct_dict(p, name_tok, struct_tag, None)
            else:
                value : const_zero(name_tok)
        z : node("Assign", name_tok)
        tgt : node("Name", name_tok)
        tgt["value"] : name_tok["text"]
        z["target"] : tgt
        z["value"] : value
        seq["body"].append(z)
        if at(p, ","):
            take(p)
            continue
        break
    need(p, ";")
    if len(seq["body"]) = 1:
        return seq["body"][0]
    return seq

def try_parse_decl(p):
    save : p["pos"]
    ok : skip_type(p)
    if not ok:
        p["pos"] : save
        return None
    struct_tag : peek_struct_tag_after_type(p, save)
    reject_pointer_type(p)
    if not kind(p, "NAME") or is_kw(peek(p)["text"]):
        p["pos"] : save
        return None
    # Must look like a declarator: name then = , ; or [
    j : 0
    if peekn(p, j)["kind"] != "NAME":
        p["pos"] : save
        return None
    j += 1
    while peekn(p, j)["text"] = "[":
        if peekn(p, j + 1)["text"] = "]":
            j += 2
        elif peekn(p, j + 1)["kind"] = "NUMBER" and peekn(p, j + 2)["text"] = "]":
            j += 3
        else:
            p["pos"] : save
            return None
    nxt : peekn(p, j)["text"]
    if nxt != "=" and nxt != "," and nxt != ";":
        p["pos"] : save
        return None
    x : peek(p)
    return parse_decl_list_after_type(p, x, struct_tag)

def parse_block(p):
    lb : need(p, "{")
    xs : []
    while not at(p, "}") and not kind(p, "END"):
        xs.append(parse_stmt(p))
    need(p, "}")
    if len(xs) = 0:
        px : node("pass", lb)
        return [px]
    return xs

def parse_block_or_stmt(p):
    if at(p, "{"):
        return parse_block(p)
    return [parse_stmt(p)]

def parse_return(p):
    x : take(p)
    z : node("Return", x)
    z["value"] : None
    if not at(p, ";"):
        z["value"] : parse_expr(p)
    need(p, ";")
    return z

def parse_if(p):
    x : take(p)
    need(p, "(")
    test : parse_expr(p)
    need(p, ")")
    z : node("If", x)
    z["test"] : test
    z["body"] : parse_block_or_stmt(p)
    z["elifs"] : []
    z["orelse"] : []
    while at(p, "else") and peekn(p, 1)["text"] = "if":
        e : take(p)
        take(p)
        need(p, "(")
        et : parse_expr(p)
        need(p, ")")
        eb : parse_block_or_stmt(p)
        z["elifs"].append({"test":et, "body":eb, "line":e["line"], "col":e["col"]})
    if at(p, "else"):
        take(p)
        z["orelse"] : parse_block_or_stmt(p)
    return z

def parse_while(p):
    x : take(p)
    need(p, "(")
    t : parse_expr(p)
    need(p, ")")
    z : node("While", x)
    z["test"] : t
    z["body"] : parse_block_or_stmt(p)
    return z

def parse_do_while(p):
    x : take(p)
    body : parse_block_or_stmt(p)
    need(p, "while")
    need(p, "(")
    cond : parse_expr(p)
    need(p, ")")
    need(p, ";")
    w : node("While", x)
    w["test"] : const_true(x)
    b2 : []
    for s in body:
        b2.append(s)
    # if not cond: break
    iff : node("If", x)
    un : node("Unary", x)
    un["op"] : "not"
    un["value"] : cond
    iff["test"] : un
    iff["body"] : [node("break", x)]
    iff["elifs"] : []
    iff["orelse"] : []
    b2.append(iff)
    w["body"] : b2
    return w

def parse_switch(p):
    x : take(p)
    need(p, "(")
    expr : parse_expr(p)
    need(p, ")")
    need(p, "{")
    p["goto_tmp"] += 1
    tmp : "__c_sw" + str(p["goto_tmp"])
    seq : node("Seq", x)
    seq["body"] : [assign_name(x, tmp, expr)]
    cases : []
    default_body : None
    while not at(p, "}") and not kind(p, "END"):
        if at(p, "case"):
            cx : take(p)
            val : parse_expr(p)
            need(p, ":")
            cb : []
            while not at(p, "case") and not at(p, "default") and not at(p, "}") and not kind(p, "END"):
                cb.append(parse_stmt(p))
            # Reject fall-through: body must end with break (or be empty only if... no, empty is fall-through)
            if len(cb) = 0:
                fail(p, "switch fall-through is unsupported", cx)
            last : cb[len(cb) - 1]
            if last["t"] != "break":
                # allow return as terminator too
                if last["t"] != "Return":
                    fail(p, "switch fall-through is unsupported (missing break)", last)
            # strip trailing break for if-body
            body_out : []
            i : 0
            while i < len(cb):
                if i = len(cb) - 1 and cb[i]["t"] = "break":
                    break
                body_out.append(cb[i])
                i += 1
            if len(body_out) = 0:
                body_out.append(node("pass", cx))
            cases.append({"test":val, "body":body_out, "line":cx["line"], "col":cx["col"]})
        elif at(p, "default"):
            dx : take(p)
            need(p, ":")
            db : []
            while not at(p, "case") and not at(p, "default") and not at(p, "}") and not kind(p, "END"):
                db.append(parse_stmt(p))
            if len(db) > 0:
                last : db[len(db) - 1]
                if last["t"] = "break":
                    db : db[:len(db) - 1]
            if len(db) = 0:
                db : [node("pass", dx)]
            default_body : db
        else:
            fail(p, "expected case or default in switch", peek(p))
    need(p, "}")
    if len(cases) = 0 and default_body = None:
        return seq
    # Build if/elif chain
    first : cases[0] if len(cases) > 0 else None
    if first != None:
        iff : node("If", x)
        cmp : node("Compare", x)
        cmp["left"] : name_node(x, tmp)
        cmp["op"] : "=="
        cmp["right"] : first["test"]
        iff["test"] : cmp
        iff["body"] : first["body"]
        iff["elifs"] : []
        i : 1
        while i < len(cases):
            c : cases[i]
            cmpi : node("Compare", x)
            cmpi["left"] : name_node(x, tmp)
            cmpi["op"] : "=="
            cmpi["right"] : c["test"]
            iff["elifs"].append({"test":cmpi, "body":c["body"], "line":c["line"], "col":c["col"]})
            i += 1
        iff["orelse"] : default_body if default_body != None else []
        seq["body"].append(iff)
    elif default_body != None:
        for s in default_body:
            seq["body"].append(s)
    return seq

def parse_for(p):
    x : take(p)
    need(p, "(")
    init : None
    if not at(p, ";"):
        init : parse_for_clause(p)
    need(p, ";")
    cond : None
    if not at(p, ";"):
        cond : parse_expr(p)
    need(p, ";")
    upd : None
    if not at(p, ")"):
        upd : parse_assign_no_semi(p)
    need(p, ")")
    body : parse_block_or_stmt(p)
    w : node("While", x)
    if cond = None:
        w["test"] : const_true(x)
    else:
        w["test"] : cond
    b2 : []
    for s in body:
        b2.append(s)
    if upd != None:
        b2.append(upd)
    w["body"] : b2
    seq : node("Seq", x)
    stmts : []
    if init != None:
        stmts.append(init)
    stmts.append(w)
    seq["body"] : stmts
    return seq

def parse_for_clause(p):
    x : peek(p)
    save : p["pos"]
    if skip_type(p):
        reject_pointer_type(p)
        if kind(p, "NAME") and not is_kw(peek(p)["text"]) and peekn(p, 1)["text"] = "=":
            nt : take(p)
            ident(p, nt)
            need(p, "=")
            v : parse_expr(p)
            z : node("Assign", x)
            tg : node("Name", x)
            tg["value"] : nt["text"]
            z["target"] : tg
            z["value"] : v
            return z
    p["pos"] : save
    return parse_assign_no_semi(p)

def make_bit_call(x, fname, args):
    z : node("Call", x)
    fn : node("Name", x)
    fn["value"] : fname
    z["func"] : fn
    z["args"] : args
    z["kwargs"] : []
    return z

def lower_bit_binop(left, op, right):
    if op in bit_binop_names:
        return make_bit_call(left, bit_binop_names[op], [left, right])
    q : node("BinOp", left)
    q["left"] : left
    q["op"] : op
    q["right"] : right
    return q

def parse_assign_no_semi(p):
    x : peek(p)
    # Prefix ++/-- as statement
    if at(p, "++") or at(p, "--"):
        tt : take(p)["text"]
        left : parse_postfix(p)
        validate_target(p, left)
        z : node("AugAssign", x)
        z["target"] : left
        z["op"] : "+=" if tt = "++" else "-="
        z["value"] : const_zero(x)
        z["value"]["value"] : "1"
        return z
    left : parse_expr(p)
    tt : peek(p)["text"]
    if tt = "=":
        take(p)
        val : parse_expr(p)
        z : node("Assign", x)
        z["target"] : left
        z["value"] : val
        validate_target(p, left)
        return z
    if tt in ["+=", "-=", "*=", "/="]:
        op : take(p)["text"]
        z : node("AugAssign", x)
        z["target"] : left
        validate_target(p, left)
        z["op"] : op
        z["value"] : parse_expr(p)
        return z
    if tt = "%=":
        take(p)
        val : parse_expr(p)
        validate_target(p, left)
        # x : (x % y)
        z : node("Assign", x)
        z["target"] : left
        bo : node("BinOp", x)
        bo["left"] : left
        bo["op"] : "%"
        bo["right"] : val
        z["value"] : bo
        return z
    if tt in bit_aug_ops:
        op : take(p)["text"]
        val : parse_expr(p)
        validate_target(p, left)
        z : node("Assign", x)
        z["target"] : left
        z["value"] : make_bit_call(x, bit_aug_ops[op], [left, val])
        return z
    if tt = "++" or tt = "--":
        take(p)
        z : node("AugAssign", x)
        z["target"] : left
        validate_target(p, left)
        z["op"] : "+=" if tt = "++" else "-="
        one : node("Const", x)
        one["value"] : "1"
        one["kind"] : "number"
        z["value"] : one
        return z
    z : node("Expr", x)
    z["value"] : left
    return z

def parse_expr_stmt(p):
    z : parse_assign_no_semi(p)
    need(p, ";")
    return z

def validate_target(p, x):
    if x["t"] = "Name" or x["t"] = "Attr" or x["t"] = "Subscript":
        return
    fail(p, "unsupported assignment target", x)

def parse_expr(p):
    return parse_ternary(p)

def parse_ternary(p):
    c : parse_or(p)
    if at(p, "?"):
        take(p)
        a : parse_expr(p)
        need(p, ":")
        b : parse_expr(p)
        z : node("IfExp", c)
        z["body"] : a
        z["test"] : c
        z["orelse"] : b
        return z
    return c

def parse_or(p):
    xs : [parse_and(p)]
    x : xs[0]
    while at(p, "||"):
        take(p)
        xs.append(parse_and(p))
    if len(xs) = 1:
        return x
    z : node("BoolOp", x)
    z["op"] : "or"
    z["values"] : xs
    return z

def parse_and(p):
    xs : [parse_bitor(p)]
    x : xs[0]
    while at(p, "&&"):
        take(p)
        xs.append(parse_bitor(p))
    if len(xs) = 1:
        return x
    z : node("BoolOp", x)
    z["op"] : "and"
    z["values"] : xs
    return z

def parse_bitor(p):
    z : parse_bitxor(p)
    while at(p, "|"):
        take(p)
        z : lower_bit_binop(z, "|", parse_bitxor(p))
    return z

def parse_bitxor(p):
    z : parse_bitand(p)
    while at(p, "^"):
        take(p)
        z : lower_bit_binop(z, "^", parse_bitand(p))
    return z

def parse_bitand(p):
    z : parse_compare(p)
    while at(p, "&"):
        take(p)
        z : lower_bit_binop(z, "&", parse_compare(p))
    return z

def parse_compare(p):
    left : parse_shift(p)
    if peek(p)["text"] in ["==", "!=", "<", "<=", ">", ">="]:
        op : take(p)["text"]
        right : parse_shift(p)
        z : node("Compare", left)
        z["left"] : left
        z["op"] : op
        z["right"] : right
        return z
    return left

def parse_shift(p):
    z : parse_add(p)
    while at(p, "<<") or at(p, ">>"):
        op : take(p)["text"]
        z : lower_bit_binop(z, op, parse_add(p))
    return z

def parse_add(p):
    z : parse_mul(p)
    while peek(p)["text"] = "+" or peek(p)["text"] = "-":
        op : take(p)["text"]
        q : node("BinOp", z)
        q["left"] : z
        q["op"] : op
        q["right"] : parse_mul(p)
        z : q
    return z

def parse_mul(p):
    z : parse_unary(p)
    while peek(p)["text"] in ["*", "/", "%"]:
        op : take(p)["text"]
        q : node("BinOp", z)
        q["left"] : z
        q["op"] : op
        q["right"] : parse_unary(p)
        z : q
    return z

def parse_unary(p):
    tt : peek(p)["text"]
    if tt = "!":
        x : take(p)
        z : node("Unary", x)
        z["op"] : "not"
        z["value"] : parse_unary(p)
        return z
    if tt = "-":
        x : take(p)
        z : node("Unary", x)
        z["op"] : "-"
        z["value"] : parse_unary(p)
        return z
    if tt = "+":
        take(p)
        return parse_unary(p)
    if tt = "~":
        x : take(p)
        return make_bit_call(x, "bnot", [parse_unary(p)])
    if tt = "++" or tt = "--":
        fail(p, "prefix increment/decrement only supported as a statement", peek(p))
    if tt = "&":
        fail(p, "address-of is unsupported", peek(p))
    if tt = "*":
        fail(p, "pointer dereference is unsupported", peek(p))
    return parse_postfix(p)

def parse_postfix(p):
    z : parse_atom(p)
    while True:
        if at(p, "."):
            x : take(p)
            a : need_kind(p, "NAME")
            # Struct field → subscript with string key
            q : node("Subscript", x)
            q["value"] : z
            q["slice"] : const_str(x, a["text"])
            z : q
        elif at(p, "->"):
            fail(p, "pointer member access is unsupported", peek(p))
        elif at(p, "("):
            x : take(p)
            q : node("Call", x)
            q["func"] : z
            q["args"] : []
            q["kwargs"] : []
            if not at(p, ")"):
                while True:
                    q["args"].append(parse_expr(p))
                    if not at(p, ","):
                        break
                    take(p)
            need(p, ")")
            z : q
        elif at(p, "["):
            x : take(p)
            q : node("Subscript", x)
            q["value"] : z
            q["slice"] : parse_index(p)
            need(p, "]")
            z : q
        else:
            break
    return z

def parse_index(p):
    x : peek(p)
    lower : None
    if not at(p, "]"):
        lower : parse_expr(p)
    return lower

def parse_array_init(p, x):
    need(p, "{")
    z : node("List", x)
    z["elts"] : []
    if not at(p, "}"):
        while True:
            z["elts"].append(parse_expr(p))
            if not at(p, ","):
                break
            take(p)
            if at(p, "}"):
                break
    need(p, "}")
    return z

def looking_at_cast(p):
    # After '(', is this a type then ')'?
    save : p["pos"]
    if not skip_type(p):
        p["pos"] : save
        return False
    reject_pointer_type(p)
    ok : at(p, ")")
    p["pos"] : save
    return ok

def parse_atom(p):
    x : peek(p)
    if kind(p, "NUMBER"):
        take(p)
        z : node("Const", x)
        z["value"] : x["text"]
        z["kind"] : "number"
        return z
    if kind(p, "STRING"):
        take(p)
        z : node("Const", x)
        z["value"] : x["val"]["s"]
        z["kind"] : "string"
        return z
    if at(p, "true") or at(p, "false") or at(p, "NULL"):
        take(p)
        z : node("Const", x)
        z["value"] : "True" if x["text"] = "true" else ("False" if x["text"] = "false" else "None")
        z["kind"] : "number"
        return z
    if kind(p, "NAME"):
        take(p)
        if is_kw(x["text"]):
            fail(p, "unexpected keyword '" + x["text"] + "'", x)
        if x["text"] in c_forbidden_names:
            fail(p, x["text"] + " is unsupported", x)
        z : node("Name", x)
        z["value"] : ident(p, x)
        x["text"] : z["value"]
        return z
    if at(p, "("):
        take(p)
        if looking_at_cast(p):
            skip_type(p)
            reject_pointer_type(p)
            need(p, ")")
            return parse_unary(p)
        z : parse_expr(p)
        need(p, ")")
        return z
    if at(p, "{"):
        return parse_array_init(p, x)
    fail(p, "unsupported expression", x)

def pad(n):
    return "    " * n

def render(ast, state):
    state["comments"] : ast["comments"]
    state["inline"] : ast["inline"]
    state["last_comment"] : 0
    state["filename"] : ast["filename"]
    state["structs"] : ast["structs"] if "structs" in ast else {}
    lines : render_body(ast["body"], state, 0, True)
    for k in state["comments"].keys():
        kn : int(k)
        if kn > state["last_comment"]:
            lines.append(state["comments"][k])
    text : ""
    for line in lines:
        if line != "":
            text += line + "\n"
    return text

def before_comments(st, line, indent):
    out : []
    for k in st["comments"].keys():
        kn : int(k)
        if kn > st["last_comment"] and kn < line:
            out.append(pad(indent) + st["comments"][k])
            st["last_comment"] : kn
    return out

def render_body(body, st, indent, doc_ok):
    out : []
    i : 0
    while i < len(body):
        s : body[i]
        cs : before_comments(st, s["line"], indent)
        for c in cs:
            out.append(c)
        rs : render_stmt(s, st, indent)
        key : str(s["line"])
        if key in st["inline"] and len(rs) > 0:
            rs[0] : rs[0] + "  " + st["inline"][key]
        for q in rs:
            if q != "":
                out.append(q)
        i += 1
    return out

def render_stmt(s, st, ind):
    p : pad(ind)
    t : s["t"]
    if t = "Seq":
        out : []
        for c in s["body"]:
            for q in render_stmt(c, st, ind):
                out.append(q)
        return out
    if t = "Assign":
        return [p + target_text(s["target"], st) + " : " + expr_text(s["value"], st)]
    if t = "AugAssign":
        return [p + target_text(s["target"], st) + " " + s["op"] + " " + expr_text(s["value"], st)]
    if t = "Return":
        return [p + ("return" if s["value"] = None else "return " + expr_text(s["value"], st))]
    if t = "break" or t = "continue" or t = "pass":
        return [p + t]
    if t = "Label":
        return [p + "pass"]
    if t = "Goto":
        return [p + "__c_goto : " + quote_string(s["name"]), p + "continue"]
    if t = "Expr":
        return [p + expr_text(s["value"], st)]
    if t = "FunctionDef":
        out : []
        for d in s["decorators"]:
            out.append(p + "@" + expr_text(d, st))
        parts : []
        i : 0
        while i < len(s["args"]):
            q : s["args"][i]
            if s["defaults"][i] != None:
                q += ":" + expr_text(s["defaults"][i], st)
            parts.append(q)
            i += 1
        out.append(p + "def " + s["name"] + "(" + join_text(parts, ", ") + "):")
        for q in render_body(s["body"], st, ind + 1, True):
            out.append(q)
        return out
    if t = "If":
        out : [p + "if " + expr_text(s["test"], st) + ":"]
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        for e in s["elifs"]:
            out.append(p + "elif " + expr_text(e["test"], st) + ":")
            for q in render_body(e["body"], st, ind + 1, False):
                out.append(q)
        if len(s["orelse"]) > 0:
            out.append(p + "else:")
            for q in render_body(s["orelse"], st, ind + 1, False):
                out.append(q)
        return out
    if t = "While":
        out : [p + "while " + expr_text(s["test"], st) + ":"]
        for q in render_body(s["body"], st, ind + 1, False):
            out.append(q)
        return out
    return []

def join_text(xs, sep):
    out : ""
    i : 0
    while i < len(xs):
        if i > 0:
            out += sep
        out += xs[i]
        i += 1
    return out

def target_text(x, st):
    if x["t"] = "Tuple" or x["t"] = "List":
        parts : []
        for e in x["elts"]:
            parts.append(target_text(e, st))
        return join_text(parts, ", ")
    return expr_text(x, st)

def slice_text(x, st):
    if x["t"] = "Slice":
        a : "" if x["lower"] = None else expr_text(x["lower"], st)
        b : "" if x["upper"] = None else expr_text(x["upper"], st)
        q : a + ":" + b
        if x["step"] != None:
            q += ":" + expr_text(x["step"], st)
        return q
    return expr_text(x, st)

def expr_text(x, st):
    t : x["t"]
    if t = "Name":
        return x["value"]
    if t = "Const":
        if x["kind"] = "string":
            return quote_string(x["value"])
        return x["value"]
    if t = "List":
        parts : []
        for e in x["elts"]:
            parts.append(expr_text(e, st))
        return "[" + join_text(parts, ", ") + "]"
    if t = "Dict":
        parts : []
        i : 0
        while i < len(x["keys"]):
            parts.append(expr_text(x["keys"][i], st) + ": " + expr_text(x["values"][i], st))
            i += 1
        return "{" + join_text(parts, ", ") + "}"
    if t = "Attr":
        return expr_text(x["value"], st) + "[" + quote_string(x["attr"]) + "]"
    if t = "Subscript":
        return expr_text(x["value"], st) + "[" + slice_text(x["slice"], st) + "]"
    if t = "Unary":
        return "(" + ("not " if x["op"] = "not" else "-") + expr_text(x["value"], st) + ")"
    if t = "BinOp":
        if x["op"] = "+" and (is_stringy(x["left"]) or is_stringy(x["right"])):
            return "(" + string_operand(x["left"], st) + " + " + string_operand(x["right"], st) + ")"
        return "(" + expr_text(x["left"], st) + " " + x["op"] + " " + expr_text(x["right"], st) + ")"
    if t = "BoolOp":
        parts : []
        for e in x["values"]:
            parts.append(expr_text(e, st))
        return "(" + join_text(parts, " " + x["op"] + " ") + ")"
    if t = "Compare":
        op : "=" if x["op"] = "==" else x["op"]
        return "(" + expr_text(x["left"], st) + " " + op + " " + expr_text(x["right"], st) + ")"
    if t = "IfExp":
        return expr_text(x["body"], st) + " if " + expr_text(x["test"], st) + " else " + expr_text(x["orelse"], st)
    if t = "Call":
        lowered : lower_call(x, st)
        if lowered != None:
            return lowered
        parts : []
        for e in x["args"]:
            parts.append(expr_text(e, st))
        return expr_text(x["func"], st) + "(" + join_text(parts, ", ") + ")"
    return ""

def is_stringy(x):
    if x["t"] = "Const" and x["kind"] = "string":
        return True
    if x["t"] = "BinOp" and x["op"] = "+" and (is_stringy(x["left"]) or is_stringy(x["right"])):
        return True
    return False

def string_operand(x, st):
    if is_stringy(x) and not (x["t"] = "BinOp" and x["op"] = "+"):
        return expr_text(x, st)
    if x["t"] = "BinOp" and x["op"] = "+" and (is_stringy(x["left"]) or is_stringy(x["right"])):
        return expr_text(x, st)
    return "str(" + expr_text(x, st) + ")"

def lower_call(x, st):
    f : x["func"]
    if f["t"] = "Name":
        name : f["value"]
        if name = "printf" or name = "puts":
            parts : []
            for e in x["args"]:
                parts.append(expr_text(e, st))
            return "print(" + join_text(parts, ", ") + ")"
    return None

def transpile(source, filename):
    ast : parse(source, filename)
    return render(ast, {"aliases":ast["aliases"]})

def main():
    return transpile_cli.run(argv, "c2s.ie", "c", transpile)

# Run CLI only when this file is the entry script.
if re_match("c2s\\.ie$", argv[0]):
    main()
