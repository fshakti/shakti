{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debian-release",
      "displayName": "Debian/Ubuntu GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debian-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Apple Clang + Homebrew libomp",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIBOMP_ROOT": "/opt/homebrew/opt/libomp"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MSYS2 MinGW64 (UCRT64) Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw64.cmake"
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly / Emscripten (standalone only; requires EMSDK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-emscripten.cmake"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64 NDK (standalone only; pass -DANDROID_NDK=... or set env)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-android.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debian-release",
      "configurePreset": "debian-release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release"
    }
  ]
}
